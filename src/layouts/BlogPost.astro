---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ReadingProgress from '../components/blog/ReadingProgress.astro';
import HeadingAnchors from '../components/blog/HeadingAnchors.astro';
import CopyPageButton from '../components/blog/CopyPageButton.astro';
import FreshnessLine from '../components/blog/FreshnessLine.astro';
import Comments from '../components/blog/Comments.astro';
import PostPreview from '../components/PostPreview.astro';
import { cleanMdxBody, countWords, extractTldr } from '../lib/mdx-plaintext';
import { PERSON, PERSON_ID, ORGANIZATION, ORGANIZATION_ID, SITE_TITLE, SITE_DESCRIPTION, SITE_DESCRIPTION_ES, UI_STRINGS } from '../consts';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, reviewedDate, status, heroImage, heroImageAlt, tags, tldr, lang = 'en' } = Astro.props;

// Effective last-modified for SEO: reviewedDate beats updatedDate beats publish.
const effectiveDateModified = reviewedDate ?? updatedDate;
const isArchivedStatus = !!status && /outdated|deprecated|archived/i.test(status);

// Build hreflang alternates for this post
const allPosts = await getCollection('blog');
const currentPath = Astro.url.pathname;
const slug = currentPath.replace(/^\/blog\//, '').replace(/\/$/, '');

// Lookup current post entry to count words for JSON-LD
const currentPost = allPosts.find((p) => p.id === slug);
const wordCount = currentPost?.body ? countWords(cleanMdxBody(currentPost.body)) : undefined;

// JSON-LD abstract: frontmatter tldr wins, else the post's <TLDR> bullets.
const tldrBullets = tldr && tldr.length > 0 ? tldr : extractTldr(currentPost?.body ?? '');
const abstract = tldrBullets?.join('; ');

// OG image: use heroImage if provided, otherwise use generated OG image
const ogImage = heroImage || `/og/${slug}.png`;

// Markdown alternate for AI discovery
const markdownAlternate = `https://valdemird.com/blog/${slug}.md`;

// Capitalize first tag as articleSection (Entity SEO)
const articleSection = tags?.[0]
	? tags[0].split('-').map((s: string) => s.charAt(0).toUpperCase() + s.slice(1)).join(' ')
	: undefined;

// Linked structured-data graph for this post. One @graph so WebSite, Person,
// Organization, the article, its WebPage, the image, and the breadcrumb all
// cross-reference by @id instead of shipping as disconnected islands. BaseHead
// emits a page-supplied jsonLd verbatim, so the full graph is built here.
const blogIndexPath = lang === 'es' ? '/es/blog/' : '/blog/';
const homePath = lang === 'es' ? '/es/' : '/';

const postUrl = `https://valdemird.com${currentPath}`;
const articleId = `${postUrl}#article`;
const webPageId = `${postUrl}#webpage`;
const imageId = `${postUrl}#primaryimage`;
const breadcrumbId = `${postUrl}#breadcrumb`;

// Image is always present: heroImage when set, otherwise the build-time OG image
// (/og/<slug>.png). Dimensions are only asserted for the known 1200x630 OG file.
const imageNode = {
	'@type': 'ImageObject',
	'@id': imageId,
	url: `https://valdemird.com${ogImage}`,
	...(heroImage ? {} : { width: 1200, height: 630 }),
};

const webSiteNode = {
	'@type': 'WebSite',
	'@id': 'https://valdemird.com/#website',
	name: SITE_TITLE,
	url: 'https://valdemird.com',
	description: lang === 'es' ? SITE_DESCRIPTION_ES : SITE_DESCRIPTION,
	inLanguage: lang === 'es' ? ['es', 'en'] : ['en', 'es'],
	publisher: { '@id': ORGANIZATION_ID },
};

const webPageNode = {
	'@type': 'WebPage',
	'@id': webPageId,
	url: postUrl,
	name: title,
	isPartOf: { '@id': 'https://valdemird.com/#website' },
	primaryImageOfPage: { '@id': imageId },
	breadcrumb: { '@id': breadcrumbId },
	inLanguage: lang,
};

const articleNode: Record<string, unknown> = {
	'@type': 'BlogPosting',
	'@id': articleId,
	headline: title,
	description,
	...(abstract && { abstract }),
	datePublished: pubDate.toISOString(),
	...(effectiveDateModified && { dateModified: effectiveDateModified.toISOString() }),
	...(isArchivedStatus && { creativeWorkStatus: 'Archived' }),
	author: { '@id': PERSON_ID },
	publisher: { '@id': ORGANIZATION_ID },
	image: { '@id': imageId },
	mainEntityOfPage: { '@id': webPageId },
	isPartOf: { '@id': webPageId },
	inLanguage: lang,
	...(tags && tags.length > 0 && { keywords: tags.join(', ') }),
	...(articleSection && { articleSection }),
	...(wordCount && wordCount > 0 && { wordCount }),
};

const breadcrumbNode = {
	'@type': 'BreadcrumbList',
	'@id': breadcrumbId,
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: lang === 'es' ? 'Inicio' : 'Home', item: `https://valdemird.com${homePath}` },
		{ '@type': 'ListItem', position: 2, name: 'Blog', item: `https://valdemird.com${blogIndexPath}` },
		{ '@type': 'ListItem', position: 3, name: title, item: postUrl },
	],
};

const blogPostingJsonLd = {
	'@context': 'https://schema.org',
	'@graph': [webSiteNode, PERSON, ORGANIZATION, imageNode, webPageNode, articleNode, breadcrumbNode],
};

const alternates: { hreflang: string; href: string }[] = [];
if (lang === 'en') {
	// Look for ES counterpart: es/<slug>
	const esPair = allPosts.find(p => p.id === `es/${slug}` && p.data.lang === 'es');
	if (esPair) {
		alternates.push(
			{ hreflang: 'en', href: `https://valdemird.com/blog/${slug}/` },
			{ hreflang: 'es', href: `https://valdemird.com/blog/es/${slug}/` },
		);
	}
} else if (lang === 'es') {
	// Look for EN counterpart: <slug without es/>
	const enSlug = slug.replace(/^es\//, '');
	const enPair = allPosts.find(p => p.id === enSlug && p.data.lang === 'en');
	if (enPair) {
		alternates.push(
			{ hreflang: 'en', href: `https://valdemird.com/blog/${enSlug}/` },
			{ hreflang: 'es', href: `https://valdemird.com/blog/es/${enSlug}/` },
		);
	}
}

// "Read next": up to 3 same-language posts (never cross-language), excluding the
// current one, ranked by shared-tag overlap and falling back to recency. This is
// the internal-linking lever — every post becomes a hub that passes equity to
// related posts instead of dead-ending after the body.
const currentTags = new Set(tags ?? []);
const relatedPosts = allPosts
	.filter((p) => p.id !== slug && (p.data.lang ?? 'en') === lang)
	.map((p) => ({
		post: p,
		overlap: (p.data.tags ?? []).filter((t: string) => currentTags.has(t)).length,
	}))
	.sort((a, b) => b.overlap - a.overlap || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
	.slice(0, 3)
	.map((s) => s.post);
---

<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} image={ogImage} lang={lang} type="article" alternates={alternates} jsonLd={blogPostingJsonLd} publishedTime={pubDate} modifiedTime={effectiveDateModified} tags={tags} markdownAlternate={markdownAlternate} />
	</head>

	<body>
		<a class="skip-link" href="#main-content">{UI_STRINGS[lang].nav.skipToContent}</a>
		<ReadingProgress />
		<HeadingAnchors lang={lang} />
		<Header />
		<main id="main-content">
			<script>
				import {
					initPageEntrance,
					initScrollReveals,
					cleanupAll,
					isReducedMotion,
					gsap,
					ScrollTrigger,
					DURATION,
					EASE,
				} from '../lib/animations';

				const isVTNav = () => document.documentElement.hasAttribute('data-vt-nav');

				function initBlogPost() {
					if (isReducedMotion()) return;

					// Skip entrance animations during VT navigation — the morph handles it
					if (!isVTNav()) {
						initPageEntrance('.article-header .meta, .article-header .lead, .article-header .article-tags');
					}

					// Gentle heading reveals on scroll. Skip the hide/reveal entirely
					// when the URL carries a hash (a deep link must show its target and
					// everything above it immediately) or when a language switch is about
					// to restore the reading position mid-article — otherwise the headings
					// above the landing point would stay opacity:0.
					const headings = document.querySelectorAll('.article-body h2, .article-body h3');
					let pendingLangRestore = false;
					try {
						pendingLangRestore = sessionStorage.getItem('langScrollHeading') !== null;
					} catch (e) {}
					if (headings.length && !location.hash && !pendingLangRestore) {
						gsap.set(headings, { opacity: 0, y: 12 });
						ScrollTrigger.batch(headings, {
							onEnter: (batch: Element[]) => {
								gsap.to(batch, {
									opacity: 1,
									y: 0,
									duration: DURATION.normal,
									ease: EASE.enter,
									stagger: 0.05,
									overwrite: true,
								});
							},
							start: 'top 90%',
							once: true,
						});
					}
				}
				function initAndCleanup() {
					initBlogPost();
					document.addEventListener('astro:before-swap', cleanupAll, { once: true });
				}
				initAndCleanup();
				document.addEventListener('astro:after-swap', initAndCleanup);
			</script>
			<article>
				{heroImage && (
					<div class="hero-image">
						<img width={1020} height={510} src={heroImage} alt={heroImageAlt ?? title} />
					</div>
				)}
				<div class="prose">
					<div class="article-utility">
						<CopyPageButton markdownUrl={`/blog/${slug}.md`} lang={lang} />
					</div>
					<header class="article-header">
						<FreshnessLine pubDate={pubDate} reviewedDate={reviewedDate ?? updatedDate} status={status} lang={lang} />
						<h1 transition:name={`post-title-${slug.replace(/\//g, '-')}`}>{title}</h1>
						{description && <p class="lead">{description}</p>}
						{tags && tags.length > 0 && (
							<div class="article-tags">
								{tags.map((tag: string) => <span class="tag">{tag}</span>)}
							</div>
						)}
						<hr />
					</header>
					<div class="article-body">
						<slot />
					</div>
					{relatedPosts.length > 0 && (
						<aside class="read-next" aria-label={lang === 'es' ? 'Sigue leyendo' : 'Read next'}>
							<p class="read-next-eyebrow">{lang === 'es' ? 'Sigue leyendo' : 'Read next'}</p>
							<div class="read-next-list">
								{relatedPosts.map((post) => (
									<PostPreview
										id={post.id}
										title={post.data.title}
										description={post.data.description}
										pubDate={post.data.pubDate}
										tags={post.data.tags}
										locale={lang}
									/>
								))}
							</div>
						</aside>
					)}
					<Comments lang={lang} pathname={currentPath} />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 100%;
		margin: 0;
		padding: 0;
	}

	article {
		padding-bottom: var(--space-2xl);
	}

	.hero-image {
		max-width: var(--wide-width);
		margin: var(--space-lg) auto;
		padding: 0 var(--space-lg);
	}

	.hero-image img {
		width: 100%;
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-lg);
	}

	.prose {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: var(--space-lg);
	}

	.article-utility {
		display: flex;
		justify-content: flex-end;
		margin-bottom: var(--space-md);
	}

	@media (max-width: 540px) {
		.article-utility {
			justify-content: center;
		}
	}

	/* --- Read next (related posts) --- */
	.read-next {
		margin-top: var(--space-2xl);
		padding-top: var(--space-lg);
		border-top: 1px solid var(--color-border);
	}

	.read-next-eyebrow {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--color-accent);
		margin: 0 0 var(--space-sm);
	}

	.read-next-list {
		display: flex;
		flex-direction: column;
	}

	/* --- Article Header --- */
	.article-header {
		margin-bottom: var(--space-xl);
		text-align: center;
	}

	.article-header h1 {
		margin: 0.4em 0 0.3em;
		font-size: clamp(2rem, 5vw, 2.8rem);
		line-height: 1.15;
		letter-spacing: -0.02em;
	}

	.lead {
		font-size: 1.2rem;
		color: var(--color-text-secondary);
		line-height: 1.6;
		max-width: 540px;
		margin: 0 auto 1em;
	}

	.article-tags {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.75em;
	}

	.tag {
		font-size: 0.75rem;
		font-weight: 500;
		padding: 0.2em 0.65em;
		background: var(--color-accent-subtle);
		border-radius: var(--radius-sm);
		color: var(--color-accent);
	}

	.article-header hr {
		margin-top: var(--space-xl);
	}

	/* --- Article Body: editorial typography --- */
	.article-body {
		font-size: 1.1rem;
		line-height: 1.85;
		color: var(--color-text-secondary);
	}

	.article-body :global(h2) {
		font-family: var(--font-serif);
		font-size: 1.6rem;
		margin-top: 2.5em;
		margin-bottom: 0.6em;
		color: var(--color-text);
		letter-spacing: -0.01em;
		scroll-margin-top: 5.5rem;
	}

	.article-body :global(h3) {
		font-family: var(--font-serif);
		font-size: 1.3rem;
		margin-top: 2em;
		margin-bottom: 0.5em;
		color: var(--color-text);
		scroll-margin-top: 5.5rem;
	}

	.article-body :global(h4) {
		font-family: var(--font-sans);
		font-size: 1.1rem;
		font-weight: 600;
		margin-top: 1.5em;
		margin-bottom: 0.4em;
		color: var(--color-text);
		scroll-margin-top: 5.5rem;
	}

	/* When the page lands on a hash, force the targeted heading visible even if
	   the GSAP scroll-reveal hasn't fired yet (it sets inline opacity:0). */
	.article-body :global(h2:target),
	.article-body :global(h3:target),
	.article-body :global(h4:target) {
		opacity: 1 !important;
		transform: none !important;
	}

	.article-body :global(p) {
		margin-bottom: 1.6em;
	}

	.article-body :global(ul),
	.article-body :global(ol) {
		padding-left: 1.25em;
		margin-bottom: 1.6em;
	}

	.article-body :global(li) {
		margin-bottom: 0.4em;
	}

	.article-body :global(blockquote:not(.pullquote-body)) {
		padding: 0.25em 0 0.25em 1.75em;
		margin: 2em 0;
		font-style: italic;
		color: var(--color-text-secondary);
	}

	.article-body :global(blockquote:not(.pullquote-body) p) {
		margin-bottom: 0.5em;
	}

	.article-body :global(img) {
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-md);
		margin: 1.5em 0;
	}

	.article-body :global(hr) {
		margin: 2.5em 0;
	}

	.article-body :global(a) {
		text-decoration-color: var(--color-accent);
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}

	.article-body :global(strong) {
		color: var(--color-text);
	}

	/* Code in prose */
	.article-body :global(code) {
		font-size: 0.88em;
	}

	.article-body :global(pre) {
		font-size: 0.88rem;
		margin: 1.75em 0;
	}

	@media (max-width: 768px) {
		.article-body {
			font-size: 1rem;
		}

		.article-header h1 {
			font-size: 1.8rem;
		}
	}
</style>
