---
/**
 * MapCard: the knowledge-map entry on the blog index, beside DeepDiveCard and
 * LabCard and in the same style. Every count comes from the build-time graph.
 */
import { buildContentMap } from '../lib/content-map';
import { MAP_UI, mapHref } from './map/strings';
import FeatureCard from './FeatureCard.astro';

interface Props {
	lang: 'en' | 'es';
}

const { lang } = Astro.props;
const ui = MAP_UI[lang];
const { stats } = await buildContentMap(lang);

const metrics: { value: string; label: string }[] = [
	{ value: String(stats.posts), label: ui.legend.posts },
	{ value: String(stats.modules), label: ui.legend.modules },
	{ value: String(stats.lab), label: ui.legend.lab },
	{ value: String(stats.terms), label: ui.legend.terms },
	{ value: String(stats.edges), label: ui.legend.edges },
];
---

<FeatureCard
	href={mapHref(lang)}
	eyebrow={ui.card.eyebrow}
	title={ui.card.title}
	description={ui.card.desc}
	stats={metrics}
	statsLabel={ui.card.metricsLabel}
	cta={ui.card.cta}
	artSide="right"
>
	<div slot="art" class="terrain">
		<img src="/map/poster-wide.svg" alt="" width="2900" height="1360" loading="lazy" decoding="async" />
	</div>
</FeatureCard>

<style>
	/* The real terrain of the map, as the card's picture. */
	.terrain {
		border-radius: var(--radius-md);
		border: 1px solid var(--color-border);
		overflow: hidden;
		background: var(--color-surface);
	}
	.terrain img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
</style>
