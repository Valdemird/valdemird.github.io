---
import { SITE_TITLE, getLocale, t } from '../consts';

const locale = getLocale(Astro.url);
const strings = t(Astro.url);
const altLocale = locale === 'en' ? 'es' : 'en';

// Blog posts use /blog/es/<slug>/ pattern (es/ is part of content id, not a URL prefix)
function getAltPath(pathname: string, currentLocale: string): string {
	const isBlogPost = /^\/blog\/(?!index)/.test(pathname) && !pathname.endsWith('/blog/');
	if (isBlogPost) {
		if (currentLocale === 'en') {
			// /blog/my-post/ → /blog/es/my-post/
			return pathname.replace(/^\/blog\//, '/blog/es/');
		} else {
			// /blog/es/my-post/ → /blog/my-post/
			return pathname.replace(/^\/blog\/es\//, '/blog/');
		}
	}
	// Other pages use /es/ prefix
	if (currentLocale === 'en') {
		return `/es${pathname}`;
	}
	return pathname.replace(/^\/es\/?/, '/');
}

const pathname = Astro.url.pathname;

// The 404 page has no Spanish twin (GitHub Pages serves one 404.html for every
// missing path), so its language switch goes to the other locale's home.
const is404 = /^\/(es\/)?404(\.html|\/)?$/.test(pathname);
const altPath = is404 ? (altLocale === 'es' ? '/es/' : '/') : getAltPath(pathname, locale);

const prefix = locale === 'es' ? '/es' : '';
const isHome = pathname === '/' || pathname === '/es/' || pathname === '/es';
const navItems = [
	{ href: `${prefix}/`, label: strings.nav.home, active: isHome },
	{ href: `${prefix}/blog/`, label: strings.nav.blog, active: pathname.includes('/blog') },
	{ href: `${prefix}/learn/`, label: strings.nav.learn, active: pathname.includes('/learn') },
	{ href: `${prefix}/lab/`, label: strings.nav.lab, active: /^\/(es\/)?lab(\/|$)/.test(pathname) },
	{ href: `${prefix}/about/`, label: strings.nav.about, active: pathname.includes('/about') },
];
// aria-current: "page" on the exact page, "true" inside its section
// (e.g. a post under Blog). Normalise a missing trailing slash first.
const here = pathname.endsWith('/') ? pathname : `${pathname}/`;
const ariaCurrent = (item: { href: string; active: boolean }) =>
	item.active ? (here === item.href ? 'page' : 'true') : undefined;
---

<header id="site-header" transition:name="site-header" transition:animate="none">
	<nav>
		<a href={`${prefix}/`} class="logo">
			<span class="logo-text">{SITE_TITLE}</span>
			<span class="logo-dot"></span>
		</a>

		<div class="nav-links">
			{navItems.map((item) => (
				<a href={item.href} class:list={[{ active: item.active }]} aria-current={ariaCurrent(item)}>
					{item.label}
				</a>
			))}
		</div>

		<div class="nav-actions">
			<a href={altPath} class="lang-switch" aria-label={`${strings.nav.switchLang} ${altLocale === 'en' ? 'English' : 'Español'}`}>
				{altLocale === 'en' ? 'EN' : 'ES'}
			</a>

			<button id="menu-toggle" class="menu-toggle" aria-label={strings.nav.toggleMenu} aria-expanded="false" aria-controls="mobile-nav" type="button">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<line class="line-1" x1="3" y1="6" x2="21" y2="6"></line>
					<line class="line-2" x1="3" y1="12" x2="21" y2="12"></line>
					<line class="line-3" x1="3" y1="18" x2="21" y2="18"></line>
				</svg>
			</button>
		</div>
	</nav>

	<div id="mobile-nav" class="mobile-nav">
		{navItems.map((item) => (
			<a href={item.href} class:list={[{ active: item.active }]} aria-current={ariaCurrent(item)}>{item.label}</a>
		))}
	</div>
</header>

<script>
	// One controller per page: every listener below is torn down on
	// astro:before-swap and rebuilt on astro:page-load, so nothing piles up
	// across View Transitions.
	let headerController: AbortController | null = null;

	function cleanupHeader() {
		headerController?.abort();
		headerController = null;
		// Make sure the menu doesn't linger open across a View Transition.
		document.getElementById('mobile-nav')?.classList.remove('open');
		const toggle = document.getElementById('menu-toggle');
		toggle?.classList.remove('open');
		toggle?.setAttribute('aria-expanded', 'false');
	}

	function initHeader() {
		// On the first visit astro:page-load only fires at window `load`, after the
		// direct call below already wired this header. Re-running then would close
		// a menu the reader just opened, so skip a header that is already wired.
		// The flag lives on the element, so the swapped-in header starts clean.
		const header = document.getElementById('site-header');
		if (!header || header.dataset.headerReady) return;
		header.dataset.headerReady = '1';
		cleanupHeader();
		const controller = new AbortController();
		headerController = controller;
		const { signal } = controller;

		const menuToggle = document.getElementById('menu-toggle');
		const mobileNav = document.getElementById('mobile-nav');

		const setOpen = (open: boolean) => {
			mobileNav?.classList.toggle('open', open);
			menuToggle?.classList.toggle('open', open);
			menuToggle?.setAttribute('aria-expanded', String(open));
		};
		const isOpen = () => mobileNav?.classList.contains('open') ?? false;

		menuToggle?.addEventListener('click', () => setOpen(!isOpen()), { signal });

		// Escape closes the disclosure and returns focus to the toggle.
		document.addEventListener(
			'keydown',
			(e: KeyboardEvent) => {
				if (e.key === 'Escape' && isOpen()) {
					setOpen(false);
					menuToggle?.focus();
				}
			},
			{ signal },
		);

		let ticking = false;
		let isScrolled = window.scrollY > 10;
		header.classList.toggle('scrolled', isScrolled);

		window.addEventListener(
			'scroll',
			() => {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(() => {
					const shouldBeScrolled = window.scrollY > 10;
					if (shouldBeScrolled !== isScrolled) {
						isScrolled = shouldBeScrolled;
						header?.classList.toggle('scrolled', isScrolled);
					}
					ticking = false;
				});
			},
			{ passive: true, signal },
		);
	}

	// astro:page-load fires on the first load and after every navigation;
	// the direct call covers a page rendered without the client router.
	initHeader();
	document.addEventListener('astro:page-load', initHeader);
	document.addEventListener('astro:before-swap', cleanupHeader);
</script>

<style>
	/* ========================================
	   GLASS NAVBAR - always translucent
	   ======================================== */
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: oklch(from var(--color-bg) l c h / 0.65);
		backdrop-filter: blur(16px) saturate(1.4);
		-webkit-backdrop-filter: blur(16px) saturate(1.4);
		border-bottom: 1px solid oklch(from var(--color-border) l c h / 0.4);
		transition: background var(--duration-normal) var(--ease-smooth),
			border-color var(--duration-normal) var(--ease-smooth),
			box-shadow var(--duration-normal) var(--ease-smooth);
	}

	header.scrolled {
		background: oklch(from var(--color-bg) l c h / 0.72);
		border-bottom-color: var(--color-border);
		box-shadow: 0 1px 12px oklch(0 0 0 / 0.04);
	}

	nav {
		max-width: var(--full-width);
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.65rem 1.5rem;
		gap: 1rem;
	}

	/* Logo with accent dot */
	.logo {
		display: flex;
		align-items: center;
		gap: 0;
		font-family: var(--font-mono);
		font-size: 1rem;
		font-weight: 600;
		color: var(--color-text);
		text-decoration: none;
		letter-spacing: -0.01em;
		transition: opacity var(--duration-fast) var(--ease-smooth);
	}

	.logo:hover {
		opacity: 0.7;
		color: var(--color-text);
	}

	.logo-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--color-accent);
		margin-left: 2px;
		margin-bottom: -2px;
		transition: transform var(--duration-normal) var(--ease-spring);
	}

	.logo:hover .logo-dot {
		transform: scale(1.5);
	}

	/* Nav links with animated underline */
	.nav-links {
		display: flex;
		gap: 0.15rem;
	}

	.nav-links a {
		position: relative;
		padding: 0.4rem 0.75rem;
		color: var(--color-text-muted);
		text-decoration: none;
		font-size: 0.85rem;
		font-weight: 450;
		border-radius: var(--radius-sm);
		transition: color var(--duration-fast) var(--ease-smooth);
	}

	.nav-links a::after {
		content: '';
		position: absolute;
		bottom: 2px;
		left: 50%;
		width: 0;
		height: 2px;
		background: var(--color-accent);
		border-radius: 1px;
		transition: width var(--duration-normal) var(--ease-spring),
			left var(--duration-normal) var(--ease-spring);
	}

	.nav-links a:hover {
		color: var(--color-text);
	}

	.nav-links a:hover::after {
		width: 60%;
		left: 20%;
	}

	.nav-links a.active {
		color: var(--color-text);
		font-weight: 550;
	}

	.nav-links a.active::after {
		width: 60%;
		left: 20%;
	}

	/* Actions */
	.nav-actions {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}

	.lang-switch {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		color: var(--color-text-muted);
		text-decoration: none;
		padding: 0.25rem 0.45rem;
		border: 1px solid oklch(from var(--color-border) l c h / 0.6);
		border-radius: var(--radius-sm);
		transition: all var(--duration-fast) var(--ease-smooth);
	}

	.lang-switch:hover {
		color: var(--color-text);
		border-color: var(--color-border-strong);
		background: oklch(from var(--color-surface) l c h / 0.5);
		animation: boop 0.2s var(--ease-spring);
	}

	/* Mobile */
	.menu-toggle {
		display: none;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border: none;
		background: transparent;
		color: var(--color-text-muted);
		cursor: pointer;
		border-radius: var(--radius-sm);
	}

	.mobile-nav {
		display: none;
		flex-direction: column;
		padding: 0 1.5rem 0.75rem;
		gap: 0.15rem;
		background: oklch(from var(--color-bg) l c h / 0.65);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
	}

	.mobile-nav a {
		display: flex;
		align-items: center;
		min-height: 44px;
		padding: 0.55rem 0.75rem;
		color: var(--color-text-secondary);
		text-decoration: none;
		font-size: 0.9rem;
		border-radius: var(--radius-sm);
		transition: background var(--duration-fast) var(--ease-smooth),
			color var(--duration-fast) var(--ease-smooth);
	}

	.mobile-nav a:hover {
		background: oklch(from var(--color-accent-subtle) l c h / 0.5);
		color: var(--color-text);
	}

	/* Active section in the mobile menu: tinted wash, stronger text, and a
	   small accent dot after the label (no edge bar). */
	.mobile-nav a.active {
		background: oklch(from var(--color-accent) l c h / 0.08);
		color: var(--color-text);
		font-weight: 550;
	}
	.mobile-nav a.active::after {
		content: '';
		width: 5px;
		height: 5px;
		margin-left: 0.6em;
		border-radius: 50%;
		background: var(--color-accent);
	}

	@media (max-width: 640px) {
		.nav-links { display: none; }
		.menu-toggle { display: flex; width: 44px; height: 44px; }
		/* ≥44px hit area; padding shrinks so the pill doesn't balloon visually */
		.lang-switch {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			min-width: 44px;
			min-height: 44px;
			padding: 0.2rem 0.3rem;
		}
		.mobile-nav.open { display: flex; }
		/* Each line rotates around its own centre, then lines 1 and 3 slide
		   6 units onto the middle line, so the X is symmetric. */
		.menu-toggle line {
			transform-box: fill-box;
			transform-origin: center;
			transition: transform var(--duration-normal) var(--ease-smooth), opacity var(--duration-normal) var(--ease-smooth);
		}
		.menu-toggle.open .line-1 { transform: translateY(6px) rotate(45deg); }
		.menu-toggle.open .line-2 { opacity: 0; }
		.menu-toggle.open .line-3 { transform: translateY(-6px) rotate(-45deg); }
	}
</style>
