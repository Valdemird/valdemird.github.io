---
interface Props {
	labels: string[];
}

const { labels } = Astro.props;

// Deterministic id: a hash of the labels, plus an occurrence suffix when the
// same label set shows up twice on one page. Same input, same HTML, every build.
function hash(input: string): string {
	let h = 5381;
	for (let i = 0; i < input.length; i++) h = ((h << 5) + h + input.charCodeAt(i)) >>> 0;
	return h.toString(36);
}
const base = `tabs-${hash(labels.join('\u0000'))}`;
const locals = (Astro.locals ?? {}) as unknown as { __tabsSeen?: Map<string, number> };
const seen = (locals.__tabsSeen ??= new Map<string, number>());
const occurrence = (seen.get(base) ?? 0) + 1;
seen.set(base, occurrence);
const tabId = occurrence === 1 ? base : `${base}-${occurrence}`;
---

<div class="tabs-container" id={tabId} data-tabs>
	<div class="tabs-header" role="tablist">
		{labels.map((label, i) => (
			<button
				role="tab"
				class:list={['tab-btn', { active: i === 0 }]}
				id={`${tabId}-tab-${i}`}
				aria-controls={`${tabId}-panel-${i}`}
				aria-selected={i === 0 ? 'true' : 'false'}
				tabindex={i === 0 ? 0 : -1}
				data-tab-index={i}
				type="button"
			>
				{label}
			</button>
		))}
		<div class="tab-indicator" aria-hidden="true"></div>
	</div>
	<div class="tabs-panels">
		<slot />
	</div>
</div>

<script>
	// WAI-ARIA APG tabs: roving tabindex, Arrow Left/Right (wrapping), Home/End,
	// automatic activation. Listeners live on elements inside the container, so
	// a View Transition swap drops them with the old DOM; the resize observers
	// are disconnected explicitly before the swap.
	let observers: ResizeObserver[] = [];

	function setup(container: HTMLElement) {
		if (container.dataset.tabsReady) return;
		container.dataset.tabsReady = '1';

		// Only this set's own tabs and panels, never those of a nested <Tabs>.
		const own = (el: Element) => el.closest('[data-tabs]') === container;
		const buttons = Array.from(container.querySelectorAll<HTMLButtonElement>('.tab-btn')).filter(own);
		const panels = Array.from(container.querySelectorAll<HTMLElement>('.tab-panel')).filter(own);
		const header = container.querySelector<HTMLElement>(':scope > .tabs-header');
		const indicator = header?.querySelector<HTMLElement>(':scope > .tab-indicator') ?? null;
		let current = 0;

		buttons.forEach((btn, i) => {
			const panel = panels[i];
			if (!panel) return;
			panel.id = btn.getAttribute('aria-controls') ?? `${container.id}-panel-${i}`;
			panel.setAttribute('aria-labelledby', btn.id);
		});

		function placeIndicator() {
			const btn = buttons[current];
			if (!indicator || !btn) return;
			indicator.style.width = `${btn.offsetWidth}px`;
			indicator.style.transform = `translateX(${btn.offsetLeft}px)`;
		}

		function activate(index: number, focus = false) {
			current = index;
			buttons.forEach((btn, i) => {
				const on = i === index;
				btn.classList.toggle('active', on);
				btn.setAttribute('aria-selected', on ? 'true' : 'false');
				btn.tabIndex = on ? 0 : -1;
			});
			panels.forEach((panel, i) => {
				const on = i === index;
				panel.classList.toggle('active', on);
				panel.hidden = !on;
			});
			if (focus) buttons[index]?.focus();
			placeIndicator();
		}

		buttons.forEach((btn, i) => {
			btn.addEventListener('click', () => activate(i));
			btn.addEventListener('keydown', (e) => {
				const last = buttons.length - 1;
				let next: number | null = null;
				if (e.key === 'ArrowRight') next = current === last ? 0 : current + 1;
				else if (e.key === 'ArrowLeft') next = current === 0 ? last : current - 1;
				else if (e.key === 'Home') next = 0;
				else if (e.key === 'End') next = last;
				if (next === null) return;
				e.preventDefault();
				activate(next, true);
			});
		});

		if (buttons.length > 0) activate(0);

		// Re-measure when fonts load or the tabs change width (e.g. inside a
		// Collapsible that was closed at init time).
		if (header && 'ResizeObserver' in window) {
			const ro = new ResizeObserver(placeIndicator);
			ro.observe(header);
			observers.push(ro);
		}
	}

	function init() {
		document.querySelectorAll<HTMLElement>('[data-tabs]').forEach(setup);
	}

	function teardown() {
		observers.forEach((ro) => ro.disconnect());
		observers = [];
	}

	document.addEventListener('astro:page-load', init);
	document.addEventListener('astro:before-swap', teardown);
</script>

<style>
	.tabs-container {
		margin: 2em 0;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		overflow: hidden;
		background: var(--color-surface);
	}

	.tabs-header {
		position: relative;
		display: flex;
		border-bottom: 1px solid var(--color-border);
		background: var(--color-bg-secondary);
		overflow-x: auto;
	}

	.tab-btn {
		position: relative;
		z-index: 1;
		padding: 0.65rem 1.25rem;
		border: none;
		background: transparent;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 500;
		color: var(--color-text-muted);
		cursor: pointer;
		white-space: nowrap;
		transition: color var(--duration-fast) var(--ease-smooth);
	}

	.tab-btn:hover { color: var(--color-text); }
	.tab-btn.active { color: var(--color-text); }

	.tab-btn:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: -2px;
		color: var(--color-text);
	}

	.tab-indicator {
		position: absolute;
		bottom: 0;
		left: 0;
		height: 2px;
		background: var(--color-accent);
		border-radius: 1px;
		transition: transform var(--duration-normal) var(--ease-spring),
			width var(--duration-normal) var(--ease-spring);
	}

	.tabs-panels {
		position: relative;
	}

	.tabs-panels :global(.tab-panel) {
		display: none;
		padding: 1.25rem;
	}

	/* Before the script runs (or without JS), show the first panel. */
	.tabs-panels :global(.tab-panel.active),
	.tabs-container:not([data-tabs-ready]) .tabs-panels :global(.tab-panel:first-child) {
		display: block;
	}

	.tabs-panels :global(.tab-panel.active) {
		animation: tabFadeIn 0.25s var(--ease-smooth);
	}

	.tabs-panels :global(.tab-panel[hidden]) {
		display: none;
	}

	.tabs-panels :global(.tab-panel:focus-visible) {
		outline: 2px solid var(--color-accent);
		outline-offset: -2px;
	}

	@media (prefers-reduced-motion: reduce) {
		.tabs-panels :global(.tab-panel.active) { animation: none; }
		.tab-indicator { transition: none; }
	}

	@keyframes tabFadeIn {
		from { opacity: 0; transform: translateY(4px); }
		to { opacity: 1; transform: translateY(0); }
	}

	/* Reset prose styles inside tabs */
	.tabs-panels :global(.tab-panel p:last-child) { margin-bottom: 0; }
	.tabs-panels :global(.tab-panel pre) { margin: 0; }
</style>
