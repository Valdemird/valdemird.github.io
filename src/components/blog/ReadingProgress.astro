---

<div id="reading-progress" class="reading-progress" aria-hidden="true">
	<div id="reading-progress-bar" class="reading-progress-bar"></div>
</div>

<script>
	// The layout persists across View Transition navigations (post → post via
	// Read next, module → module via the pager), so query the bar and article on
	// every page load and tear the listener down before the DOM swaps.
	let controller: AbortController | null = null;

	function teardown() {
		controller?.abort();
		controller = null;
	}

	function init() {
		teardown();
		const bar = document.getElementById('reading-progress-bar');
		const article = document.querySelector('article');
		if (!bar || !article) return;

		controller = new AbortController();
		const { signal } = controller;
		let ticking = false;

		const update = () => {
			const rect = article.getBoundingClientRect();
			const articleTop = rect.top + window.scrollY;
			const scrolled = window.scrollY - articleTop + window.innerHeight * 0.3;
			const progress = rect.height > 0 ? Math.min(Math.max(scrolled / rect.height, 0), 1) : 0;
			bar.style.transform = `scaleX(${progress})`;
			ticking = false;
		};

		const onScroll = () => {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(update);
		};

		window.addEventListener('scroll', onScroll, { passive: true, signal });
		window.addEventListener('resize', onScroll, { passive: true, signal });
		update();
	}

	document.addEventListener('astro:page-load', init);
	document.addEventListener('astro:before-swap', teardown);
</script>

<style>
	.reading-progress {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		z-index: 200;
		background: transparent;
	}

	.reading-progress-bar {
		height: 100%;
		background: var(--color-accent);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 80ms linear;
	}
</style>
