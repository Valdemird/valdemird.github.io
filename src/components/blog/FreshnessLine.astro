---
/**
 * FreshnessLine — editorial header line for blog posts.
 *
 * Renders a mono eyebrow row:
 *
 *   PUBLISHED · APR 26, 2026   REVIEWED · MAY 12, 2026   STATUS · UP TO DATE
 *
 * Each segment hides when its source field is empty. Status is
 * author-curated — speak in YOUR voice, not the tool's. Good:
 * "Still reflects my workflow", "Updated for new tooling", "Outdated
 * — see successor". Avoid: "Reviewed with <some LLM>" — that signals
 * "AI-checked content", which is the opposite of editorial trust.
 * When status contains "outdated", "deprecated", or "archived"
 * (case-insensitive), the segment renders in the warning color.
 */

import FormattedDate from '../FormattedDate.astro';

interface Props {
	pubDate: Date;
	reviewedDate?: Date;
	status?: string;
	lang?: 'en' | 'es';
}

const { pubDate, reviewedDate, status, lang = 'en' } = Astro.props;

const labels = {
	en: { published: 'Published', reviewed: 'Reviewed', status: 'Status' },
	es: { published: 'Publicado', reviewed: 'Revisado', status: 'Estado' },
}[lang];

const isWarning = !!status && /outdated|deprecated|archived|desactualizado|obsoleto|archivado/i.test(status);
---

<p class="freshness">
	<span class="seg">
		<span class="key">{labels.published}</span>
		<span class="sep" aria-hidden="true">·</span>
		<FormattedDate date={pubDate} locale={lang} />
	</span>
	{reviewedDate && (
		<span class="seg">
			<span class="key">{labels.reviewed}</span>
			<span class="sep" aria-hidden="true">·</span>
			<FormattedDate date={reviewedDate} locale={lang} />
		</span>
	)}
	{status && (
		<span class={`seg seg-status${isWarning ? ' is-warning' : ''}`}>
			<span class="key">{labels.status}</span>
			<span class="sep" aria-hidden="true">·</span>
			<span class="status-value">{status}</span>
		</span>
	)}
</p>

<style>
	.freshness {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 0.4rem 1.4rem;
		margin: 0 0 0.6em;
		padding: 0;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-text-muted);
		line-height: 1.4;
	}

	.seg {
		display: inline-flex;
		align-items: baseline;
		gap: 0.45em;
	}

	/* Muted is the floor for legible text (4.5:1); no extra opacity on top. */
	.key {
		color: var(--color-text-muted);
	}

	.sep {
		color: var(--color-border-strong);
	}

	.freshness :global(time) {
		color: var(--color-text-secondary);
	}

	.status-value {
		color: var(--color-text-secondary);
		letter-spacing: 0.1em;
	}

	.seg-status.is-warning .status-value,
	.seg-status.is-warning .key {
		color: var(--color-warning-text);
	}

	@media (max-width: 540px) {
		.freshness {
			gap: 0.3rem 0.9rem;
			font-size: 0.62rem;
			letter-spacing: 0.1em;
		}
	}
</style>
