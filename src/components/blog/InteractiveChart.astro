---
/**
 * InteractiveChart — multi-type chart with optional annotations and a
 * story-first lede.
 *
 * Types:
 *   - "bar"        vertical columns (HTML, CSS-animated)
 *   - "horizontal" ranked rows (HTML, CSS-animated)
 *   - "line"       SVG, GSAP entrance; multi-series via `series`
 *   - "area"       line + filled area
 *   - "donut"      part-of-whole ring with a legend
 *   - "scatter"    x/y points via `points`
 *
 * Layout rules:
 *   - The header is a figure header, not a page headline: a mono eyebrow
 *     (`title`) over a Fraunces lede (`story`) sized for a figure.
 *   - Bars share one baseline. Horizontal rows sit on a subgrid, so the label
 *     column is as wide as the longest label (capped) and every bar starts at
 *     the same x; values get their own right-aligned tabular column. On narrow
 *     containers labels move above their bar (container query).
 *   - Annotations never overlap marks: horizontal → a note line under the
 *     bar; vertical → a numbered marker on the value plus a notes list;
 *     line/area → placed at build time inside the plot (edge-aware anchors,
 *     above/below, collision-stepped) with a surface halo.
 *   - SVG types render a wide and a narrow variant; a container query shows
 *     the one that fits, and `--u` keeps SVG text at a readable on-screen
 *     size while the viewBox scales.
 *
 * All geometry is computed at BUILD time (src/lib/chart/*, d3-scale/d3-shape);
 * nothing d3 ships to the client. Client code: entrance animation (GSAP for
 * SVG, CSS transitions for bars) and src/lib/chart/interact.ts (hover scrub,
 * ←/→/Home/End keyboard walk with aria-live, legend toggling).
 *
 * Respects prefers-reduced-motion: bars snap via the global CSS rule; SVG
 * types skip GSAP entrance and render at final state immediately.
 */
import { linearScale, pointPositions, valueDomain, formatTick } from "../../lib/chart/scales";
import { linePath as buildLinePath, areaPath as buildAreaPath, type CurveKind } from "../../lib/chart/geometry";
import { VARIANTS, TEXT_PX, niceMax, plotPad, thinLabels, placeNotes, textWidthEm, boxHitsLines, type Variant, type PlacedNote } from "../../lib/chart/layout";

/** Semantic tones: for meaning only (good / risky / bad), never for decoration. */
type Tone = "accent" | "success" | "warning" | "destructive" | "muted";

interface DataPoint {
  label: string;
  value: number;
  color?: string;
}
interface Annotation {
  /** 0-indexed position in `data` the annotation points to. */
  targetIndex: number;
  /** Annotation text. Keep it short (≤ 12 words). */
  text: string;
  /** Visually emphasize this data point as the story's focus. */
  emphasize?: boolean;
}
interface Series {
  name: string;
  color?: string;
  /** Semantic color for a series whose meaning is good/bad (wins over the palette). */
  tone?: Tone;
  data: DataPoint[];
}
interface ScatterPoint {
  x: number;
  y: number;
  label?: string;
  color?: string;
  /** Call this point out: accent ink, larger mark, and its label drawn beside it. */
  highlight?: boolean;
}
interface Threshold {
  value: number;
  label?: string;
}
interface Props {
  type?: "bar" | "horizontal" | "line" | "area" | "donut" | "scatter";
  /** Small mono eyebrow above the story (what is measured). */
  title?: string;
  /** Finding-first lede. Editorial voice. */
  story?: string;
  /** Optional attribution shown below the chart. Use the `source` slot for inline markup. */
  source?: string;
  data?: DataPoint[];
  /** Multi-series lines. Line type only. */
  series?: Series[];
  /**
   * Series colors. "categorical" (default): distinct brand hues for unrelated
   * series. "sequential": one hue, light → dark, for ordered series (levels).
   */
  palette?: "categorical" | "sequential";
  /** Scatter points. Scatter type only. */
  points?: ScatterPoint[];
  /** Per-point callouts (first series in multi-series mode). */
  annotations?: Annotation[];
  /** Dashed reference lines on line/area/scatter. */
  thresholds?: Threshold[];
  /** Interpolation for line/area paths. */
  curve?: CurveKind;
  /** Hover/keyboard layer on SVG types. Default true. */
  interactive?: boolean;
  /** Value axis label (line/area/scatter). */
  yLabel?: string;
  /** Category / x axis label (line/area/scatter). */
  xLabel?: string;
  /** Suffix appended to printed values, readouts and (when short) y ticks, e.g. "%" or " min". */
  unit?: string;
  /** Suffix for x values in the readout header, e.g. " steps" → "10 steps". */
  xUnit?: string;
  /** Donut: small caption under the center total, e.g. "hours". */
  totalLabel?: string;
}

const {
  type = "bar",
  title,
  story,
  source,
  data = [],
  series,
  palette = "categorical",
  points = [],
  annotations = [],
  thresholds = [],
  curve = "linear",
  interactive = true,
  yLabel,
  xLabel,
  unit = "",
  xUnit = "",
  totalLabel,
} = Astro.props;

const fmt = (v: number) => `${v}${unit}`;
// Short units ("%", "s") ride on the y ticks too; long ones (" min") stay in
// the readout so the tick column doesn't balloon.
const tickUnit = unit.trim().length <= 2 ? unit : "";
const fmtTick = (v: number) => `${formatTick(v)}${tickUnit}`;

const TONES: Record<Tone, string> = {
  accent: "var(--color-accent)",
  success: "var(--color-success)",
  warning: "var(--color-warning)",
  destructive: "var(--color-destructive)",
  muted: "var(--chart-mute)",
};
/** Brand categorical ramp: accent-anchored hues at matched lightness/chroma. */
const CATEGORICAL = ["var(--chart-cat-1)", "var(--chart-cat-2)", "var(--chart-cat-3)", "var(--chart-cat-4)"];
/** Single-hue ramp, faint → strong; ordered series spread across it. */
const SEQUENTIAL = ["var(--chart-seq-1)", "var(--chart-seq-2)", "var(--chart-seq-3)", "var(--chart-seq-4)", "var(--chart-seq-5)"];

function seriesColor(s: Series, i: number, n: number): string {
  if (s.color) return s.color;
  if (s.tone) return TONES[s.tone];
  if (palette === "sequential") {
    const k = n <= 1 ? SEQUENTIAL.length - 1 : Math.round((i * (SEQUENTIAL.length - 1)) / (n - 1));
    return SEQUENTIAL[k];
  }
  return CATEGORICAL[i % CATEGORICAL.length];
}

const annotationMap = new Map<number, Annotation>();
for (const a of annotations) annotationMap.set(a.targetIndex, a);
const hasFocus = annotations.some((a) => a.emphasize);

// ---------------------------------------------------------------------------
// Bars. Horizontal: a nice 0-anchored domain (percent data ends at 100).
// Vertical: the tallest bar fills the plot; the value label sits in the
// plot's top padding, so there's no rounded-up headroom.
// ---------------------------------------------------------------------------
const barMax = type === "bar" ? Math.max(1e-9, ...data.map((d) => d.value)) : niceMax(data.map((d) => d.value));
const barPct = (v: number) => Math.max(0, Math.min(100, (v / barMax) * 100));
// Bars annotate with one voice: a numbered marker on the mark, the note in
// sans beside the same marker (under the plot for columns, under the row for
// horizontal bars).
const barNotes = type === "bar" || type === "horizontal"
  ? [...annotationMap.entries()].sort((a, b) => a[0] - b[0]).map(([i, a], n) => ({ i, n: n + 1, ...a }))
  : [];
const barNoteNo = new Map(barNotes.map((b) => [b.i, b.n]));

// ---------------------------------------------------------------------------
// SVG types (line / area / scatter): one model per layout variant.
// ---------------------------------------------------------------------------
const isLineish = type === "line" || type === "area";
const isScatter = type === "scatter" && points.length > 0;
const seriesMode = isLineish && !!series && series.length > 0;
const seriesList: Series[] = seriesMode ? series! : isLineish ? [{ name: "", data, tone: "accent" }] : [];
const xLabels = seriesList[0]?.data.map((d) => d.label) ?? [];

const yDomain: [number, number] | null = isLineish
  ? valueDomain([...seriesList.flatMap((s) => s.data.map((d) => d.value)), ...thresholds.map((t) => t.value)])
  : isScatter
    ? [
        Math.min(...points.map((p) => p.y), ...thresholds.map((t) => t.value)),
        Math.max(...points.map((p) => p.y), ...thresholds.map((t) => t.value)),
      ]
    : null;
const xDomain: [number, number] | null = isScatter
  ? [Math.min(...points.map((p) => p.x)), Math.max(...points.map((p) => p.x))]
  : null;

interface SvgModel {
  v: Variant;
  plotTop: number;
  plotBottom: number;
  plotLeft: number;
  plotRight: number;
  yTicks: { y: number; label: string }[];
  xTicks: { x: number; label: string }[];
  thresholds: { y: number; label?: string; x: number; dy: string; anchor: "start" | "end" }[];
  series: {
    name: string;
    color: string;
    linePath: string;
    areaPath: string;
    dots: { cx: number; cy: number; label: string; value: number; color: string; emph: boolean }[];
  }[];
  scatter: { cx: number; cy: number; label: string; x: number; value: number; color: string; highlight: boolean; tx: number; ty: number; anchor: "start" | "end" }[];
  notes: PlacedNote[];
}

/** Keep a centred x label inside the plot: clamp its centre by half its width. */
function clampLabel(x: number, label: string, v: Variant, left: number, right: number): number {
  const half = (textWidthEm(label) * v.tickFontMax) / 2;
  return Math.max(left + half, Math.min(right - half, x));
}

function buildModel(v: Variant): SvgModel {
  const tickProbe = linearScale(yDomain!, [0, 1]);
  const pad = plotPad(v, tickProbe.ticks.map(fmtTick));
  const plotLeft = pad.left;
  const plotRight = v.w - pad.right;
  const plotTop = pad.top;
  const plotBottom = v.h - pad.bottom;
  const y = linearScale(yDomain!, [plotBottom, plotTop]);
  const yTicks = y.ticks.map((t) => ({ y: y(t), label: fmtTick(t) }));
  // Threshold labels sit at the right end above their line, unless a series
  // crosses that spot: then below it, then at the left end.
  const thFont = v.tickFontMax * (TEXT_PX.threshold / TEXT_PX.tick);
  const placeThresholds = (lines: [number, number][][]) =>
    thresholds.map((t) => {
      const ty = y(t.value);
      if (!t.label) return { y: ty, label: t.label, x: plotRight, dy: "-0.55em", anchor: "end" as const };
      const w = textWidthEm(t.label) * thFont;
      const spots = [
        { x: plotRight, anchor: "end" as const, dy: "-0.55em", box: [plotRight - w, ty - thFont * 1.3, plotRight, ty - 2] },
        { x: plotRight, anchor: "end" as const, dy: "1.15em", box: [plotRight - w, ty + 2, plotRight, ty + thFont * 1.4] },
        { x: plotLeft + 4, anchor: "start" as const, dy: "-0.55em", box: [plotLeft + 4, ty - thFont * 1.3, plotLeft + 4 + w, ty - 2] },
        { x: plotLeft + 4, anchor: "start" as const, dy: "1.15em", box: [plotLeft + 4, ty + 2, plotLeft + 4 + w, ty + thFont * 1.4] },
      ];
      const spot = spots.find((sp) => !boxHitsLines(sp.box as [number, number, number, number], lines)) ?? spots[0];
      return { y: ty, label: t.label, x: spot.x, dy: spot.dy, anchor: spot.anchor };
    });

  if (isScatter) {
    const x = linearScale(xDomain!, [plotLeft, plotRight]);
    const xs = x.ticks.map((t) => x(t));
    const labels = x.ticks.map(formatTick);
    const keep = thinLabels(labels, xs, v.tickFontMax);
    const midX = (plotLeft + plotRight) / 2;
    return {
      v, plotTop, plotBottom, plotLeft, plotRight, yTicks,
      // Scatter points are short "lines" so a label never sits on a dot.
      thresholds: placeThresholds(points.map((p) => {
        const px = x(p.x);
        const py = y(p.y);
        return [[px - 6, py], [px + 6, py]] as [number, number][];
      })),
      xTicks: labels
        .map((label, i) => ({ x: clampLabel(xs[i], label, v, plotLeft - 8, plotRight + 8), label }))
        .filter((_, i) => keep.has(i)),
      series: [],
      scatter: points.map((p) => {
        const cx = x(p.x);
        const cy = y(p.y);
        const right = cx > midX;
        return {
          cx,
          cy,
          x: p.x,
          label: p.label ?? `${p.x}`,
          value: p.y,
          color: p.color ?? (p.highlight ? "var(--color-accent)" : points.some((q) => q.highlight) ? "var(--chart-mute)" : "var(--color-accent)"),
          highlight: !!p.highlight,
          // Highlight label: beside the point, on the side with room.
          tx: right ? cx - 11 : cx + 11,
          ty: cy < plotTop + 18 ? cy + 4 : cy - 9,
          anchor: right ? "end" as const : "start" as const,
        };
      }),
      notes: [],
    };
  }

  // Line / area share one inset so first and last points (and their labels)
  // never sit on the frame.
  const inset = v.key === "wide" ? 22 : 14;
  const xs = pointPositions(xLabels.length, plotLeft + inset, plotRight - inset);
  const keep = thinLabels(xLabels, xs, v.tickFontMax);
  const rendered = seriesList.map((s, si) => {
    const color = seriesColor(s, si, seriesList.length);
    const pts = s.data.map((d, i) => [xs[i] ?? (plotLeft + plotRight) / 2, y(d.value)] as [number, number]);
    return {
      name: s.name,
      color,
      pts,
      linePath: buildLinePath(pts, curve),
      areaPath: type === "area" ? buildAreaPath(pts, plotBottom, curve) : "",
      dots: s.data.map((d, i) => ({
        cx: pts[i][0],
        cy: pts[i][1],
        label: d.label,
        value: d.value,
        color: d.color ?? color,
        emph: si === 0 && !!annotationMap.get(i)?.emphasize,
      })),
    };
  });
  const first = rendered[0];
  const notes = first
    ? placeNotes(
        [...annotationMap.entries()]
          .filter(([i]) => first.dots[i])
          .sort((a, b) => a[0] - b[0])
          .map(([i, a]) => ({ text: a.text, cx: first.dots[i].cx, cy: first.dots[i].cy })),
        v,
        pad,
        {
          lines: rendered.map((r) => r.pts),
          hlines: thresholds.map((t) => y(t.value)),
          dots: rendered.flatMap((r) => r.pts),
        },
      )
    : [];
  return {
    v, plotTop, plotBottom, plotLeft, plotRight, yTicks,
    thresholds: placeThresholds(rendered.map((r) => r.pts)),
    xTicks: xLabels
      .map((label, i) => ({ x: clampLabel(xs[i], label, v, plotLeft, plotRight + pad.right - 2), label }))
      .filter((_, i) => keep.has(i)),
    series: rendered,
    scatter: [],
    notes,
  };
}

const svgModels: SvgModel[] = (isLineish && xLabels.length) || isScatter ? VARIANTS.map(buildModel) : [];
const isInteractiveSvg = interactive && svgModels.length > 0;
const scatterAxes = isScatter ? { x: xLabel ?? "", y: yLabel ?? "" } : null;

// ---------------------------------------------------------------------------
// Donut: square viewBox. Slices step down a solid single-hue ramp (every
// step ≥ 3:1 on the card). With an emphasized slice, it takes the accent and
// the rest step down a neutral ramp.
// ---------------------------------------------------------------------------
const total = data.reduce((s, d) => s + d.value, 0);
const DONUT = { size: 240, r: 112, inner: 76 };
function donutArcs() {
  if (type !== "donut" || total === 0) return [] as { path: string; color: string; label: string; value: number; pct: number; emph: boolean }[];
  const c = DONUT.size / 2;
  let acc = 0;
  let rest = 0;
  return data.map((d, i) => {
    const a0 = (acc / total) * Math.PI * 2 - Math.PI / 2;
    acc += d.value;
    // A full ring can't be drawn as one arc; nudge the end so it stays visible.
    const a1 = Math.min((acc / total) * Math.PI * 2 - Math.PI / 2, a0 + Math.PI * 2 - 1e-4);
    const p = (r: number, a: number) => `${(c + r * Math.cos(a)).toFixed(2)},${(c + r * Math.sin(a)).toFixed(2)}`;
    const large = a1 - a0 > Math.PI ? 1 : 0;
    const emph = !!annotationMap.get(i)?.emphasize;
    const auto = hasFocus
      ? emph ? "var(--color-accent)" : `var(--chart-neutral-${Math.min(4, ++rest)})`
      : `var(--chart-seq-${5 - Math.min(4, i)})`;
    return {
      path: `M${p(DONUT.r, a0)} A${DONUT.r},${DONUT.r} 0 ${large} 1 ${p(DONUT.r, a1)} L${p(DONUT.inner, a1)} A${DONUT.inner},${DONUT.inner} 0 ${large} 0 ${p(DONUT.inner, a0)} Z`,
      color: d.color ?? auto,
      label: d.label,
      value: d.value,
      pct: d.value / total,
      emph,
    };
  });
}
const arcs = donutArcs();
const hasSourceSlot = Astro.slots.has("source");

const ariaLabel = story ?? title ?? "chart";
---

<figure
  class="chart-container"
  data-chart-type={type}
  data-chart
  data-chart-interactive={isInteractiveSvg ? "" : undefined}
  data-x-unit={xUnit || undefined}
  data-x-axis={scatterAxes?.x || undefined}
  data-y-axis={scatterAxes?.y || undefined}
>
  {(title || story || seriesMode) && (
    <header class="chart-head">
      {title && <div class="chart-eyebrow">{title}</div>}
      {story && <div class="chart-story">{story}</div>}
      {seriesMode && svgModels[0] && (
        <div class="chart-legend" role="group" aria-label="Toggle series">
          {svgModels[0].series.map((s) => (
            <button type="button" class="chart-legend-btn" data-series-toggle={s.name} aria-pressed="true">
              <span class="chart-legend-swatch" style={`--swatch: ${s.color}`} aria-hidden="true"></span>
              {s.name}
            </button>
          ))}
        </div>
      )}
    </header>
  )}

  <div class="chart-body">
    {type === "bar" && (
      <div class="vbar" style={`--n: ${data.length}`} data-focus={hasFocus ? "" : undefined}>
        <div class="vbar-plot">
          {data.map((item, i) => {
            const no = barNoteNo.get(i);
            return (
              <div
                class="vbar-col"
                tabindex="0"
                role="img"
                aria-label={`${item.label}: ${fmt(item.value)}`}
                data-emphasize={annotationMap.get(i)?.emphasize ? "" : undefined}
              >
                <div
                  class="vbar-fill"
                  style={`--h: ${barPct(item.value)}%; --bar-color: ${item.color || "var(--color-accent)"}; --bar-delay: ${i * 0.07}s;`}
                >
                  <span class="vbar-value" aria-hidden="true">
                    {fmt(item.value)}
                    {no && <span class="chart-mark">{no}</span>}
                  </span>
                </div>
              </div>
            );
          })}
        </div>
        <div class="vbar-labels" aria-hidden="true">
          {data.map((item) => <span class="vbar-label">{item.label}</span>)}
        </div>
      </div>
    )}

    {type === "horizontal" && (
      <div class="hbar" data-focus={hasFocus ? "" : undefined}>
        {data.map((item, i) => {
          const ann = annotationMap.get(i);
          const no = barNoteNo.get(i);
          return (
            <div
              class="hbar-row"
              tabindex="0"
              role="img"
              aria-label={`${item.label}: ${fmt(item.value)}${ann ? `. ${ann.text}` : ""}`}
              data-emphasize={ann?.emphasize ? "" : undefined}
            >
              <span class="hbar-label" aria-hidden="true">{item.label}</span>
              <span class="hbar-track" aria-hidden="true">
                <span
                  class="hbar-fill"
                  style={`--w: ${barPct(item.value)}%; --bar-color: ${item.color || "var(--color-accent)"}; --bar-delay: ${i * 0.08}s;`}
                ></span>
              </span>
              <span class="hbar-value" aria-hidden="true">{fmt(item.value)}</span>
              {ann && (
                <span class="hbar-note" aria-hidden="true">
                  <span class="chart-mark">{no}</span>
                  <span>{ann.text}</span>
                </span>
              )}
            </div>
          );
        })}
      </div>
    )}

    {svgModels.length > 0 && (
      <>
        {yLabel && <div class="chart-axis chart-axis-y">{yLabel}</div>}
        {svgModels.map((m) => (
          <svg
            class="chart-svg"
            data-variant={m.v.key}
            viewBox={`0 0 ${m.v.w} ${m.v.h}`}
            role="img"
            aria-label={ariaLabel}
            preserveAspectRatio="xMidYMid meet"
            data-pad-top={m.plotTop}
            data-pad-bottom={m.v.h - m.plotBottom}
            data-plot-left={m.plotLeft}
            data-plot-right={m.plotRight}
          >
            {m.yTicks.map((t) => (
              <g class="chart-svg-grid">
                <line x1={m.plotLeft} y1={t.y} x2={m.plotRight} y2={t.y} />
                <text x={m.plotLeft} y={t.y} dx="-0.6em" dy="0.34em" text-anchor="end">{t.label}</text>
              </g>
            ))}

            {m.xTicks.map((t) => (
              <text class="chart-svg-xlabel" x={t.x} y={m.plotBottom} dy="1.6em" text-anchor="middle">{t.label}</text>
            ))}

            {m.thresholds.map((t) => (
              <g class="chart-svg-threshold">
                <line x1={m.plotLeft} y1={t.y} x2={m.plotRight} y2={t.y} />
                {t.label && (
                  <text x={t.x} y={t.y} dy={t.dy} text-anchor={t.anchor}>{t.label}</text>
                )}
              </g>
            ))}

            {m.series.map((s) => (
              <g data-series-name={s.name} class="chart-series">
                {type === "area" && (
                  <path class="chart-svg-area" d={s.areaPath} fill={s.color} fill-opacity="0.12" />
                )}
                <path
                  class="chart-svg-line"
                  d={s.linePath}
                  pathLength="1"
                  fill="none"
                  stroke={s.color}
                  stroke-width="2.25"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
                {s.dots.map((d) => (
                  <circle
                    class:list={["chart-svg-dot", { "is-emph": d.emph }]}
                    data-pt
                    data-label={d.label}
                    data-value={fmt(d.value)}
                    data-series={s.name || undefined}
                    cx={d.cx}
                    cy={d.cy}
                    r={d.emph ? 5.5 : 3.5}
                    fill={d.color}
                  />
                ))}
              </g>
            ))}

            {m.notes.map((n) => n.footnote ? (
              <g class="chart-svg-footmark" aria-hidden="true">
                <circle cx={n.cx} cy={n.cy - 16} r="8" />
                <text x={n.cx} y={n.cy - 16} dy="0.35em" text-anchor="middle">{n.footnote}</text>
              </g>
            ) : (
              <g class="chart-svg-annotation">
                <line x1={n.cx} y1={n.y1} x2={n.cx} y2={n.y2} />
                <text
                  x={n.x}
                  y={n.y}
                  dy={n.side === "below" ? "0.9em" : undefined}
                  text-anchor={n.anchor}
                >{n.text}</text>
              </g>
            ))}

            {m.scatter.map((p) => (
              <circle
                class:list={["chart-svg-dot chart-svg-scatter-dot", { "is-highlight": p.highlight }]}
                data-pt
                data-label={p.label}
                data-x={p.x}
                data-value={fmt(p.value)}
                cx={p.cx}
                cy={p.cy}
                r={p.highlight ? 6 : 4.5}
                fill={p.color}
              />
            ))}
            {m.scatter.filter((p) => p.highlight).map((p) => (
              <text class="chart-svg-callout" x={p.tx} y={p.ty} text-anchor={p.anchor}>{p.label}</text>
            ))}
          </svg>
        ))}
        {xLabel && <div class="chart-axis chart-axis-x">{xLabel}</div>}
      </>
    )}

    {type === "donut" && (
      <div class="chart-donut" data-focus={hasFocus ? "" : undefined}>
        <svg class="chart-donut-svg" viewBox={`0 0 ${DONUT.size} ${DONUT.size}`} role="img" aria-label={ariaLabel}>
          {arcs.map((a, i) => (
            <path class:list={["chart-svg-arc", { "is-emph": a.emph }]} data-slice={i} d={a.path} fill={a.color} />
          ))}
          <text class="chart-donut-total" x={DONUT.size / 2} y={DONUT.size / 2} dy={totalLabel ? "0.1em" : "0.34em"} text-anchor="middle">
            {fmt(total)}
          </text>
          {totalLabel && (
            <text class="chart-donut-total-label" x={DONUT.size / 2} y={DONUT.size / 2} dy="2.6em" text-anchor="middle">{totalLabel}</text>
          )}
        </svg>
        <ul class="chart-donut-legend">
          {arcs.map((a, i) => (
            <li
              class:list={["chart-donut-legend-item", { "is-emph": a.emph }]}
              data-slice={i}
              tabindex="0"
            >
              <span class="chart-donut-swatch" style={`--swatch: ${a.color}`} aria-hidden="true"></span>
              <span class="chart-donut-label">{a.label}</span>
              <span class="chart-donut-value">{fmt(a.value)}</span>
              <span class="chart-donut-pct">{(a.pct * 100).toFixed(0)}%</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>

  {type === "bar" && barNotes.length > 0 && (
    <ol class="chart-notes">
      {barNotes.map((b) => (
        <li data-emphasize={b.emphasize ? "" : undefined}>
          <span class="chart-mark" aria-hidden="true">{b.n}</span>
          <span>{b.text}</span>
        </li>
      ))}
    </ol>
  )}

  {svgModels.map((m) => {
    const foot = m.notes.filter((n) => n.footnote);
    return foot.length > 0 && (
      <ol class="chart-notes chart-notes-svg" data-variant={m.v.key}>
        {foot.map((n) => (
          <li>
            <span class="chart-mark" aria-hidden="true">{n.footnote}</span>
            <span>{n.text}</span>
          </li>
        ))}
      </ol>
    );
  })}

  {(source || hasSourceSlot) && (
    <figcaption class="chart-source">
      {hasSourceSlot ? <slot name="source" /> : source}
    </figcaption>
  )}
</figure>

<script>
  import { getGsap, onReducedMotion } from "../../lib/gsap";
  import { initChartInteractions } from "../../lib/chart/interact";

  function initCssAnimatedCharts() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("animate");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.3 },
    );
    document
      .querySelectorAll<HTMLElement>(
        '[data-chart][data-chart-type="bar"]:not(.animate), [data-chart][data-chart-type="horizontal"]:not(.animate)',
      )
      .forEach((el) => observer.observe(el));
  }

  async function initSvgCharts() {
    const nodes = document.querySelectorAll<HTMLElement>(
      '[data-chart][data-chart-type="line"]:not([data-chart-ready]), [data-chart][data-chart-type="area"]:not([data-chart-ready]), [data-chart][data-chart-type="donut"]:not([data-chart-ready]), [data-chart][data-chart-type="scatter"]:not([data-chart-ready])',
    );
    if (nodes.length === 0) return;

    if (onReducedMotion()) {
      for (const n of nodes) n.dataset.chartReady = "1";
      return;
    }

    const { gsap } = await getGsap();

    for (const node of nodes) {
      node.dataset.chartReady = "1";
      const type = node.dataset.chartType;
      // Plays once. Reversing on scroll-up erased a chart that was still on
      // screen; the lab's replay button re-runs the entrance on demand.
      const st = { trigger: node, start: "top 80%", toggleActions: "play none none none" };

      if (type === "line" || type === "area") {
        // pathLength="1" on every line, so the draw-in is resolution-free and
        // identical on the hidden layout variant.
        gsap.fromTo(
          node.querySelectorAll(".chart-svg-line"),
          { strokeDasharray: "1 2", strokeDashoffset: 1.02 },
          { strokeDashoffset: 0, duration: 1.1, stagger: 0.18, ease: "power2.out", scrollTrigger: st },
        );
        gsap.from(node.querySelectorAll(".chart-svg-area"), {
          opacity: 0, duration: 1.1, delay: 0.2, stagger: 0.18, ease: "power2.out", scrollTrigger: st,
        });
        gsap.from(node.querySelectorAll(".chart-svg-dot"), {
          opacity: 0, scale: 0.4, transformOrigin: "center", duration: 0.4, stagger: 0.03,
          ease: "back.out(1.8)", delay: 0.7, scrollTrigger: st,
        });
        gsap.from(node.querySelectorAll(".chart-svg-annotation"), {
          opacity: 0, duration: 0.5, ease: "power2.out", stagger: 0.08, delay: 1.0, scrollTrigger: st,
        });
      } else if (type === "scatter") {
        gsap.from(node.querySelectorAll(".chart-svg-scatter-dot"), {
          opacity: 0, scale: 0.3, transformOrigin: "center", duration: 0.45,
          stagger: { each: 0.025, from: "random" }, ease: "back.out(1.8)", scrollTrigger: st,
        });
      } else if (type === "donut") {
        gsap.from(node.querySelectorAll(".chart-svg-arc"), {
          opacity: 0, scale: 0.86, svgOrigin: "120 120", duration: 0.7,
          ease: "power3.out", stagger: 0.08, scrollTrigger: st,
        });
      }
    }
  }

  // SVG text and strokes are sized in viewBox units times --u. Writing
  // --u = viewBox width / rendered width keeps them at fixed on-screen px
  // (12px ticks, 11px threshold labels, 13px notes) at every column width.
  // Without JS the container-query --u values are the fallback.
  let unitObserver: ResizeObserver | null = null;
  function initUnitScale() {
    unitObserver?.disconnect();
    unitObserver = new ResizeObserver((entries) => {
      for (const entry of entries) {
        const svg = entry.target as SVGSVGElement;
        const w = entry.contentRect.width;
        if (w > 0) svg.style.setProperty("--u", (svg.viewBox.baseVal.width / w).toFixed(4));
      }
    });
    document.querySelectorAll<SVGSVGElement>("svg.chart-svg").forEach((svg) => unitObserver!.observe(svg));
  }

  // Donut: a legend row and its slice light up together, from either side.
  function initDonutLinks() {
    document.querySelectorAll<HTMLElement>(".chart-donut:not([data-link-ready])").forEach((donut) => {
      donut.dataset.linkReady = "1";
      const set = (i: string | null) => {
        if (i === null) delete donut.dataset.active;
        else donut.dataset.active = i;
        donut.querySelectorAll<Element>("[data-slice]").forEach((el) =>
          el.classList.toggle("is-active", el.getAttribute("data-slice") === i),
        );
      };
      donut.querySelectorAll<HTMLElement | SVGElement>("[data-slice]").forEach((el) => {
        const i = el.getAttribute("data-slice");
        el.addEventListener("pointerenter", () => set(i));
        el.addEventListener("pointerleave", () => set(null));
        el.addEventListener("focus", () => set(i));
        el.addEventListener("blur", () => set(null));
      });
    });
  }

  function initAll() {
    initCssAnimatedCharts();
    initSvgCharts();
    initChartInteractions();
    initUnitScale();
    initDonutLinks();
  }

  initAll();
  document.addEventListener("astro:after-swap", initAll);
</script>

<style>
  /* ======================================================================
     Frame + header
     ====================================================================== */
  .chart-container {
    /* Chart palette. Semantic tokens (success/warning/destructive) stay for
       meaning; series get a brand ramp built from the accent. Every data mark
       holds ≥ 3:1 against the card and the track (WCAG 1.4.11). */
    --chart-cat-1: var(--color-accent);
    --chart-cat-2: oklch(0.56 0.11 195);
    --chart-cat-3: oklch(0.55 0.15 330);
    --chart-cat-4: oklch(0.58 0.12 60);
    /* Ordered series: one hue, faint → strong. */
    --chart-seq-1: oklch(0.66 0.09 260);
    --chart-seq-2: oklch(0.59 0.12 260);
    --chart-seq-3: oklch(0.52 0.15 260);
    --chart-seq-4: oklch(0.46 0.16 260);
    --chart-seq-5: oklch(0.4 0.14 260);
    /* Context slices next to an emphasized one. */
    --chart-neutral-1: oklch(0.53 0.015 260);
    --chart-neutral-2: oklch(0.58 0.015 260);
    --chart-neutral-3: oklch(0.62 0.015 260);
    --chart-neutral-4: oklch(0.66 0.015 260);
    /* A mark that steps back (not the story's focus): muted, still 3:1. */
    --chart-mute: oklch(0.62 0.03 260);
    --chart-threshold: oklch(0.5 0.03 260);
    --track: oklch(from var(--color-text) l c h / 0.065);
    --bar-ease: cubic-bezier(0.22, 1, 0.36, 1);
    container: chart / inline-size;
    margin: 2.25em 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-surface);
    font-variant-numeric: tabular-nums;
  }

  :global([data-theme='dark']) .chart-container {
    --chart-cat-2: oklch(0.72 0.1 195);
    --chart-cat-3: oklch(0.72 0.13 330);
    --chart-cat-4: oklch(0.76 0.11 65);
    --chart-seq-1: oklch(0.55 0.08 260);
    --chart-seq-2: oklch(0.63 0.1 260);
    --chart-seq-3: oklch(0.71 0.12 260);
    --chart-seq-4: oklch(0.79 0.1 260);
    --chart-seq-5: oklch(0.87 0.07 260);
    --chart-neutral-1: oklch(0.68 0.015 260);
    --chart-neutral-2: oklch(0.63 0.015 260);
    --chart-neutral-3: oklch(0.58 0.015 260);
    --chart-neutral-4: oklch(0.54 0.015 260);
    --chart-mute: oklch(0.6 0.03 260);
    --chart-threshold: oklch(0.74 0.03 260);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .chart-container {
      --chart-cat-2: oklch(0.72 0.1 195);
      --chart-cat-3: oklch(0.72 0.13 330);
      --chart-cat-4: oklch(0.76 0.11 65);
      --chart-seq-1: oklch(0.55 0.08 260);
      --chart-seq-2: oklch(0.63 0.1 260);
      --chart-seq-3: oklch(0.71 0.12 260);
      --chart-seq-4: oklch(0.79 0.1 260);
      --chart-seq-5: oklch(0.87 0.07 260);
      --chart-neutral-1: oklch(0.68 0.015 260);
      --chart-neutral-2: oklch(0.63 0.015 260);
      --chart-neutral-3: oklch(0.58 0.015 260);
      --chart-neutral-4: oklch(0.54 0.015 260);
      --chart-mute: oklch(0.6 0.03 260);
      --chart-threshold: oklch(0.74 0.03 260);
    }
  }

  .chart-head {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.15rem 1.25rem 0;
  }

  .chart-eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* A figure lede, not a page headline: one step above body copy. */
  .chart-story {
    margin: 0;
    max-width: 52ch;
    font-family: var(--font-serif);
    font-size: 1.075rem;
    font-weight: 500;
    line-height: 1.38;
    letter-spacing: -0.005em;
    color: var(--color-text);
    text-wrap: pretty;
  }

  .chart-body {
    position: relative;
    padding: 1.25rem;
  }

  .chart-source :global(a) {
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: 0.2em;
    transition: color var(--duration-fast) var(--ease-smooth), text-decoration-color var(--duration-fast) var(--ease-smooth);
  }

  .chart-source :global(a:hover) {
    color: var(--color-accent);
    text-decoration-color: currentColor;
  }

  .chart-source :global(sup) {
    font-size: 0.72em;
    line-height: 0;
  }

  .chart-source {
    margin: 0;
    padding: 0.8rem 1.25rem 1rem;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  /* Marker shared by vertical-bar values and the notes list. */
  .chart-mark {
    display: inline-grid;
    place-items: center;
    flex: none;
    min-width: 16px;
    height: 16px;
    margin-left: 0.35em;
    padding: 0 0.25em;
    border-radius: 999px;
    border: 1px solid oklch(from var(--color-text) l c h / 0.3);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    line-height: 1;
    color: var(--color-text-secondary);
  }

  .chart-container .chart-notes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    margin: 0;
    padding: 0 1.25rem 1.1rem;
    list-style: none;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    line-height: 1.4;
    color: var(--color-text-secondary);
  }

  .chart-notes li {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }

  .chart-notes .chart-mark {
    margin-left: 0;
  }

  /* Line notes that found no clear spot in the plot: one list per layout
     variant, shown with the SVG variant it belongs to. */
  .chart-notes-svg[data-variant="narrow"] { display: none; }

  .chart-notes li[data-emphasize] {
    color: var(--color-text);
  }

  .chart-notes li[data-emphasize] .chart-mark,
  .vbar-col[data-emphasize] .chart-mark {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  @container chart (max-width: 479.98px) {
    .chart-head { padding: 1rem 1rem 0; }
    .chart-body { padding: 1.15rem 1rem 1rem; }
    .chart-source { padding: 0.75rem 1rem 0.9rem; }
    .chart-container .chart-notes { padding-inline: 1rem; }
  }

  /* Lists inside the figure: beat the article's prose list spacing. */
  .chart-container .chart-donut-legend,
  .chart-container .chart-sr {
    margin: 0;
    padding-left: 0;
    list-style: none;
  }

  .chart-container li {
    margin: 0;
  }

  .chart-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* ======================================================================
     Legend (multi-series)
     ====================================================================== */
  .chart-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.4rem;
  }

  .chart-legend-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.32em 0.75em;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-smooth),
      border-color var(--duration-fast) var(--ease-smooth),
      box-shadow var(--duration-fast) var(--ease-smooth),
      transform var(--duration-fast) var(--ease-spring),
      opacity var(--duration-fast) var(--ease-smooth);
  }

  .chart-legend-btn:hover {
    border-color: var(--color-border-strong);
    color: var(--color-text);
    transform: translateY(-1px);
    box-shadow: 0 2px 8px oklch(from var(--color-text) l c h / 0.08);
  }

  .chart-legend-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Off: the chip goes hollow (outline swatch, muted label, no fill). */
  .chart-legend-btn.legend-off {
    background: transparent;
    border-style: dashed;
    color: var(--color-text-muted);
  }

  /* Line series → a short line swatch, not a box. */
  .chart-legend-swatch {
    width: 0.9rem;
    height: 3px;
    border-radius: 2px;
    background: var(--swatch);
    box-shadow: inset 0 0 0 1px var(--swatch);
    transition: background-color var(--duration-fast) var(--ease-smooth), transform var(--duration-fast) var(--ease-spring);
  }

  .chart-legend-btn.legend-off .chart-legend-swatch {
    background: transparent;
    height: 5px;
  }

  .chart-legend-btn[aria-disabled="true"] {
    cursor: default;
  }

  /* ======================================================================
     Horizontal bars — one subgrid, one baseline x for every bar
     ====================================================================== */
  .hbar {
    display: grid;
    /* Labels take their natural width up to ~46% before wrapping. */
    grid-template-columns: fit-content(46%) minmax(0, 1fr) auto;
    column-gap: 1rem;
    row-gap: 0.95rem;
  }

  .hbar-row {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: center;
    row-gap: 0.35rem;
  }

  .hbar-label {
    grid-column: 1;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    line-height: 1.3;
    color: var(--color-text-secondary);
    text-wrap: balance;
    transition: color var(--duration-fast) var(--ease-smooth);
  }

  .hbar-track {
    grid-column: 2;
    display: block;
    height: 0.625rem;
    border-radius: 3px;
    background: var(--track);
    overflow: hidden;
  }

  .hbar-fill {
    display: block;
    height: 100%;
    width: var(--w);
    border-radius: 3px;
    background: var(--bar-color);
    transform-origin: left center;
    transition:
      transform 0.9s var(--bar-ease) var(--bar-delay),
      background-color var(--duration-fast) var(--ease-smooth);
  }

  .hbar-value {
    grid-column: 3;
    justify-self: end;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text);
  }

  /* Annotation: numbered marker + note on its own line under the bar,
     aligned to the bar's start (same voice as the column notes). */
  .hbar-note {
    grid-column: 2 / -1;
    display: flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--color-text-secondary);
  }

  .hbar-note .chart-mark {
    margin-left: 0;
  }

  .hbar-row[data-emphasize] .hbar-note .chart-mark {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  /* Focus: the emphasized row keeps full ink, the rest step back to a muted
     tone that still reads at 3:1 against the track. */
  .hbar[data-focus] .hbar-row:not([data-emphasize]) .hbar-fill {
    background: var(--chart-mute);
  }

  /* Hover / keyboard: the row under the pointer lifts to full ink. */
  .hbar-row {
    border-radius: var(--radius-sm);
    outline: none;
  }

  .hbar:has(.hbar-row:hover, .hbar-row:focus-visible) .hbar-row:not(:hover, :focus-visible) .hbar-fill {
    background: var(--chart-mute);
  }

  .hbar .hbar-row:is(:hover, :focus-visible) .hbar-track .hbar-fill {
    background: var(--bar-color);
    box-shadow: 0 2px 10px oklch(from var(--bar-color) l c h / 0.3);
  }

  .hbar-row:focus-visible .hbar-label {
    color: var(--color-text);
    text-decoration: underline 2px var(--color-accent);
    text-underline-offset: 0.3em;
  }

  .hbar-row[data-emphasize] .hbar-label {
    color: var(--color-text);
    font-weight: 500;
  }

  .hbar-row[data-emphasize] .hbar-note {
    color: var(--color-accent);
  }

  .hbar-row:hover .hbar-label {
    color: var(--color-text);
  }


  /* Narrow: label on its own line above the bar, value stays right. */
  @container chart (max-width: 479.98px) {
    .hbar {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 0.75rem;
      row-gap: 1.2rem;
    }

    .hbar-label {
      grid-column: 1 / -1;
      font-size: 0.82rem;
    }

    .hbar-track { grid-column: 1; }
    .hbar-value { grid-column: 2; }
    .hbar-note { grid-column: 1 / -1; }
  }

  /* ======================================================================
     Vertical bars
     ====================================================================== */
  .vbar {
    --gap: clamp(0.5rem, 4cqi, 1.75rem);
  }

  .vbar-plot,
  .vbar-labels {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    column-gap: var(--gap);
  }

  .vbar-plot {
    height: clamp(9.5rem, 30cqi, 12rem);
    padding-top: 1.6rem; /* exactly the value label above the tallest bar */
    background:
      linear-gradient(var(--color-border-strong), var(--color-border-strong)) bottom / 100% 1px no-repeat;
  }

  .vbar-col {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    height: 100%;
  }

  .vbar-col {
    outline: none;
  }

  .vbar-fill {
    position: relative;
    /* Columns size from their band, so a three-bar chart fills a wide column
       instead of floating thin bars in wide gutters. */
    width: min(58%, 7.5rem);
    min-width: min(100%, 1.75rem);
    height: var(--h);
    border-radius: 3px 3px 0 0;
    background: var(--bar-color);
    transform-origin: bottom center;
    transition:
      transform 0.8s var(--bar-ease) var(--bar-delay),
      background-color var(--duration-fast) var(--ease-smooth),
      box-shadow var(--duration-fast) var(--ease-smooth);
  }

  .vbar-value {
    position: absolute;
    bottom: calc(100% + 0.4rem);
    left: 50%;
    translate: -50% 0;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-text);
    transition: opacity 0.4s var(--ease-smooth) calc(var(--bar-delay) + 0.35s);
  }

  .vbar-labels {
    padding-top: 0.6rem;
