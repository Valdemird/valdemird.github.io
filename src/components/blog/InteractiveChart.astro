---
/**
 * InteractiveChart — multi-type chart with optional annotations and a
 * story-first headline.
 *
 * Types:
 *   - "bar" (vertical bars, CSS-animated)                    [original]
 *   - "horizontal" (horizontal bars, CSS-animated)          [original]
 *   - "line" (SVG, GSAP entrance; multi-series via `series`) [v2/v3]
 *   - "area" (line + filled area, SVG, GSAP entrance)       [v2]
 *   - "donut" (radial part-of-whole, SVG, GSAP entrance)    [v2]
 *   - "scatter" (x/y points via `points`, SVG)              [v3]
 *
 * v3 — scales/paths come from d3-scale/d3-shape at BUILD time (zero d3 on
 * the client; src/lib/chart/*), and SVG types gain client interactivity
 * from src/lib/chart/interact.ts:
 *   - hover scrub: crosshair + floating readout snapped to the nearest x
 *   - keyboard: focus the SVG, ←/→/Home/End walk the points, aria-live
 *     announces values, Escape dismisses
 *   - legend toggling for multi-series lines
 *
 * New props (all optional, existing posts unchanged):
 *   - series: multi-series lines `{ name, color?, data }[]`. Line type only;
 *     x labels come from the first series. `annotations` target the first
 *     series in this mode.
 *   - points: scatter data `{ x, y, label?, color? }[]` ("scatter" only).
 *   - thresholds: dashed reference lines `{ value, label? }[]` on
 *     line/area/scatter.
 *   - curve: "linear" (default) | "monotone" smooth interpolation.
 *   - interactive: set false to opt out of the hover/keyboard layer.
 *
 * Respects prefers-reduced-motion: bars snap via the global CSS rule; SVG
 * types skip GSAP entrance and render at final state immediately.
 */
import { linearScale, pointPositions, valueDomain, formatTick } from "../../lib/chart/scales";
import { linePath as buildLinePath, areaPath as buildAreaPath, type CurveKind } from "../../lib/chart/geometry";

interface DataPoint {
  label: string;
  value: number;
  color?: string;
}
interface Annotation {
  /** 0-indexed position in `data` the annotation points to. */
  targetIndex: number;
  /** Annotation text. Keep it short (≤ 12 words). */
  text: string;
  /** Visually emphasize this data point as the story's focus. */
  emphasize?: boolean;
}
interface Series {
  name: string;
  color?: string;
  data: DataPoint[];
}
interface ScatterPoint {
  x: number;
  y: number;
  label?: string;
  color?: string;
}
interface Threshold {
  value: number;
  label?: string;
}
interface Props {
  type?: "bar" | "horizontal" | "line" | "area" | "donut" | "scatter";
  /** Small meta label shown in the chart header bar (not the story). */
  title?: string;
  /** Finding-first headline. Editorial voice. */
  story?: string;
  /** Optional attribution shown below the chart in muted mono. */
  source?: string;
  data?: DataPoint[];
  /** Multi-series lines. Line type only. */
  series?: Series[];
  /** Scatter points. Scatter type only. */
  points?: ScatterPoint[];
  /** Per-point callouts (first series in multi-series mode). */
  annotations?: Annotation[];
  /** Dashed reference lines on line/area/scatter. */
  thresholds?: Threshold[];
  /** Interpolation for line/area paths. */
  curve?: CurveKind;
  /** Hover/keyboard layer on SVG types. Default true. */
  interactive?: boolean;
  /** Y-axis / value axis label for line and area charts. */
  yLabel?: string;
  /** X-axis / category axis label for line and area charts. */
  xLabel?: string;
}

const {
  type = "bar",
  title,
  story,
  source,
  data = [],
  series,
  points = [],
  annotations = [],
  thresholds = [],
  curve = "linear",
  interactive = true,
  yLabel,
  xLabel,
} = Astro.props;

const maxValue = data.length ? Math.max(...data.map((d) => d.value)) : 0;
const chartId = `chart-${Math.random().toString(36).slice(2, 7)}`;

/** Series palette — design tokens only, in narrative-priority order. */
const PALETTE = [
  "var(--color-accent)",
  "var(--color-success)",
  "var(--color-warning)",
  "var(--color-destructive)",
];

// --- SVG layout (line/area/scatter) ---
const SVG_W = 720;
const SVG_H = 320;
const PAD = { top: 16, right: 32, bottom: 40, left: 48 };
const plotW = SVG_W - PAD.left - PAD.right;
const plotH = SVG_H - PAD.top - PAD.bottom;

// Multi-series normalization: single-series line/area become one unnamed series.
const isLineish = type === "line" || type === "area";
const seriesMode = isLineish && !!series && series.length > 0;
const seriesList: Series[] = seriesMode
  ? series!
  : isLineish
    ? [{ name: "", data }]
    : [];

const xLabels = seriesList[0]?.data.map((d) => d.label) ?? [];
const xs = pointPositions(xLabels.length, PAD.left, PAD.left + plotW);

const lineValues = seriesList.flatMap((s) => s.data.map((d) => d.value));
const yScale = isLineish
  ? linearScale(valueDomain([...lineValues, ...thresholds.map((t) => t.value)]), [PAD.top + plotH, PAD.top])
  : null;

interface RenderedSeries {
  name: string;
  color: string;
  linePath: string;
  areaPath: string;
  dots: { cx: number; cy: number; label: string; value: number; color: string }[];
}
const renderedSeries: RenderedSeries[] = seriesList.map((s, si) => {
  const color = s.color ?? PALETTE[si % PALETTE.length];
  const pts = s.data.map((d, i) => [xs[i] ?? PAD.left + plotW / 2, yScale!(d.value)] as [number, number]);
  return {
    name: s.name,
    color,
    linePath: buildLinePath(pts, curve),
    areaPath: type === "area" ? buildAreaPath(pts, PAD.top + plotH, curve) : "",
    dots: s.data.map((d, i) => ({
      cx: pts[i][0],
      cy: pts[i][1],
      label: d.label,
      value: d.value,
      color: d.color ?? color,
    })),
  };
});

// --- Scatter geometry ---
const scatterX = type === "scatter" && points.length
  ? linearScale([Math.min(...points.map((p) => p.x)), Math.max(...points.map((p) => p.x))], [PAD.left, PAD.left + plotW])
  : null;
const scatterY = type === "scatter" && points.length
  ? linearScale(
      [Math.min(...points.map((p) => p.y), ...thresholds.map((t) => t.value)), Math.max(...points.map((p) => p.y), ...thresholds.map((t) => t.value))],
      [PAD.top + plotH, PAD.top],
    )
  : null;

const yTicks = yScale?.ticks ?? scatterY?.ticks ?? [];
const yPos = (v: number) => (yScale ?? scatterY)!(v);

// --- Donut geometry ---
const total = data.reduce((s, d) => s + d.value, 0);
const donutR = 100;
const donutInner = 62;
const donutCx = SVG_W / 2;
const donutCy = 170;
function donutArcs() {
  if (type !== "donut" || total === 0) return [] as { path: string; color: string; label: string; value: number; pct: number }[];
  let acc = 0;
  return data.map((d) => {
    const a0 = (acc / total) * Math.PI * 2 - Math.PI / 2;
    acc += d.value;
    const a1 = (acc / total) * Math.PI * 2 - Math.PI / 2;
    const x0 = donutCx + donutR * Math.cos(a0);
    const y0 = donutCy + donutR * Math.sin(a0);
    const x1 = donutCx + donutR * Math.cos(a1);
    const y1 = donutCy + donutR * Math.sin(a1);
    const ix0 = donutCx + donutInner * Math.cos(a0);
    const iy0 = donutCy + donutInner * Math.sin(a0);
    const ix1 = donutCx + donutInner * Math.cos(a1);
    const iy1 = donutCy + donutInner * Math.sin(a1);
    const large = a1 - a0 > Math.PI ? 1 : 0;
    const path = `M${x0},${y0} A${donutR},${donutR} 0 ${large} 1 ${x1},${y1} L${ix1},${iy1} A${donutInner},${donutInner} 0 ${large} 0 ${ix0},${iy0} Z`;
    return {
      path,
      color: d.color ?? "var(--color-accent)",
      label: d.label,
      value: d.value,
      pct: d.value / total,
    };
  });
}
const arcs = donutArcs();

// For bar annotations we need to know which indices carry an annotation.
const annotationMap = new Map<number, Annotation>();
for (const a of annotations) annotationMap.set(a.targetIndex, a);

const isInteractiveSvg = interactive && (isLineish || type === "scatter");
---

<figure
  class="chart-container"
  id={chartId}
  data-chart-type={type}
  data-chart
  data-chart-interactive={isInteractiveSvg ? "" : undefined}
>
  {story && <div class="chart-story">{story}</div>}

  {title && <span class="chart-title">{title}</span>}

  {seriesMode && (
    <div class="chart-legend" role="group" aria-label="Toggle series">
      {renderedSeries.map((s) => (
        <button type="button" class="chart-legend-btn" data-series-toggle={s.name} aria-pressed="true">
          <span class="chart-legend-swatch" style={`background: ${s.color}`} aria-hidden="true"></span>
          {s.name}
        </button>
      ))}
    </div>
  )}

  <div class="chart-body">
    {type === "bar" && (
      <div class="chart-bars">
        {data.map((item, i) => {
          const ann = annotationMap.get(i);
          const emphasize = ann?.emphasize ? true : false;
          return (
            <div class="chart-col" data-emphasize={emphasize ? "true" : undefined}>
              {ann && <div class="chart-bar-annotation">{ann.text}</div>}
              <div class="chart-tooltip" aria-hidden="true">
                <strong>{item.value}</strong>
                <span>{item.label}</span>
              </div>
              <div
                class="chart-bar"
                style={`--bar-height: ${(item.value / maxValue) * 100}%; --bar-color: ${item.color || "var(--color-accent)"}; --bar-delay: ${i * 0.08}s;`}
              ></div>
              <span class="chart-label">{item.label}</span>
            </div>
          );
        })}
      </div>
    )}

    {type === "horizontal" && (
      <div class="chart-rows">
        {data.map((item, i) => {
          const ann = annotationMap.get(i);
          return (
            <div class="chart-row" data-emphasize={ann?.emphasize ? "true" : undefined}>
              <span class="chart-row-label">{item.label}</span>
              <div class="chart-row-track">
                <div
                  class="chart-row-bar"
                  style={`--bar-width: ${(item.value / maxValue) * 100}%; --bar-color: ${item.color || "var(--color-accent)"}; --bar-delay: ${i * 0.1}s;`}
                ></div>
                {ann && <div class="chart-row-annotation">{ann.text}</div>}
              </div>
              <span class="chart-row-value">{item.value}</span>
            </div>
          );
        })}
      </div>
    )}

    {(isLineish || type === "scatter") && (
      <svg
        class="chart-svg"
        viewBox={`0 0 ${SVG_W} ${SVG_H}`}
        role="img"
        aria-label={story ?? title ?? "chart"}
        preserveAspectRatio="xMidYMid meet"
        data-pad-top={PAD.top}
        data-pad-bottom={PAD.bottom}
      >
        {/* Gridlines + y-tick labels */}
        {yTicks.map((t) => (
          <g class="chart-svg-grid">
            <line x1={PAD.left} y1={yPos(t)} x2={SVG_W - PAD.right} y2={yPos(t)} />
            <text x={PAD.left - 8} y={yPos(t) + 4} text-anchor="end">
              {formatTick(t)}
            </text>
          </g>
        ))}

        {/* X-axis labels: categories for line/area, numeric ticks for scatter */}
        {isLineish &&
          xLabels.map((label, i) => (
            <text class="chart-svg-xlabel" x={xs[i]} y={SVG_H - PAD.bottom + 22} text-anchor="middle">
              {label}
            </text>
          ))}
        {type === "scatter" &&
          scatterX &&
          scatterX.ticks.map((t) => (
            <text class="chart-svg-xlabel" x={scatterX(t)} y={SVG_H - PAD.bottom + 22} text-anchor="middle">
              {formatTick(t)}
            </text>
          ))}

        {/* Threshold reference lines */}
        {(isLineish || type === "scatter") &&
          thresholds.map((t) => (
            <g class="chart-svg-threshold">
              <line x1={PAD.left} y1={yPos(t.value)} x2={SVG_W - PAD.right} y2={yPos(t.value)} />
              {t.label && (
                <text x={SVG_W - PAD.right} y={yPos(t.value) - 6} text-anchor="end">
                  {t.label}
                </text>
              )}
            </g>
          ))}

        {/* Line / area series */}
        {isLineish &&
          renderedSeries.map((s, si) => (
            <g data-series-name={s.name} class="chart-series">
              {type === "area" && (
                <path class="chart-svg-area" d={s.areaPath} fill={s.color} fill-opacity="0.12" style="pointer-events: none" />
              )}
              <path
                class="chart-svg-line"
                d={s.linePath}
                fill="none"
                stroke={s.color}
                stroke-width="2.25"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              {s.dots.map((d, i) => {
                const ann = si === 0 ? annotationMap.get(i) : undefined;
                return (
                  <g>
                    <circle
                      class="chart-svg-dot"
                      data-pt
                      data-label={d.label}
                      data-value={d.value}
                      data-series={s.name || undefined}
                      cx={d.cx}
                      cy={d.cy}
                      r={ann?.emphasize ? 5.5 : 3.5}
                      fill={d.color}
                      stroke="var(--color-surface)"
                      stroke-width="2"
                    />
                    {ann && (
                      <g class="chart-svg-annotation">
                        <line
                          x1={d.cx}
                          y1={d.cy - 10}
                          x2={d.cx}
                          y2={Math.max(d.cy - 42, PAD.top + 6)}
                          stroke="var(--color-text-muted)"
                          stroke-dasharray="2 2"
                          stroke-width="1"
                        />
                        <text x={d.cx} y={Math.max(d.cy - 48, PAD.top + 2)} text-anchor="middle">
                          {ann.text}
                        </text>
                      </g>
                    )}
                  </g>
                );
              })}
            </g>
          ))}

        {/* Scatter points */}
        {type === "scatter" &&
          scatterX &&
          scatterY &&
          points.map((p) => (
            <circle
              class="chart-svg-dot chart-svg-scatter-dot"
              data-pt
              data-x={scatterX(p.x)}
              data-y={scatterY(p.y)}
              data-label={p.label ?? `${p.x}`}
              data-value={`${p.y}`}
              cx={scatterX(p.x)}
              cy={scatterY(p.y)}
              r="4.5"
              fill={p.color ?? "var(--color-accent)"}
              fill-opacity="0.85"
              stroke="var(--color-surface)"
              stroke-width="1.5"
            />
          ))}

        {yLabel && (
          <text class="chart-svg-axislabel" x={12} y={PAD.top + plotH / 2} transform={`rotate(-90 12 ${PAD.top + plotH / 2})`} text-anchor="middle">
            {yLabel}
          </text>
        )}
        {xLabel && (
          <text class="chart-svg-axislabel" x={PAD.left + plotW / 2} y={SVG_H - 6} text-anchor="middle">
            {xLabel}
          </text>
        )}
      </svg>
    )}

    {type === "donut" && (
      <div class="chart-donut">
        <svg class="chart-svg" viewBox={`0 0 ${SVG_W} ${SVG_H}`} role="img" aria-label={story ?? title ?? "chart"}>
          {arcs.map((a) => (
            <path class="chart-svg-arc" d={a.path} fill={a.color} />
          ))}
          <text class="chart-donut-total" x={donutCx} y={donutCy + 4} text-anchor="middle">
            {total}
          </text>
        </svg>
        <div class="chart-donut-legend">
          {arcs.map((a) => (
            <div class="chart-donut-legend-item">
              <span class="chart-donut-swatch" style={`background: ${a.color}`}></span>
              <span class="chart-donut-label">{a.label}</span>
              <span class="chart-donut-value">{a.value} · {(a.pct * 100).toFixed(0)}%</span>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>

  {source && <figcaption class="chart-source">{source}</figcaption>}
</figure>

<script>
  import { getGsap, onReducedMotion } from "../../lib/gsap";
  import { initChartInteractions } from "../../lib/chart/interact";

  function initCssAnimatedCharts() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("animate");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.3 },
    );
    document
      .querySelectorAll<HTMLElement>(
        '[data-chart][data-chart-type="bar"]:not(.animate), [data-chart][data-chart-type="horizontal"]:not(.animate)',
      )
      .forEach((el) => observer.observe(el));
  }

  async function initSvgCharts() {
    const nodes = document.querySelectorAll<HTMLElement>(
      '[data-chart][data-chart-type="line"]:not([data-chart-ready]), [data-chart][data-chart-type="area"]:not([data-chart-ready]), [data-chart][data-chart-type="donut"]:not([data-chart-ready]), [data-chart][data-chart-type="scatter"]:not([data-chart-ready])',
    );
    if (nodes.length === 0) return;

    if (onReducedMotion()) {
      for (const n of nodes) n.dataset.chartReady = "1";
      return;
    }

    const { gsap } = await getGsap();

    for (const node of nodes) {
      node.dataset.chartReady = "1";
      const type = node.dataset.chartType;

      if (type === "line" || type === "area") {
        const linePaths = node.querySelectorAll<SVGPathElement>(".chart-svg-line");
        const areaPaths = node.querySelectorAll<SVGPathElement>(".chart-svg-area");
        const dots = node.querySelectorAll<SVGCircleElement>(".chart-svg-dot");
        const annGroups = node.querySelectorAll<SVGGElement>(".chart-svg-annotation");

        linePaths.forEach((linePath, i) => {
          const len = linePath.getTotalLength();
          linePath.style.strokeDasharray = `${len}`;
          linePath.style.strokeDashoffset = `${len}`;
          gsap.to(linePath, {
            strokeDashoffset: 0,
            duration: 1.1,
            delay: i * 0.18,
            ease: "power2.out",
            scrollTrigger: { trigger: node, start: "top 80%", toggleActions: "play none none reverse" },
          });
        });
        areaPaths.forEach((areaPath, i) => {
          gsap.from(areaPath, {
            opacity: 0,
            duration: 1.1,
            delay: 0.2 + i * 0.18,
            ease: "power2.out",
            scrollTrigger: { trigger: node, start: "top 80%", toggleActions: "play none none reverse" },
          });
        });
        gsap.from(dots, {
          opacity: 0,
          scale: 0.4,
          transformOrigin: "center",
          duration: 0.4,
          stagger: 0.06,
          ease: "back.out(1.8)",
          delay: 0.8,
          scrollTrigger: { trigger: node, start: "top 80%", toggleActions: "play none none reverse" },
        });
        gsap.from(annGroups, {
          opacity: 0,
          y: -6,
          duration: 0.5,
          ease: "power2.out",
          stagger: 0.08,
          delay: 1.0,
          scrollTrigger: { trigger: node, start: "top 80%", toggleActions: "play none none reverse" },
        });
      } else if (type === "scatter") {
        const dots = node.querySelectorAll<SVGCircleElement>(".chart-svg-scatter-dot");
        gsap.from(dots, {
          opacity: 0,
          scale: 0.3,
          transformOrigin: "center",
          duration: 0.45,
          stagger: { each: 0.025, from: "random" },
          ease: "back.out(1.8)",
          scrollTrigger: { trigger: node, start: "top 80%", toggleActions: "play none none reverse" },
        });
      } else if (type === "donut") {
        const arcs = node.querySelectorAll<SVGPathElement>(".chart-svg-arc");
        gsap.from(arcs, {
          opacity: 0,
          scale: 0.7,
          transformOrigin: `${node.querySelector<SVGSVGElement>(".chart-svg")?.viewBox.baseVal.width! / 2}px 170px`,
          duration: 0.7,
          ease: "power2.out",
          stagger: 0.1,
          scrollTrigger: { trigger: node, start: "top 80%", toggleActions: "play none none reverse" },
        });
      }
    }
  }

  function initAll() {
    initCssAnimatedCharts();
    initSvgCharts();
    initChartInteractions();
  }

  initAll();
  document.addEventListener("astro:after-swap", initAll);
</script>

<style>
  .chart-container {
    margin: 2em 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-surface);
  }

  .chart-story {
    padding: 1.1rem 1.25rem 0.25rem;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    line-height: 1.3;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }

  .chart-title {
    display: block;
    padding: 0.55rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-muted);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
  }

  .chart-story + .chart-title {
    border-top: 1px solid var(--color-border);
  }

  .chart-body {
    padding: 1.5rem;
  }

  .chart-source {
    padding: 0 1.25rem 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
  }

  /* ---- Legend (multi-series) ---- */
  .chart-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0.85rem 1.25rem 0;
  }

  .chart-legend-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.3em 0.7em;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-smooth),
      border-color var(--duration-fast) var(--ease-smooth),
      opacity var(--duration-fast) var(--ease-smooth);
  }

  .chart-legend-btn:hover {
    border-color: var(--color-border-strong);
    color: var(--color-text);
  }

  .chart-legend-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .chart-legend-btn.legend-off {
    opacity: 0.45;
    text-decoration: line-through;
  }

  .chart-legend-swatch {
    width: 10px;
    height: 10px;
    border-radius: 3px;
  }

  /* ---- Vertical bars ---- */
  .chart-bars {
    display: flex;
    align-items: flex-end;
    gap: 1rem;
    height: clamp(150px, 30vw, 200px);
    padding-top: 2rem;
  }

  .chart-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    justify-content: flex-end;
    position: relative;
  }

  .chart-bar {
    width: 100%;
    max-width: 48px;
    height: 0;
    background: var(--bar-color);
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
