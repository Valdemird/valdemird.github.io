<!--
	Particles and the screen flash are spawned in JS with createElement, so they
	never receive Astro's component-scope attribute. Their rules must be global
	or the scoped selectors silently fail to match (the bug: un-rounded squares
	stacking in normal flow with no animation). Prefixed `jl-` to avoid leakage.
-->
<style is:global>
	.jl-particle {
		position: absolute;
		top: 0;
		left: 0;
		border-radius: 50%;
		pointer-events: none;
		will-change: transform, opacity;
		animation: jlParticle var(--dur, 0.7s) cubic-bezier(0.15, 0.6, 0.3, 1) forwards;
	}
	@keyframes jlParticle {
		0% { transform: translate(var(--x), var(--y)) scale(1); opacity: 1; }
		100% { transform: translate(calc(var(--x) + var(--dx)), calc(var(--y) + var(--dy))) scale(0.2); opacity: 0; }
	}
	.jl-flash {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: oklch(0.95 0.04 280);
		animation: jlFlash 0.4s ease-out forwards;
	}
	@keyframes jlFlash {
		0% { opacity: var(--a, 0.18); }
		100% { opacity: 0; }
	}
	@media (prefers-reduced-motion: reduce) {
		.jl-particle, .jl-flash { animation: none; opacity: 0; }
	}
</style>
