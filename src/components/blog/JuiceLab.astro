		25% { transform: translate(7px, -5px) rotate(0.5deg); }
		40% { transform: translate(-6px, 5px) rotate(-0.4deg); }
		55% { transform: translate(5px, -4px); }
		70% { transform: translate(-4px, 3px); }
		85% { transform: translate(2px, -2px); }
