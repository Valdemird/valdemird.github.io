---
/**
 * HeadingAnchors — makes every h2/h3 with an id inside `.article-body` a
 * self-link that copies the section URL. Rendered once by the blog and learn
 * layouts (like ReadingProgress); it upgrades headings client-side so it works
 * for both Astro-slugged markdown headings and explicit `<h2 id>` in MDX.
 *
 * The heading text itself becomes the link (`<h2><a href="#id">Title</a></h2>`),
 * so the heading's accessible name stays the title. The link icon is decorative
 * and only shows on hover or keyboard focus. Click → copies the absolute
 * section URL, updates the hash without a jump, and announces the copy through
 * a polite live region.
 *
 * Headings that already contain interactive content (a link, a glossary
 * tooltip button) are left alone: nesting interactive elements is invalid.
 */
interface Props {
	lang?: 'en' | 'es';
}
const { lang = 'en' } = Astro.props;
const labelCopied = lang === 'es' ? 'Enlace a la sección copiado' : 'Section link copied';
---

<span class="sr-only" role="status" data-heading-anchor-status data-copied={labelCopied}></span>

<script>
	const ICON = `<span class="heading-anchor__icon" aria-hidden="true"><svg class="heading-anchor__link" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg><svg class="heading-anchor__check" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>`;

	const INTERACTIVE = 'a, button, input, select, textarea, details, [tabindex], [role="button"]';

	function buildAnchors() {
		const headings = document.querySelectorAll<HTMLHeadingElement>(
			'.article-body h2[id], .article-body h3[id]',
		);

		headings.forEach((h) => {
			if (h.dataset.anchorReady) return;
			h.dataset.anchorReady = '1';
			if (h.querySelector(INTERACTIVE)) return;

			const a = document.createElement('a');
			a.className = 'heading-anchor';
			a.href = `#${h.id}`;
			while (h.firstChild) a.appendChild(h.firstChild);
			a.insertAdjacentHTML('beforeend', ICON);
			h.appendChild(a);
		});
	}

	async function onClick(event: MouseEvent) {
		if (event.button !== 0) return;
		if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
		const a = (event.target as Element | null)?.closest<HTMLAnchorElement>('a.heading-anchor');
		const h = a?.parentElement;
		if (!a || !h?.id) return;

		// Must stay synchronous (before the first await): the client router's own
		// click listener sees defaultPrevented and leaves this hash link alone,
		// so no history entry is pushed.
		event.preventDefault();
		const url = `${location.origin}${location.pathname}#${h.id}`;
		let copied = true;
		try {
			await navigator.clipboard.writeText(url);
		} catch {
			copied = false; // clipboard blocked: the hash still updates
		}
		history.replaceState(history.state, '', `#${h.id}`);
		h.scrollIntoView({ behavior: 'smooth', block: 'start' });
		if (!copied) return;

		a.classList.add('is-copied');
		const status = document.querySelector<HTMLElement>('[data-heading-anchor-status]');
		if (status) status.textContent = status.dataset.copied ?? '';
		window.setTimeout(() => {
			a.classList.remove('is-copied');
			if (status) status.textContent = '';
		}, 1600);
	}

	// One delegated click listener for the whole session (the document survives
	// View Transition swaps); headings are upgraded on every page load. It runs
	// in the capture phase so it fires before the client router's bubble-phase
	// document listener, which is registered earlier from <head> and would
	// otherwise turn the click into a navigation.
	const w = window as unknown as { __headingAnchorsBound?: boolean };
	if (!w.__headingAnchorsBound) {
		w.__headingAnchorsBound = true;
		document.addEventListener('click', onClick, { capture: true });
	}
	document.addEventListener('astro:page-load', buildAnchors);
</script>

<style is:global>
	/* Specificity beats the layouts' `.article-body a` underline rules. */
	.article-body h2 > a.heading-anchor,
	.article-body h3 > a.heading-anchor {
		color: inherit;
		text-decoration: none;
		border-radius: var(--radius-sm);
	}

	.heading-anchor__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.6rem;
		height: 1.6rem;
		margin-left: 0.4rem;
		vertical-align: middle;
		border-radius: var(--radius-sm);
		color: var(--color-text-muted);
		opacity: 0;
		transition:
			opacity var(--duration-fast) var(--ease-smooth),
			color var(--duration-fast) var(--ease-smooth),
			background var(--duration-fast) var(--ease-smooth);
	}

	/* Reveal on hover or keyboard focus of the heading link. */
	.heading-anchor:hover .heading-anchor__icon,
	.heading-anchor:focus-visible .heading-anchor__icon {
		opacity: 1;
		color: var(--color-accent);
		background: var(--color-accent-subtle);
	}

	.article-body h2 > a.heading-anchor:focus-visible,
	.article-body h3 > a.heading-anchor:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
	}

	.heading-anchor__check {
		display: none;
		color: var(--color-success-text, var(--color-success));
	}

	.heading-anchor.is-copied .heading-anchor__icon {
		opacity: 1;
		background: oklch(from var(--color-success) l c h / 0.12);
	}
	.heading-anchor.is-copied .heading-anchor__link {
		display: none;
	}
	.heading-anchor.is-copied .heading-anchor__check {
		display: block;
	}

	/* Touch devices have no hover — keep the icon faintly visible there. */
	@media (hover: none) {
		.heading-anchor__icon {
			opacity: 0.45;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.heading-anchor__icon {
			transition: none;
		}
	}
</style>
