---
/**
 * PullQuote — editorial pull quote with on-scroll entrance.
 *
 * <PullQuote cite="Anna Karlin, UW">
 *   A good benchmark is one that everyone wants to game. That means it
 *   actually measures something worth gaming.
 * </PullQuote>
 *
 * Editorial pattern: italic Fraunces at display size, framed by short
 * hairline rules above and below, em-dash attribution in mono. No
 * colored side bar — typography carries the emphasis.
 */
interface Props {
  /** Attribution — person, source, or title. */
  cite?: string;
  /** Layout — left-aligned (default, wider) or centered (compact). */
  variant?: "bar" | "block";
}
const { cite, variant = "bar" } = Astro.props;
---

<figure class="pullquote" data-variant={variant} data-pullquote>
  <blockquote class="pullquote-body">
    <slot />
  </blockquote>
  {cite && <figcaption class="pullquote-cite">— {cite}</figcaption>}
</figure>

<script>
  import { getGsap, onReducedMotion } from "../../lib/gsap";

  async function init() {
    const nodes = document.querySelectorAll<HTMLElement>("[data-pullquote]:not([data-pullquote-ready])");
    if (nodes.length === 0) return;

    if (onReducedMotion()) {
      for (const n of nodes) {
        n.dataset.pullquoteReady = "1";
        n.classList.add("is-visible");
      }
      return;
    }

    const { gsap } = await getGsap();

    for (const node of nodes) {
      node.dataset.pullquoteReady = "1";
      gsap.from(node, {
        opacity: 0,
        y: 20,
        duration: 0.8,
        ease: "power3.out",
        scrollTrigger: {
          trigger: node,
          start: "top 85%",
          toggleActions: "play none none reverse",
        },
      });
    }
  }

  init();
  document.addEventListener("astro:after-swap", init);
</script>

<style>
  .pullquote {
    margin: 3.5rem 0;
    padding: 0;
    position: relative;
    max-width: 38rem;
  }

  .pullquote[data-variant="block"] {
    text-align: center;
    max-width: 36rem;
    margin-left: auto;
    margin-right: auto;
  }

  .pullquote::before,
  .pullquote::after {
    content: "";
    display: block;
    width: 2.75rem;
    height: 1px;
    background: var(--color-accent);
    opacity: 0.55;
  }

  .pullquote::before { margin-bottom: 1.75rem; }
  .pullquote::after { margin-top: 1.75rem; }

  .pullquote[data-variant="block"]::before,
  .pullquote[data-variant="block"]::after {
    margin-left: auto;
    margin-right: auto;
  }

  .pullquote-body {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    line-height: 1.42;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }

  .pullquote-body :global(p) {
    margin: 0 0 0.75rem 0;
  }

  .pullquote-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .pullquote-cite {
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }
</style>
