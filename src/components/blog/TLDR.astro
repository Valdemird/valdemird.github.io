---
/**
 * TLDR — key takeaways rendered above the fold.
 *
 *   <TLDR bullets={[
 *     "Ship less, decide more.",
 *     "Components earn their place by teaching.",
 *     "Sidenotes beat footnotes for tangents.",
 *   ]} />
 *
 * Editorial pattern: mono eyebrow label, hairline rules top and bottom,
 * em-dash bullets. No colored side bar.
 */
interface Props {
	bullets: string[];
	title?: string;
	lang?: 'en' | 'es';
}
const { bullets, lang = 'en', title = lang === 'es' ? 'EN RESUMEN' : 'TL;DR' } = Astro.props;
---

<aside class="tldr" aria-label={title}>
	<div class="tldr-label">{title}</div>
	<ul class="tldr-list">
		{bullets.map((b) => <li>{b}</li>)}
	</ul>
</aside>

<style>
	.tldr {
		margin: 2.5rem 0 3rem;
		padding: 1.5rem 0 1.75rem;
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	.tldr-label {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--color-accent);
		margin-bottom: 1rem;
	}

	.tldr-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
	}

	.tldr-list li {
		position: relative;
		padding-left: 1.5rem;
		font-family: var(--font-sans);
		font-size: 1rem;
		line-height: 1.6;
		color: var(--color-text);
		margin-bottom: 0;
	}

	.tldr-list li::before {
		content: "—";
		position: absolute;
		left: 0;
		top: 0;
		color: var(--color-text-muted);
		font-weight: 300;
		letter-spacing: 0;
	}

	@media (max-width: 600px) {
		.tldr {
			padding: 1.25rem 0 1.4rem;
		}
		.tldr-list li {
			font-size: 0.95rem;
		}
	}
</style>
