---
/**
 * Comments — minimal Giscus embed.
 *
 * Comments live in a separate public repo (Valdemird/valdemird-comments).
 * The main valdemird.github.io repo stays private; only this discussion
 * repo is public. Giscus renders the matching Discussions thread inline
 * via its iframe.
 *
 * UX: collapsed by default. Visitor sees a single hairline label —
 *   "Discussion — see thread on GitHub →"
 * — and a button to load. The Giscus script only loads after the click,
 * keeping the page lean for the (likely) majority of readers who scroll
 * past without engaging.
 */

interface Props {
	lang?: 'en' | 'es';
	pathname: string;
}

const { lang = 'en', pathname } = Astro.props;

const labels = {
	en: {
		discussion: 'Discussion',
		cta: 'Load comments',
		hint: 'Comments are hosted on GitHub Discussions — sign in with GitHub to reply.',
		hosted: 'Powered by giscus',
	},
	es: {
		discussion: 'Conversación',
		cta: 'Cargar comentarios',
		hint: 'Los comentarios viven en GitHub Discussions — inicia sesión con GitHub para responder.',
		hosted: 'Vía giscus',
	},
}[lang];

// Hard-coded repo config (see the Comments section in CLAUDE.md). The values
// travel to the client as data attributes on the section.
const REPO = 'Valdemird/valdemird-comments';
const REPO_ID = 'R_kgDOSdgtKg';
const CATEGORY = 'Announcements';
const CATEGORY_ID = 'DIC_kwDOSdgtKs4C9DUf';
---

<section
	class="comments"
	data-comments
	aria-labelledby="comments-heading"
	data-pathname={pathname}
	data-repo={REPO}
	data-repo-id={REPO_ID}
	data-category={CATEGORY}
	data-category-id={CATEGORY_ID}
	data-lang={lang}
	data-hosted={labels.hosted}
>
	<header class="comments-head">
		<h2 id="comments-heading" class="comments-label">{labels.discussion}</h2>
		<button class="comments-load" type="button">{labels.cta}</button>
	</header>
	<p class="comments-hint">{labels.hint}</p>
	<div class="comments-mount" data-mount hidden></div>
</section>

<script>
	// Bundled module: it runs once per session, so every page-level hook below
	// is registered exactly once. Per-page state (listeners, the theme
	// observer) hangs off an AbortController that is aborted before each swap.
	let teardown: AbortController | null = null;

	const darkMq = window.matchMedia('(prefers-color-scheme: dark)');

	function getTheme(): 'dark' | 'light' {
		const explicit = document.documentElement.dataset.theme;
		if (explicit === 'dark' || explicit === 'light') return explicit;
		return darkMq.matches ? 'dark' : 'light';
	}

	function buildScript(root: HTMLElement, theme: string): HTMLScriptElement {
		const d = root.dataset;
		const s = document.createElement('script');
		s.src = 'https://giscus.app/client.js';
		s.async = true;
		s.crossOrigin = 'anonymous';
		s.dataset.repo = d.repo ?? '';
		s.dataset.repoId = d.repoId ?? '';
		s.dataset.category = d.category ?? '';
		s.dataset.categoryId = d.categoryId ?? '';
		s.dataset.mapping = 'pathname';
		s.dataset.strict = '1';
		s.dataset.reactionsEnabled = '1';
		s.dataset.emitMetadata = '0';
		s.dataset.inputPosition = 'bottom';
		s.dataset.theme = theme;
		s.dataset.lang = d.lang === 'es' ? 'es' : 'en';
		s.dataset.loading = 'lazy';
		return s;
	}

	function initComments() {
		const roots = document.querySelectorAll<HTMLElement>('.comments[data-comments]:not([data-c-ready])');
		if (!roots.length) return;

		teardown ??= new AbortController();
		const { signal } = teardown;

		roots.forEach((root) => {
			root.dataset.cReady = '1';
			const btn = root.querySelector<HTMLButtonElement>('.comments-load');
			const mount = root.querySelector<HTMLElement>('[data-mount]');
			if (!btn || !mount) return;

			const syncTheme = () => {
				if (mount.dataset.loaded !== '1') return;
				const iframe = mount.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
				iframe?.contentWindow?.postMessage({ giscus: { setConfig: { theme: getTheme() } } }, 'https://giscus.app');
			};

			btn.addEventListener(
				'click',
				() => {
					if (mount.dataset.loaded === '1') return;
					mount.dataset.loaded = '1';
					mount.hidden = false;
					root.classList.add('comments-open');
					btn.disabled = true;
					btn.textContent = root.dataset.hosted ?? '';
					mount.appendChild(buildScript(root, getTheme()));

					// Keep the giscus theme in sync if the visitor toggles dark mode
					// (or the OS flips) after loading. Only watched once loaded.
					const observer = new MutationObserver(syncTheme);
					observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
					signal.addEventListener('abort', () => observer.disconnect(), { once: true });
					darkMq.addEventListener('change', syncTheme, { signal });
				},
				{ signal },
			);
		});
	}

	initComments();
	document.addEventListener('astro:page-load', initComments);
	document.addEventListener('astro:before-swap', () => {
		teardown?.abort();
		teardown = null;
	});
</script>

<style>
	.comments {
		margin: var(--space-2xl) 0 0;
		padding-top: var(--space-lg);
		border-top: 1px solid var(--color-border);
	}

	.comments-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 0;
	}

	.comments-label {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.comments-load {
		padding: 0.45em 0.95em;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		background: var(--color-surface);
		font-family: var(--font-sans);
		font-size: 0.82rem;
		color: var(--color-text-secondary);
		cursor: pointer;
		transition:
			transform var(--duration-fast) var(--ease-spring),
			box-shadow var(--duration-fast) var(--ease-spring),
			border-color var(--duration-fast) var(--ease-smooth),
			background var(--duration-fast) var(--ease-smooth),
			color var(--duration-fast) var(--ease-smooth);
	}

	.comments-load:hover:not(:disabled),
	.comments-load:focus-visible:not(:disabled) {
		transform: translateY(-1px);
		box-shadow: var(--shadow-md);
		border-color: var(--color-accent);
		background: var(--color-accent-subtle);
		color: var(--color-text);
	}

	.comments-load:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
	}

	.comments-load:disabled {
		cursor: default;
		opacity: 0.55;
	}

	.comments-hint {
		margin: 0.6rem 0 0;
		font-family: var(--font-sans);
		font-size: 0.82rem;
		color: var(--color-text-muted);
		max-width: 38em;
	}

	.comments-mount {
		margin-top: var(--space-lg);
	}

	.comments-mount[hidden] {
		display: none;
	}
</style>
