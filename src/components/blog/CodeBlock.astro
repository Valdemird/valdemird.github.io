---
import { getLocale } from '../../consts';
interface Props {
	filename?: string;
}

const { filename } = Astro.props;
const es = getLocale(Astro.url) === 'es';
const copyAria = es ? 'Copiar el código' : 'Copy code';
const copiedText = es ? 'Código copiado' : 'Code copied';
const failedText = es ? 'No se pudo copiar' : 'Copy failed';
---

<div class="code-block" data-codeblock data-copied={copiedText} data-failed={failedText}>
	{filename && (
		<div class="code-header">
			<span class="code-filename">
				<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
					<polyline points="14 2 14 8 20 8"></polyline>
				</svg>
				{filename}
			</span>
			<button class="copy-btn" data-codeblock-copy type="button" aria-label={copyAria}>
				<svg class="icon-copy" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
					<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
				</svg>
				<svg class="icon-check" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<polyline points="20 6 9 17 4 12"></polyline>
				</svg>
			</button>
		</div>
	)}
	{!filename && (
		<button class="copy-btn copy-btn-float" data-codeblock-copy type="button" aria-label={copyAria}>
			<svg class="icon-copy" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
				<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
			</svg>
			<svg class="icon-check" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<polyline points="20 6 9 17 4 12"></polyline>
			</svg>
		</button>
	)}
	<div class="code-content">
		<slot />
	</div>
	<span class="sr-only" role="status" data-codeblock-status></span>
</div>

<script>
	// One delegated listener on the document. The document survives View
	// Transition swaps, so copy buttons on the next page work without rebinding,
	// and nothing piles up across navigations. The module runs once per session.
	async function copyText(text: string): Promise<boolean> {
		try {
			await navigator.clipboard.writeText(text);
			return true;
		} catch {
			// Clipboard API blocked (insecure context, permissions): fall back to
			// a hidden textarea selection.
			const ta = document.createElement('textarea');
			ta.value = text;
			ta.setAttribute('readonly', '');
			ta.style.position = 'fixed';
			ta.style.opacity = '0';
			document.body.appendChild(ta);
			ta.select();
			let ok = false;
			try {
				// Legacy API on purpose: the only copy path left when the Clipboard API is blocked.
				ok = (document as unknown as { execCommand(cmd: string): boolean }).execCommand('copy');
			} catch {
				ok = false;
			}
			ta.remove();
			return ok;
		}
	}

	if (!(window as unknown as { __codeBlockCopy?: boolean }).__codeBlockCopy) {
		(window as unknown as { __codeBlockCopy?: boolean }).__codeBlockCopy = true;
		document.addEventListener('click', async (event) => {
			const btn = (event.target as Element | null)?.closest<HTMLButtonElement>('[data-codeblock-copy]');
			if (!btn) return;
			const block = btn.closest<HTMLElement>('[data-codeblock]');
			if (!block) return;
			const code = block.querySelector('pre code')?.textContent || block.querySelector('pre')?.textContent || '';
			const status = block.querySelector<HTMLElement>('[data-codeblock-status]');
			const ok = await copyText(code.trim());

			if (status) {
				status.textContent = ok ? (block.dataset.copied ?? 'Copied') : (block.dataset.failed ?? 'Copy failed');
			}
			if (ok) btn.classList.add('copied');
			window.setTimeout(() => {
				btn.classList.remove('copied');
				if (status) status.textContent = '';
			}, 2000);
		});
	}
</script>

<style>
	.code-block {
		position: relative;
		margin: 1.75em 0;
		border-radius: var(--radius-md);
		border: 1px solid var(--color-border);
		overflow: hidden;
		background: var(--color-bg-secondary);
	}

	.code-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.5em 1em;
		background: var(--color-surface);
		border-bottom: 1px solid var(--color-border);
	}

	.code-filename {
		display: flex;
		align-items: center;
		gap: 0.4em;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--color-text-muted);
	}

	.copy-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		padding: 0;
		border: none;
		background: transparent;
		color: var(--color-text-muted);
		cursor: pointer;
		border-radius: var(--radius-sm);
		transition: color var(--duration-fast) var(--ease-smooth),
			background var(--duration-fast) var(--ease-smooth);
	}

	.copy-btn:hover {
		color: var(--color-text);
		background: var(--color-accent-subtle);
	}

	.copy-btn-float {
		position: absolute;
		top: 0.5em;
		right: 0.5em;
		opacity: 0;
		transition: opacity var(--duration-fast) var(--ease-smooth),
			color var(--duration-fast) var(--ease-smooth),
			background var(--duration-fast) var(--ease-smooth);
	}

	/* Visible on hover, whenever keyboard focus is inside the block, and
	   always on touch screens (no hover to reveal it there). */
	.code-block:hover .copy-btn-float,
	.code-block:focus-within .copy-btn-float,
	.copy-btn-float:focus-visible {
		opacity: 1;
	}

	@media (hover: none) {
		.copy-btn-float {
			opacity: 1;
			background: oklch(from var(--color-surface) l c h / 0.85);
		}
	}

	.copy-btn:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
		color: var(--color-text);
	}

	.icon-check { display: none; }
	.copy-btn.copied .icon-copy { display: none; }
	.copy-btn.copied .icon-check { display: block; color: var(--color-success-text, var(--color-success)); }

	.code-content :global(pre) {
		margin: 0;
		border: none;
		border-radius: 0;
	}
</style>
