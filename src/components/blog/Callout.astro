---
import { getLocale } from '../../consts';

interface Props {
	type?: 'tip' | 'warning' | 'note' | 'important';
	title?: string;
	/** Eyebrow language. Defaults to the page locale, so ES posts localize for free. */
	lang?: 'en' | 'es';
}

const { type = 'note', title, lang = getLocale(Astro.url) } = Astro.props;

const LABELS: Record<'en' | 'es', Record<string, string>> = {
	en: { tip: 'Tip', warning: 'Warning', note: 'Note', important: 'Important' },
	es: { tip: 'Consejo', warning: 'Cuidado', note: 'Nota', important: 'Importante' },
};
const labels = LABELS[lang];
---

<aside class:list={['callout', `callout-${type}`]} role="note">
	<div class="callout-eyebrow">
		<span class="callout-label">{labels[type]}</span>
	</div>
	{title && <div class="callout-title">{title}</div>}
	<div class="callout-content">
		<slot />
	</div>
</aside>

<style>
	/* --callout-accent tints the wash; --callout-ink is the eyebrow text color,
	   the darker *-text token so the small mono label clears 4.5:1. The label is
	   the only category marker: no emoji, no left bar. */
	.callout {
		--callout-accent: var(--color-accent);
		--callout-ink: var(--color-accent-hover);
		margin: 2.5em 0;
		padding: 1.35em 1.6em 1.45em;
		border-radius: var(--radius-md);
		background: oklch(from var(--callout-accent) l c h / 0.045);
	}

	.callout-tip {
		--callout-accent: var(--color-success);
		--callout-ink: var(--color-success-text, var(--color-success));
	}
	.callout-warning {
		--callout-accent: var(--color-warning);
		--callout-ink: var(--color-warning-text, var(--color-warning));
	}
	.callout-note {
		--callout-accent: var(--color-accent);
		--callout-ink: var(--color-accent-hover);
	}
	.callout-important {
		--callout-accent: var(--color-important, oklch(0.62 0.18 300));
		--callout-ink: var(--color-important-text, var(--callout-accent));
	}

	:global([data-theme='dark']) .callout {
		background: oklch(from var(--callout-accent) l c h / 0.085);
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .callout {
			background: oklch(from var(--callout-accent) l c h / 0.085);
		}
	}

	.callout-eyebrow {
		display: flex;
		align-items: center;
		gap: 0.55em;
		margin-bottom: 0.55em;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--callout-ink);
	}

	.callout-title {
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 1rem;
		color: var(--color-text);
		margin-bottom: 0.4em;
		letter-spacing: -0.005em;
	}

	.callout-content {
		font-size: 0.95rem;
		line-height: 1.65;
		color: var(--color-text-secondary);
	}

	.callout-content :global(p) {
		margin: 0;
	}

	.callout-content :global(p + p) {
		margin-top: 0.6em;
	}

	.callout-content :global(code) {
		font-size: 0.88em;
	}
</style>
