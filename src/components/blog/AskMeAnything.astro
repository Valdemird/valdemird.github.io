---
/**
 * AskMeAnything — site-wide floating button (bottom-right) that opens a
 * compact frosted-glass panel. The default tab everywhere is the contact form
 * that emails Sebastian (Web3Forms, works in every browser); a second tab
 * hosts an on-device AI chat (Chrome Prompt API / Gemini Nano) that only
 * becomes reachable once feature detection confirms the local model.
 *
 * Progressive enhancement: every AI affordance only appears after runtime
 * feature detection succeeds. Firefox/Safari/mobile visitors get a plain
 * contact widget — no tabs, no chat, no AI mention. On blog posts the chat
 * reads the rendered article and can summarize it; the same on-device model
 * powers an "improve writing" pass on the email draft (only offered once the
 * model is already on disk). Nothing the visitor types leaves the browser
 * unless they explicitly submit the form.
 *
 *   <AskMeAnything lang="en" />            site-wide widget (mounted in Footer)
 *   <AskMeAnything lang="en" floating={false} />   panel rendered inline (lab demo)
 */
import { AMA_STRINGS, WEB3FORMS_ACCESS_KEY } from '../../data/ask-me-anything';
import type { AboutLocale } from '../../data/about';

interface Props {
	lang?: AboutLocale;
	/** true (default) mounts the fixed button + popover; false renders the panel inline. */
	floating?: boolean;
}

const { lang = 'en', floating = true } = Astro.props;
const L = AMA_STRINGS[lang];
// One floating + one inline instance can share a page (the lab demo), so ids
// need more than the lang to stay unique.
const uid = `${lang}-${floating ? 'float' : 'inline'}`;

// Only what the widget needs before anyone talks to the model. The prompts
// (several KB) live in /ama-config.json (src/pages/ama-config.json.ts) and are
// fetched only in browsers that expose the on-device model.
const config = {
	lang,
	accessKey: WEB3FORMS_ACCESS_KEY,
	i18n: {
		downloading: L.downloading,
		thinking: L.thinking,
		you: L.you,
		assistant: L.assistant,
		fabContact: L.fabContact,
		titleContact: L.titleContact,
		quotaNote: L.quotaNote,
		quotaFull: L.quotaFull,
		chatError: L.chatError,
		intentNudge: L.intentNudge,
		formSending: L.formSending,
		formSent: L.formSent,
		formError: L.formError,
		formCooldown: L.formCooldown,
		formImproving: L.formImproving,
		formImproveError: L.formImproveError,
	},
};
---

<div class:list={['ama', floating ? 'ama-floating' : 'ama-inline']} data-ama data-state="boot">
	{floating && (
		<button type="button" class="ama-fab" data-ama-toggle aria-expanded="false" aria-controls={`ama-panel-${uid}`}>
			<svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
				<path d="M12 7.5l.94 2.06L15 10.5l-2.06.94L12 13.5l-.94-2.06L9 10.5l2.06-.94L12 7.5z" fill="currentColor" stroke="none" />
			</svg>
			<span class="ama-fab-label" data-ama-fab-label>{L.fabLabel}</span>
		</button>
	)}

	<div
		class="ama-panel"
		id={`ama-panel-${uid}`}
		role={floating ? 'dialog' : undefined}
		aria-label={L.panelTitle}
		tabindex="-1"
		data-ama-panel
		hidden={floating}
	>
		<header class="ama-head">
			<span class="ama-head-title" data-ama-title>{L.panelTitle}</span>
			{floating && (
				<button type="button" class="ama-close" data-ama-close aria-label={L.close}>
					<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
						<path d="M18 6 6 18M6 6l12 12" />
					</svg>
				</button>
			)}
		</header>

		<!-- Email is the product and the default everywhere; the chat tab is only
		     reachable once feature detection has confirmed the local model. -->
		<div class="ama-tabs" role="tablist" aria-label={L.panelTitle}>
			<button type="button" class="ama-tab" role="tab" id={`ama-tab-form-${uid}`} aria-selected="true" aria-controls={`ama-pane-form-${uid}`} data-ama-tab="form">{L.tabMessage}</button>
			<button type="button" class="ama-tab" role="tab" id={`ama-tab-chat-${uid}`} aria-selected="false" aria-controls={`ama-pane-chat-${uid}`} data-ama-tab="chat">{L.tabChat}</button>
		</div>

		<section class="ama-pane" id={`ama-pane-chat-${uid}`} role="tabpanel" aria-labelledby={`ama-tab-chat-${uid}`} data-ama-pane="chat" hidden>
			<div class="ama-gate" data-ama-gate>
				<p class="ama-gate-title">{L.gateTitle}</p>
				<p class="ama-gate-body">{L.gateBody}</p>
				<button type="button" class="ama-btn ama-btn-primary" data-ama-enable>{L.gateButton}</button>
				<div class="ama-progress-row" data-ama-progress-row hidden>
					<div class="ama-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-ama-progress>
						<div class="ama-progress-fill" data-ama-progress-fill></div>
					</div>
					<span class="ama-progress-label" data-ama-progress-label>{L.downloading}</span>
				</div>
			</div>

			<div class="ama-conv">
				<div class="ama-log" data-ama-log role="log" aria-live="polite"></div>
				<div class="ama-suggested" data-ama-suggested>
					<button type="button" class="ama-chip" data-ama-chip data-ama-article-chip hidden>{L.chipArticle}</button>
					{L.suggested.map((q) => (
						<button type="button" class="ama-chip" data-ama-chip>{q}</button>
					))}
				</div>
				<form class="ama-input" data-ama-input>
					<label class="ama-sr" for={`ama-q-${uid}`}>{L.inputLabel}</label>
					<input id={`ama-q-${uid}`} type="text" name="q" autocomplete="off" maxlength="400" placeholder={L.inputPlaceholder} data-ama-field />
					<button type="submit" class="ama-send" data-ama-send aria-label={L.send}>
						<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M12 19V5M5 12l7-7 7 7" />
						</svg>
					</button>
				</form>
				<p class="ama-quota" data-ama-quota hidden></p>
				<p class="ama-reset-row" data-ama-reset-row hidden>
					<button type="button" class="ama-btn" data-ama-reset>{L.resetButton}</button>
				</p>
				<p class="ama-privacy">{L.privacyChat}</p>
			</div>

			<div class="ama-error">
				<p>{L.chatError}</p>
				<button type="button" class="ama-btn" data-ama-retry>{L.retry}</button>
			</div>
		</section>

		<section class="ama-pane" id={`ama-pane-form-${uid}`} role="tabpanel" aria-labelledby={`ama-tab-form-${uid}`} data-ama-pane="form">
			<form class="ama-form" data-ama-form>
				<input type="checkbox" name="botcheck" class="ama-hp" tabindex="-1" aria-hidden="true" data-ama-botcheck />
				<div class="ama-form-row">
					<label class="ama-label" for={`ama-email-${uid}`}>{L.formEmailLabel}</label>
					<input id={`ama-email-${uid}`} type="email" name="email" required placeholder={L.formEmailPlaceholder} data-ama-email />
				</div>
				<div class="ama-form-row">
					<label class="ama-label" for={`ama-msg-${uid}`}>{L.formMessageLabel}</label>
					<textarea id={`ama-msg-${uid}`} name="message" required rows="4" maxlength="4000" placeholder={L.formMessagePlaceholder} data-ama-message></textarea>
				</div>
				<div class="ama-improve-row" data-ama-improve-row hidden>
					<button type="button" class="ama-btn" data-ama-improve disabled>{L.formImprove}</button>
					<button type="button" class="ama-btn" data-ama-improve-undo hidden>{L.formImproveUndo}</button>
				</div>
				<label class="ama-attach" data-ama-attach-row hidden>
					<input type="checkbox" data-ama-attach checked />
					<span data-ama-attach-label>{L.formAttach}</span>
				</label>
				<div class="ama-form-actions">
					<button type="submit" class="ama-btn ama-btn-primary" data-ama-submit>{L.formSubmit}</button>
					<span class="ama-form-status" role="status" aria-live="polite" data-ama-form-status></span>
				</div>
				<p class="ama-privacy">{L.formPrivacy}</p>
			</form>
		</section>
	</div>

	<script type="application/json" data-ama-config set:html={JSON.stringify(config)} />
</div>

<script>
	interface AmaConfig {
		lang: 'en' | 'es';
		accessKey: string;
		i18n: Record<string, string>;
	}

	interface AmaPrompts {
		systemPrompt: string;
		articlePrompt: string;
		improvePrompt: string;
		keywords: string[];
	}

	// Prompts are fetched once, and only by browsers with the on-device model.
	let promptsPromise: Promise<Record<string, AmaPrompts>> | null = null;
	async function loadPrompts(lang: 'en' | 'es'): Promise<AmaPrompts> {
		promptsPromise ??= fetch('/ama-config.json').then((res) => {
			if (!res.ok) throw new Error(String(res.status));
			return res.json() as Promise<Record<string, AmaPrompts>>;
		});
		try {
			const all = await promptsPromise;
			const prompts = all[lang] ?? all.en;
			if (!prompts) throw new Error('missing prompts');
			return prompts;
		} catch (err) {
			promptsPromise = null; // let a retry fetch again
			throw err;
		}
	}

	type AmaState = 'boot' | 'unsupported' | 'gate' | 'downloading' | 'ready' | 'streaming' | 'error';

	// Sessions and in-flight streams are module-scoped so a single pair of
	// listeners can tear everything down before a View Transition swap.
	const sessions = new Set<LanguageModelSession>();
	const aborters = new Set<AbortController>();

	// Window-level listeners of the current page's widget (scroll hide).
	let pageListeners: AbortController | null = null;

	// Opens the floating widget on a given tab; set by the page's floating
	// instance. Any element with data-ama-open="form" (or "chat") anywhere on
	// the page triggers it, e.g. a "write to me" link in prose.
	let openFloating: ((tab: string) => void) | null = null;
	document.addEventListener('click', (e) => {
		const trigger = (e.target as Element | null)?.closest?.<HTMLElement>('[data-ama-open]');
		if (!trigger || !openFloating) return;
		e.preventDefault();
		openFloating(trigger.dataset.amaOpen || 'form');
	});

	function destroyAllSessions() {
		aborters.forEach((a) => a.abort());
		aborters.clear();
		sessions.forEach((s) => {
			try {
				s.destroy();
			} catch {
				/* already gone */
			}
		});
		sessions.clear();
	}
	// Before a View Transition swap the widget's DOM goes away, so its
	// window-level hooks go with it. pagehide only frees the model sessions:
	// a page restored from the back/forward cache keeps its listeners.
	document.addEventListener('astro:before-swap', () => {
		openFloating = null;
		pageListeners?.abort();
		pageListeners = null;
		destroyAllSessions();
	});
	window.addEventListener('pagehide', destroyAllSessions);

	/** Title + trimmed text of the blog post being read, if any. */
	function articleContext(): { title: string; text: string } | null {
		const prose = document.querySelector('article .prose');
		if (!prose?.textContent) return null;
		const title = (document.querySelector('article h1')?.textContent ?? document.title).trim();
		const text = prose.textContent.replace(/\s+/g, ' ').trim().slice(0, 7000);
		return text ? { title, text } : null;
	}

	function setup(root: HTMLElement) {
		const config = JSON.parse(root.querySelector('[data-ama-config]')?.textContent ?? '{}') as AmaConfig;
		const i18n = config.i18n ?? {};
		const floating = root.classList.contains('ama-floating');
		const article = articleContext();

		const panel = root.querySelector<HTMLElement>('[data-ama-panel]')!;
		const log = root.querySelector<HTMLElement>('[data-ama-log]')!;
		const field = root.querySelector<HTMLInputElement>('[data-ama-field]')!;
		const sendBtn = root.querySelector<HTMLButtonElement>('[data-ama-send]')!;
		const quotaEl = root.querySelector<HTMLElement>('[data-ama-quota]')!;
		const resetRow = root.querySelector<HTMLElement>('[data-ama-reset-row]')!;
		const progressRow = root.querySelector<HTMLElement>('[data-ama-progress-row]')!;
		const progressBar = root.querySelector<HTMLElement>('[data-ama-progress]')!;
		const progressFill = root.querySelector<HTMLElement>('[data-ama-progress-fill]')!;
		const enableBtn = root.querySelector<HTMLButtonElement>('[data-ama-enable]')!;
		const attachRow = root.querySelector<HTMLElement>('[data-ama-attach-row]')!;
		const improveRow = root.querySelector<HTMLElement>('[data-ama-improve-row]')!;

		let session: LanguageModelSession | null = null;
		let transcript: { role: string; text: string }[] = [];
		let nudged = false;

		const setState = (s: AmaState) => {
			root.dataset.state = s;
		};

		// --- floating open/close ---
		const fab = root.querySelector<HTMLButtonElement>('[data-ama-toggle]');
		let isOpen = false;
		let closeTimer = 0;

		function setOpen(next: boolean) {
			if (!fab || next === isOpen) return;
			isOpen = next;
			root.classList.remove('ama-fab-away');
			fab.setAttribute('aria-expanded', String(next));
			window.clearTimeout(closeTimer);
			if (next) {
				panel.hidden = false;
				requestAnimationFrame(() => panel.classList.add('ama-open'));
				panel.focus({ preventScroll: true });
			} else {
				panel.classList.remove('ama-open');
				closeTimer = window.setTimeout(() => {
					panel.hidden = true;
				}, 250);
				fab.focus({ preventScroll: true });
			}
		}

		fab?.addEventListener('click', () => setOpen(!isOpen));
		root.querySelector('[data-ama-close]')?.addEventListener('click', () => setOpen(false));
		if (floating) {
			panel.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') setOpen(false);
			});
		}

		// --- compact FAB on phones: tuck it away while reading downward ---
		// The button sits over body text on narrow screens, so it slides out on
		// scroll-down and comes back on scroll-up, on focus, or when opened.
		if (floating && fab) {
			pageListeners ??= new AbortController();
			const { signal } = pageListeners;
			const compact = window.matchMedia('(max-width: 640px)');
			const setAway = (away: boolean) => root.classList.toggle('ama-fab-away', away);
			let lastY = window.scrollY;
			let frame = 0;
			window.addEventListener(
				'scroll',
				() => {
					if (frame) return;
					frame = requestAnimationFrame(() => {
						frame = 0;
						const y = window.scrollY;
						if (!compact.matches || isOpen) {
							setAway(false);
							lastY = y;
							return;
						}
						const dy = y - lastY;
						if (Math.abs(dy) < 8) return;
						setAway(dy > 0 && y > 80);
						lastY = y;
					});
				},
				{ passive: true, signal },
			);
			fab.addEventListener('focus', () => setAway(false), { signal });
			compact.addEventListener('change', () => setAway(false), { signal });
		}

		// --- tabs ---
		const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-ama-tab]'));
		const panes = Array.from(root.querySelectorAll<HTMLElement>('[data-ama-pane]'));
		const formTab = tabs.find((t) => t.dataset.amaTab === 'form');

		function selectTab(name: string) {
			tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.amaTab === name)));
			panes.forEach((p) => {
				p.hidden = p.dataset.amaPane !== name;
			});
			if (name === 'form') formTab?.classList.remove('ama-tab-pulse');
		}
		tabs.forEach((t) => t.addEventListener('click', () => selectTab(t.dataset.amaTab!)));

		if (floating && fab) {
			openFloating = (tab) => {
				// The chat tab only exists once the local model is confirmed.
				const chatReady = !['boot', 'unsupported'].includes(root.dataset.state ?? '');
				selectTab(tab === 'chat' && chatReady ? 'chat' : 'form');
				setOpen(true);
				if (tab !== 'chat' || !chatReady) {
					root.querySelector<HTMLInputElement>('[data-ama-email]')?.focus({ preventScroll: true });
				}
			};
		}

		const articleChip = root.querySelector<HTMLButtonElement>('[data-ama-article-chip]');
		if (articleChip && article) articleChip.hidden = false;

		const bubble = (kind: 'user' | 'ai' | 'system', text: string): HTMLElement => {
			const el = document.createElement('div');
			el.className = `ama-msg ama-msg-${kind}`;
			if (kind !== 'system') {
				// Visually the bubble shape carries the sender; keep a label for screen readers.
				const who = document.createElement('span');
				who.className = 'ama-sr';
				who.textContent = `${kind === 'user' ? (i18n.you ?? 'You') : (i18n.assistant ?? 'AI')}: `;
				el.appendChild(who);
			}
			const body = document.createElement('p');
			body.className = 'ama-msg-body';
			body.textContent = text;
			el.appendChild(body);
			log.appendChild(el);
			log.scrollTop = log.scrollHeight;
			return body;
		};

		// No local model → no AI anywhere: the widget collapses into a plain
		// contact form (no tabs, no chat, no AI mention) and relabels itself.
		function enterContactOnly() {
			setState('unsupported');
			selectTab('form');
			const fabLabel = root.querySelector<HTMLElement>('[data-ama-fab-label]');
			if (fabLabel && i18n.fabContact) fabLabel.textContent = i18n.fabContact;
			const title = root.querySelector<HTMLElement>('[data-ama-title]');
			if (title && i18n.titleContact) {
				title.textContent = i18n.titleContact;
				panel.setAttribute('aria-label', i18n.titleContact);
			}
		}

		async function boot() {
			if (typeof LanguageModel === 'undefined') {
				enterContactOnly();
				return;
			}
			try {
				const availability = await LanguageModel.availability();
				// A model is (or can be) here: warm the prompts in the background.
				if (availability !== 'unavailable') loadPrompts(config.lang).catch(() => {});
				if (availability === 'unavailable') enterContactOnly();
				else if (availability === 'available') {
					setState('ready');
					improveRow.hidden = false;
				} else setState('gate');
			} catch {
				enterContactOnly();
			}
		}

		async function ensureSession(): Promise<LanguageModelSession> {
			if (session) return session;
			const controller = new AbortController();
			aborters.add(controller);
			try {
				const prompts = await loadPrompts(config.lang);
				const systemPrompt =
					prompts.systemPrompt +
					(article ? (prompts.articlePrompt ?? '').replace('{title}', article.title).replace('{text}', article.text) : '');
				session = await LanguageModel!.create({
					initialPrompts: [{ role: 'system', content: systemPrompt }],
					signal: controller.signal,
					monitor(m) {
						m.addEventListener('downloadprogress', (e) => {
							const pct = Math.round((e.loaded ?? 0) * 100);
							progressRow.hidden = false;
							progressBar.setAttribute('aria-valuenow', String(pct));
							progressFill.style.width = `${pct}%`;
						});
					},
				});
				sessions.add(session);
				// The model just proved it is on disk, so the email tab can
				// offer the rewrite pass too.
				improveRow.hidden = false;
				return session;
			} finally {
				aborters.delete(controller);
			}
		}

		function updateQuota() {
			if (!session || typeof session.inputUsage !== 'number' || typeof session.inputQuota !== 'number' || !session.inputQuota) {
				return;
			}
			const pct = Math.round((session.inputUsage / session.inputQuota) * 100);
			if (pct >= 90) {
				quotaEl.hidden = false;
				quotaEl.textContent = i18n.quotaFull ?? '';
				resetRow.hidden = false;
				field.disabled = true;
				sendBtn.disabled = true;
			} else if (pct >= 60) {
				quotaEl.hidden = false;
				quotaEl.textContent = (i18n.quotaNote ?? '{pct}%').replace('{pct}', String(pct));
			} else {
				quotaEl.hidden = true;
			}
		}

		function updateAttachRow() {
			attachRow.hidden = transcript.length === 0;
		}

		async function send(text: string) {
			const q = text.trim();
			if (!q || root.dataset.state === 'streaming') return;
			field.value = '';
			bubble('user', q);
			transcript.push({ role: config.lang === 'es' ? 'Visitante' : 'Visitor', text: q });
			setState('streaming');
			sendBtn.disabled = true;
			const body = bubble('ai', i18n.thinking ?? '…');
			const controller = new AbortController();
			aborters.add(controller);
			try {
				const s = await ensureSession();
				const { keywords } = await loadPrompts(config.lang);
				const wantsContact = keywords.some((k) => q.toLowerCase().includes(k));
				let acc = '';
				for await (const chunk of s.promptStreaming(q, { signal: controller.signal })) {
					// Older builds stream the cumulative text, newer ones stream deltas.
					if (chunk.length >= acc.length && chunk.startsWith(acc)) acc = chunk;
					else acc += chunk;
					body.textContent = acc;
					log.scrollTop = log.scrollHeight;
				}
				transcript.push({ role: 'AI', text: acc });
				updateQuota();
				if (wantsContact && !nudged) {
					nudged = true;
					bubble('system', i18n.intentNudge ?? '');
					formTab?.classList.add('ama-tab-pulse');
				}
				setState('ready');
			} catch (err) {
				if (!controller.signal.aborted) {
					body.textContent = i18n.chatError ?? 'Error.';
					setState('ready');
				}
			} finally {
				aborters.delete(controller);
				sendBtn.disabled = field.disabled;
				updateAttachRow();
			}
		}

		enableBtn.addEventListener('click', async () => {
			enableBtn.disabled = true;
			setState('downloading');
			try {
				await ensureSession();
				setState('ready');
			} catch {
				setState('error');
			} finally {
				enableBtn.disabled = false;
			}
		});

		root.querySelector('[data-ama-retry]')?.addEventListener('click', () => {
			setState('boot');
			boot();
		});

		root.querySelector('[data-ama-reset]')?.addEventListener('click', () => {
			if (session) {
				sessions.delete(session);
				try {
					session.destroy();
				} catch {
					/* noop */
				}
				session = null;
			}
			quotaEl.hidden = true;
			resetRow.hidden = true;
			field.disabled = false;
			sendBtn.disabled = false;
		});

		root.querySelector('[data-ama-input]')?.addEventListener('submit', (e) => {
			e.preventDefault();
			send(field.value);
		});

		root.querySelectorAll<HTMLButtonElement>('[data-ama-chip]').forEach((chip) => {
			chip.addEventListener('click', () => send(chip.textContent ?? ''));
		});

		// --- Contact form (works regardless of AI support) ---
		const form = root.querySelector<HTMLFormElement>('[data-ama-form]')!;
		const status = root.querySelector<HTMLElement>('[data-ama-form-status]')!;
		const submitBtn = root.querySelector<HTMLButtonElement>('[data-ama-submit]')!;
		const COOLDOWN_MS = 60_000;

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const last = Number(localStorage.getItem('ama-last-send') ?? 0);
			const elapsed = Date.now() - last;
			if (elapsed < COOLDOWN_MS) {
				status.textContent = (i18n.formCooldown ?? '{s}s').replace('{s}', String(Math.ceil((COOLDOWN_MS - elapsed) / 1000)));
				return;
			}
			if (!config.accessKey || config.accessKey.startsWith('REPLACE_')) {
				status.textContent = i18n.formError ?? 'Error.';
				return;
			}
			const email = root.querySelector<HTMLInputElement>('[data-ama-email]')!.value;
			const message = root.querySelector<HTMLTextAreaElement>('[data-ama-message]')!.value;
			const attach = root.querySelector<HTMLInputElement>('[data-ama-attach]')!.checked && !attachRow.hidden;
			const payload: Record<string, unknown> = {
				access_key: config.accessKey,
				subject: `valdemird.com — message from ${email}`,
				from_name: 'valdemird.com AMA',
				email,
				message,
				lang: config.lang,
				page: location.pathname,
				botcheck: root.querySelector<HTMLInputElement>('[data-ama-botcheck]')!.checked,
			};
			if (attach) {
				payload.transcript = transcript
					.map((m) => `${m.role}: ${m.text}`)
					.join('\n')
					.slice(0, 4000);
			}
			submitBtn.disabled = true;
			status.textContent = i18n.formSending ?? '…';
			try {
				const res = await fetch('https://api.web3forms.com/submit', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
					body: JSON.stringify(payload),
				});
				if (!res.ok) throw new Error(String(res.status));
				status.textContent = i18n.formSent ?? 'Sent.';
				localStorage.setItem('ama-last-send', String(Date.now()));
				form.reset();
			} catch {
				status.textContent = i18n.formError ?? 'Error.';
			} finally {
				submitBtn.disabled = false;
			}
		});

		// --- "Improve writing" (same on-device model; the row is only revealed
		// once the model is known to be on disk, so this never triggers the
		// multi-GB download from the email tab) ---
		const msgField = root.querySelector<HTMLTextAreaElement>('[data-ama-message]')!;
		const improveBtn = root.querySelector<HTMLButtonElement>('[data-ama-improve]')!;
		const undoBtn = root.querySelector<HTMLButtonElement>('[data-ama-improve-undo]')!;
		let improving = false;
		let lastDraft = '';

		// Programmatic .value changes don't fire 'input', so this only reacts
		// to the visitor's own edits — which also invalidate the undo snapshot.
		msgField.addEventListener('input', () => {
			improveBtn.disabled = improving || !msgField.value.trim();
			undoBtn.hidden = true;
		});

		undoBtn.addEventListener('click', () => {
			msgField.value = lastDraft;
			undoBtn.hidden = true;
			improveBtn.disabled = !msgField.value.trim();
		});

		improveBtn.addEventListener('click', async () => {
			const draft = msgField.value.trim();
			if (!draft || improving || typeof LanguageModel === 'undefined') return;
			improving = true;
			lastDraft = msgField.value;
			improveBtn.disabled = true;
			undoBtn.hidden = true;
			submitBtn.disabled = true;
			msgField.readOnly = true;
			status.textContent = i18n.formImproving ?? '…';
			const controller = new AbortController();
			aborters.add(controller);
			let improver: LanguageModelSession | null = null;
			try {
				// Fresh session per pass: the model is already on disk so it is
				// cheap, and the chat's conversation quota stays untouched.
				const { improvePrompt } = await loadPrompts(config.lang);
				improver = await LanguageModel.create({
					initialPrompts: [{ role: 'system', content: improvePrompt }],
					signal: controller.signal,
				});
				sessions.add(improver);
				let acc = '';
				for await (const chunk of improver.promptStreaming(draft, { signal: controller.signal })) {
					// Older builds stream the cumulative text, newer ones stream deltas.
					if (chunk.length >= acc.length && chunk.startsWith(acc)) acc = chunk;
					else acc += chunk;
					msgField.value = acc;
				}
				status.textContent = '';
				undoBtn.hidden = false;
			} catch {
				if (!controller.signal.aborted) {
					msgField.value = lastDraft;
					status.textContent = i18n.formImproveError ?? 'Error.';
				}
			} finally {
				aborters.delete(controller);
				if (improver) {
					sessions.delete(improver);
					try {
						improver.destroy();
					} catch {
						/* already gone */
					}
				}
				improving = false;
				msgField.readOnly = false;
				submitBtn.disabled = false;
				improveBtn.disabled = !msgField.value.trim();
			}
		});

		boot();
	}

	function init() {
		document.querySelectorAll<HTMLElement>('[data-ama]:not([data-ama-ready])').forEach((root) => {
			root.dataset.amaReady = '1';
			setup(root);
		});
	}

	init();
	document.addEventListener('astro:page-load', init);
</script>

