---
/**
 * Sidenote — minimal editorial margin note.
 *
 * Usage in MDX:
 *
 *   This is the main argument.<Sidenote>And here is a quick aside that would
 *   derail the flow as a full paragraph.</Sidenote> The argument continues.
 *
 * Visual model:
 * - The marker is an auto-numbered superscript next to the word.
 * - On wide viewports (≥ 1200px), the note floats into the right margin as a
 *   small, low-contrast aside, aligned to the line where the marker appears.
 * - On narrow viewports, the marker is a button: tap to expand the note
 *   inline below the surrounding paragraph. No box, no border, no tinted
 *   wash — just smaller, lighter text with breathing room.
 *
 * Intent: quick context, references, mini-opinions, clarifications.
 * Do NOT use for paragraphs — if the note is long, leave it inline or
 * promote it to a Callout.
 */
---

<span class="sidenote" data-sidenote>
	<button
		type="button"
		class="sidenote-marker"
		aria-expanded="false"
		aria-label="Toggle sidenote"
	></button>
	<span class="sidenote-body" role="note">
		<slot />
	</span>
</span>

<script>
	function initSidenotes() {
		document.querySelectorAll<HTMLElement>('.sidenote').forEach((root) => {
			if (root.dataset.snReady === '1') return;
			root.dataset.snReady = '1';

			const marker = root.querySelector<HTMLButtonElement>('.sidenote-marker');
			if (!marker) return;

			marker.addEventListener('click', (e) => {
				e.stopPropagation();
				const expanded = marker.getAttribute('aria-expanded') === 'true';
				marker.setAttribute('aria-expanded', expanded ? 'false' : 'true');
			});
		});
	}

	initSidenotes();
	document.addEventListener('astro:after-swap', initSidenotes);
</script>

<style>
	.sidenote {
		counter-increment: sidenote;
	}

	/* ---------------- Marker (shared) ---------------- */

	.sidenote-marker {
		display: inline-block;
		padding: 0 0.18em;
		margin: 0 0.05em;
		border: none;
		background: transparent;
		font-family: var(--font-mono);
		font-size: 0.68em;
		line-height: 0;
		vertical-align: super;
		color: var(--color-accent);
		cursor: pointer;
		border-radius: var(--radius-sm);
		transition:
			color var(--duration-fast) var(--ease-smooth),
			background var(--duration-fast) var(--ease-smooth);
	}

	.sidenote-marker::before {
		content: counter(sidenote);
	}

	.sidenote-marker:hover,
	.sidenote-marker:focus-visible {
		color: var(--color-accent-hover);
		background: oklch(from var(--color-accent) l c h / 0.12);
		outline: none;
	}

	/* ---------------- Body — narrow (default) ---------------- */
	/* Inline-expand below the paragraph. No box, no border, no wash. */

	.sidenote-body {
		display: block;
		max-height: 0;
		overflow: hidden;
		margin: 0;
		padding: 0 0 0 1.5rem;
		font-family: var(--font-sans);
		font-size: 0.88rem;
		line-height: 1.7;
		color: var(--color-text-muted);
		transition:
			max-height var(--duration-normal) var(--ease-smooth),
			margin var(--duration-normal) var(--ease-smooth),
			padding var(--duration-normal) var(--ease-smooth);
	}

	.sidenote-body::before {
		content: counter(sidenote);
		display: inline-block;
		margin-right: 0.5em;
		font-family: var(--font-mono);
		font-size: 0.82em;
		color: var(--color-text-muted);
		opacity: 0.7;
	}

	.sidenote:has(.sidenote-marker[aria-expanded='true']) .sidenote-body {
		max-height: 40rem;
		margin: 0.5rem 0 0.9rem;
		padding: 0.25rem 0 0.25rem 1.5rem;
	}

	/* ---------------- Body — wide (≥ 1200px) ---------------- */
	/* Float into the right margin. Always visible. Aligned to marker line. */

	@media (min-width: 1200px) {
		.sidenote-body {
			max-height: none;
			float: right;
			clear: right;
			width: 12rem;
			margin: 0 -14rem 0.6rem 1rem;
			padding: 0;
			font-size: 0.78rem;
			line-height: 1.55;
			color: var(--color-text-muted);
			overflow: visible;
		}

		.sidenote-body::before {
			margin-right: 0.45em;
			font-size: 0.92em;
		}

		/* On wide screens the marker is a visual anchor, not a toggle. */
		.sidenote-marker {
			cursor: default;
		}

		/* Suppress the narrow-mode aria-expanded transition. */
		.sidenote:has(.sidenote-marker[aria-expanded='true']) .sidenote-body {
			margin: 0 -14rem 0.6rem 1rem;
			padding: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.sidenote-body {
			transition: none;
		}
	}
</style>
