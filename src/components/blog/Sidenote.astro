---
import { getLocale } from '../../consts';
/**
 * Sidenote — minimal editorial margin note.
 *
 * Usage in MDX:
 *
 *   This is the main argument.<Sidenote>And here is a quick aside that would
 *   derail the flow as a full paragraph.</Sidenote> The argument continues.
 *
 * Visual model:
 * - The marker is an auto-numbered superscript button next to the word.
 * - Click/tap reveals the note inline below the surrounding paragraph.
 *   No box, no border, no tinted wash — just smaller, lighter text with
 *   a mono number prefix and breathing room.
 *
 * Intent: quick context, references, mini-opinions, clarifications.
 * Do NOT use for paragraphs — if the note is long, leave it inline or
 * promote it to a Callout.
 */
---

<span class="sidenote" data-sidenote>
	<button
		type="button"
		class="sidenote-marker"
		aria-expanded="false"
		aria-label={getLocale(Astro.url) === 'es' ? 'Mostrar u ocultar la nota' : 'Toggle sidenote'}
	></button>
	<span class="sidenote-body" role="note">
		<slot />
	</span>
</span>

<script>
	function initSidenotes() {
		document.querySelectorAll<HTMLElement>('.sidenote').forEach((root) => {
			if (root.dataset.snReady === '1') return;
			root.dataset.snReady = '1';

			const marker = root.querySelector<HTMLButtonElement>('.sidenote-marker');
			if (!marker) return;

			marker.addEventListener('click', (e) => {
				e.stopPropagation();
				const expanded = marker.getAttribute('aria-expanded') === 'true';
				marker.setAttribute('aria-expanded', expanded ? 'false' : 'true');
			});
		});
	}

	initSidenotes();
	document.addEventListener('astro:after-swap', initSidenotes);
</script>

<style>
	.sidenote {
		counter-increment: sidenote;
	}

	/* ---------------- Marker (shared) ---------------- */

	.sidenote-marker {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 1.25em;
		height: 1.25em;
		padding: 0 0.4em;
		margin: 0 0.1em 0 0.15em;
		border: 1px solid oklch(from var(--color-accent) l c h / 0.35);
		background: oklch(from var(--color-accent) l c h / 0.08);
		font-family: var(--font-mono);
		font-size: 0.7em;
		font-weight: 500;
		line-height: 1;
		vertical-align: 0.15em;
		color: var(--color-accent);
		cursor: pointer;
		border-radius: 999px;
		transition:
			color var(--duration-fast) var(--ease-smooth),
			background var(--duration-fast) var(--ease-smooth),
			border-color var(--duration-fast) var(--ease-smooth),
			transform var(--duration-fast) var(--ease-spring);
	}

	.sidenote-marker::before {
		content: counter(sidenote);
	}

	.sidenote-marker:hover,
	.sidenote-marker:focus-visible {
		color: var(--color-accent-hover);
		background: oklch(from var(--color-accent) l c h / 0.18);
		border-color: oklch(from var(--color-accent) l c h / 0.55);
		transform: translateY(-1px);
		outline: none;
	}

	.sidenote-marker[aria-expanded='true'] {
		background: var(--color-accent);
		border-color: var(--color-accent);
		color: var(--color-bg);
	}

	/* ---------------- Body — narrow (default) ---------------- */
	/* Inline-expand below the paragraph. No box, no border, no wash. */

	.sidenote-body {
		display: block;
		max-height: 0;
		overflow: hidden;
		margin: 0;
		padding: 0 0 0 1.5rem;
		font-family: var(--font-sans);
		font-size: 0.88rem;
		line-height: 1.7;
		color: var(--color-text-muted);
		transition:
			max-height var(--duration-normal) var(--ease-smooth),
			margin var(--duration-normal) var(--ease-smooth),
			padding var(--duration-normal) var(--ease-smooth);
	}

	.sidenote-body::before {
		content: counter(sidenote);
		display: inline-block;
		margin-right: 0.5em;
		font-family: var(--font-mono);
		font-size: 0.82em;
		color: var(--color-text-muted);
		opacity: 0.7;
	}

	.sidenote:has(.sidenote-marker[aria-expanded='true']) .sidenote-body {
		max-height: 40rem;
		margin: 0.5rem 0 0.9rem;
		padding: 0.25rem 0 0.25rem 1.5rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.sidenote-body {
			transition: none;
		}
	}
</style>
