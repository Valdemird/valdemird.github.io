---
import '../styles/global.css';
import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/wght-italic.css'; // real italics for blockquotes / pull-quotes
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
// Same asset URLs the @font-face rules resolve to; preloaded so the first
// paint doesn't wait on CSS discovery. Latin subset, upright, variable wght.
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistMonoLatin from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import { ClientRouter } from 'astro:transitions';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_DESCRIPTION_ES, PERSON, ORGANIZATION, ORGANIZATION_ID } from '../consts';

interface Alternate {
	hreflang: string;
	href: string;
}

interface Props {
	title: string;
	description: string;
	image?: string;
	imageAlt?: string;
	lang?: string;
	type?: 'website' | 'article';
	alternates?: Alternate[];
	jsonLd?: Record<string, unknown>;
	extraJsonLd?: Record<string, unknown>[];
	publishedTime?: Date;
	modifiedTime?: Date;
	tags?: string[];
	/** Public URL of a markdown alternate for this page — surfaces the .md to AI agents */
	markdownAlternate?: string;
	/** Keep this page out of search indexes (e.g. /lab). */
	noindex?: boolean;
}

const AUTHOR_NAME = 'Valdemir D.';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image: imageProp, imageAlt, lang, type = 'website', alternates = [], jsonLd, extraJsonLd = [], publishedTime, modifiedTime, tags, markdownAlternate, noindex = false } = Astro.props;
const image = imageProp || '/og/default.png';

// Title pattern: "<Page> — valdemird". Shells may still pass their own brand
// suffix ("Blog | valdemird", "X · valdemird"); strip it and apply one style.
// The home title already leads with the brand and is used as-is. Articles keep
// the brand only while the whole title stays SERP-sized (~65 chars).
const BRAND_SEP = ' — ';
const brandSuffix = new RegExp(`\\s*[|·—–-]\\s*${SITE_TITLE}\\s*$`, 'i');
const pageTitle = title.replace(brandSuffix, '').trim() || SITE_TITLE;
const isBrandLed = pageTitle === SITE_TITLE || pageTitle.toLowerCase().startsWith(`${SITE_TITLE.toLowerCase()} `);
const brandedTitle = `${pageTitle}${BRAND_SEP}${SITE_TITLE}`;
const documentTitle = isBrandLed
	? pageTitle
	: type === 'article' && brandedTitle.length > 65
		? pageTitle
		: brandedTitle;
const ogImageAlt = imageAlt || pageTitle;

// og:image:type from the file extension; width/height only for the generated
// 1200x630 cards under /og/ (a hero image can be any size).
const IMAGE_MIME: Record<string, string> = {
	png: 'image/png',
	jpg: 'image/jpeg',
	jpeg: 'image/jpeg',
	webp: 'image/webp',
	avif: 'image/avif',
	gif: 'image/gif',
};
const imageExt = image.split(/[?#]/)[0].split('.').pop()?.toLowerCase() ?? '';
const ogImageType = IMAGE_MIME[imageExt];
const isGeneratedOg = image.startsWith('/og/');

const defaultJsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': 'https://valdemird.com/#website',
			name: SITE_TITLE,
			url: 'https://valdemird.com',
			description: lang === 'es' ? SITE_DESCRIPTION_ES : SITE_DESCRIPTION,
			inLanguage: ['en', 'es'],
			publisher: { '@id': ORGANIZATION_ID },
		},
		PERSON,
		ORGANIZATION,
	],
};

const structuredData = jsonLd || defaultJsonLd;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/favicon.svg" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="generator" content={Astro.generator} />
<meta name="color-scheme" content="light dark" />
<!-- sRGB of --color-bg: light oklch(0.99 0 0), dark oklch(0.16 0.01 260) -->
<meta name="theme-color" content="#fcfcfc" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0b0d12" media="(prefers-color-scheme: dark)" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="format-detection" content="telephone=no" />

<!-- Security -->
<!-- Note: X-Frame-Options / X-Content-Type-Options only work as HTTP headers,
     not <meta>. GitHub Pages can't set custom headers, so they're omitted here
     (a <meta> X-Frame-Options just logs a console warning and does nothing). -->
<meta name="referrer" content="strict-origin-when-cross-origin" />

<!-- Analytics: Plausible (privacy-friendly, no cookies, <1KB) -->
<!-- Uncomment when Plausible account is set up at https://plausible.io -->
<!-- <script defer data-domain="valdemird.com" src="https://plausible.io/js/script.js"></script> -->

<!-- Fonts: preload the latin variable faces every page renders with -->
<link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={geistMonoLatin} as="font" type="font/woff2" crossorigin />

<!-- View Transitions -->
<ClientRouter />

<!-- Theme: always follow the OS preference (no manual override) -->
<script is:inline>
	(function () {
		var mq = window.matchMedia('(prefers-color-scheme: dark)');
		function setTheme(root) {
			root.setAttribute('data-theme', mq.matches ? 'dark' : 'light');
		}
		setTheme(document.documentElement);
		// React live when the OS theme changes
		mq.addEventListener('change', function () {
			setTheme(document.documentElement);
		});
		// Apply theme BEFORE swap so the new page snapshot already has the correct theme
		// — prevents flash of wrong theme during View Transition
		document.addEventListener('astro:before-swap', function (e) {
			setTheme(e.newDocument.documentElement);
		});
		document.addEventListener('astro:after-swap', function () {
			document.documentElement.setAttribute('data-vt-nav', '');
		});
	})();
</script>

<!-- Scroll behavior: clean anchor arrival + keep reading position on language switch -->
<script is:inline>
	(function () {
		// Header is ~58px; align a touch below it when deciding the "current" section.
		var HEADER_OFFSET = 100;

		function blogHeadings() {
			return Array.prototype.slice.call(
				document.querySelectorAll('.article-body h2[id], .article-body h3[id]'),
			);
		}

		// --- Keep reading position across an EN <-> ES switch (blog posts only) ---
		// EN/ES posts share the same heading order (only the slugs are translated),
		// so we remember WHICH heading you were reading and land on its counterpart.
		// Event delegation on document survives View Transitions (the DOM is swapped).
		document.addEventListener('click', function (e) {
			var link = e.target && e.target.closest && e.target.closest('.lang-switch');
			if (!link) return;
			var headings = blogHeadings();
			if (!headings.length) return; // not a blog post — fall back to top (default)
			if (window.scrollY <= HEADER_OFFSET) return; // at the top — nothing to restore
			var idx = 0;
			for (var i = 0; i < headings.length; i++) {
				if (headings[i].getBoundingClientRect().top <= HEADER_OFFSET) idx = i;
			}
			try {
				sessionStorage.setItem('langScrollHeading', String(idx));
			} catch (err) {}
		});

		function restoreLangScroll() {
			var raw;
			try {
				raw = sessionStorage.getItem('langScrollHeading');
				sessionStorage.removeItem('langScrollHeading');
			} catch (e) {
				return false;
			}
			if (raw === null) return false;
			var idx = parseInt(raw, 10);
			if (isNaN(idx)) return false;
			requestAnimationFrame(function () {
				requestAnimationFrame(function () {
					var h = blogHeadings()[idx];
					if (h) h.scrollIntoView({ block: 'start', behavior: 'auto' });
				});
			});
			return true;
		}

		// --- Re-align deep-link anchors after a View Transition settles ---
		// ClientRouter scrolls to the hash before late layout reflow finishes, leaving
		// the heading a few dozen px off. Re-aligning on page-load (which respects
		// scroll-margin-top) makes deep-link arrivals land cleanly under the header.
		function realignHash() {
			if (!location.hash) return;
			var id;
			try {
				id = decodeURIComponent(location.hash.slice(1));
			} catch (e) {
				id = location.hash.slice(1);
			}
			var el = document.getElementById(id);
			if (!el) return;
			requestAnimationFrame(function () {
				el.scrollIntoView({ block: 'start', behavior: 'auto' });
			});
		}

		document.addEventListener('astro:page-load', function () {
			// A pending language restore takes precedence; lang URLs carry no hash.
			if (!restoreLangScroll()) realignHash();
		});
	})();
</script>

{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Hreflang alternates for i18n SEO -->
{alternates.map((alt) => (
	<link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
))}
{alternates.length > 0 && (
	<link rel="alternate" hreflang="x-default" href={alternates.find(a => a.hreflang === 'en')?.href || canonicalURL.toString()} />
)}

<!-- Markdown alternate — pista descubrible para agentes AI -->
{markdownAlternate && <link rel="alternate" type="text/markdown" href={markdownAlternate} />}

<!-- Primary Meta Tags -->
<title>{documentTitle}</title>
<meta name="title" content={documentTitle} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content="valdemird" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />
{ogImageType && <meta property="og:image:type" content={ogImageType} />}
{isGeneratedOg && <meta property="og:image:width" content="1200" />}
{isGeneratedOg && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
{lang === 'es' && <meta property="og:locale:alternate" content="en_US" />}
{lang !== 'es' && <meta property="og:locale:alternate" content="es_ES" />}

<!-- Article meta (blog posts only) -->
{type === 'article' && <meta property="article:author" content={AUTHOR_NAME} />}
{type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{type === 'article' && tags && tags.map((tag) => (
	<meta property="article:tag" content={tag} />
))}

<!-- Author -->
<meta name="author" content={AUTHOR_NAME} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={pageTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />
<meta property="twitter:image:alt" content={ogImageAlt} />

<!-- Structured Data (JSON-LD) -->
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
{extraJsonLd.map((doc) => (
	<script type="application/ld+json" set:html={JSON.stringify(doc)} />
))}
