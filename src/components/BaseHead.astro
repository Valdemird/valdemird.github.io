---
import '../styles/global.css';
import '@fontsource-variable/fraunces';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import { ClientRouter } from 'astro:transitions';

interface Alternate {
	hreflang: string;
	href: string;
}

interface Props {
	title: string;
	description: string;
	image?: string;
	imageAlt?: string;
	lang?: string;
	type?: 'website' | 'article';
	alternates?: Alternate[];
	jsonLd?: Record<string, unknown>;
	extraJsonLd?: Record<string, unknown>[];
	publishedTime?: Date;
	modifiedTime?: Date;
	tags?: string[];
	/** Public URL of a markdown alternate for this page — surfaces the .md to AI agents */
	markdownAlternate?: string;
}

const AUTHOR_NAME = 'Valdemir D.';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image: imageProp, imageAlt, lang, type = 'website', alternates = [], jsonLd, extraJsonLd = [], publishedTime, modifiedTime, tags, markdownAlternate } = Astro.props;
const image = imageProp || '/og/default.png';
const ogImageAlt = imageAlt || title;

const defaultJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'valdemird',
	url: 'https://valdemird.com',
	description: 'Software engineer and builder. I make developer tools and write about what I learn.',
	author: {
		'@type': 'Person',
		name: 'Valdemir D.',
		url: 'https://valdemird.com',
		sameAs: [
			'https://github.com/valdemird',
			'https://www.linkedin.com/in/sebastiancaja',
		],
	},
	inLanguage: ['en', 'es'],
	potentialAction: {
		'@type': 'SearchAction',
		target: {
			'@type': 'EntryPoint',
			urlTemplate: 'https://valdemird.com/blog/?q={search_term_string}',
		},
		'query-input': 'required name=search_term_string',
	},
};

const structuredData = jsonLd || defaultJsonLd;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/favicon.svg" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="generator" content={Astro.generator} />
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#1a1a2e" media="(prefers-color-scheme: dark)" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="format-detection" content="telephone=no" />

<!-- Security -->
<!-- Note: X-Frame-Options / X-Content-Type-Options only work as HTTP headers,
     not <meta>. GitHub Pages can't set custom headers, so they're omitted here
     (a <meta> X-Frame-Options just logs a console warning and does nothing). -->
<meta name="referrer" content="strict-origin-when-cross-origin" />

<!-- Analytics: Plausible (privacy-friendly, no cookies, <1KB) -->
<!-- Uncomment when Plausible account is set up at https://plausible.io -->
<!-- <script defer data-domain="valdemird.com" src="https://plausible.io/js/script.js"></script> -->

<!-- View Transitions -->
<ClientRouter />

<!-- Theme: always follow the OS preference (no manual override) -->
<script is:inline>
	(function () {
		var mq = window.matchMedia('(prefers-color-scheme: dark)');
		function setTheme(root) {
			root.setAttribute('data-theme', mq.matches ? 'dark' : 'light');
		}
		setTheme(document.documentElement);
		// React live when the OS theme changes
		mq.addEventListener('change', function () {
			setTheme(document.documentElement);
		});
		// Apply theme BEFORE swap so the new page snapshot already has the correct theme
		// — prevents flash of wrong theme during View Transition
		document.addEventListener('astro:before-swap', function (e) {
			setTheme(e.newDocument.documentElement);
		});
		document.addEventListener('astro:after-swap', function () {
			document.documentElement.setAttribute('data-vt-nav', '');
		});
	})();
</script>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Hreflang alternates for i18n SEO -->
{alternates.map((alt) => (
	<link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
))}
{alternates.length > 0 && (
	<link rel="alternate" hreflang="x-default" href={alternates.find(a => a.hreflang === 'en')?.href || canonicalURL.toString()} />
)}

<!-- Markdown alternate — pista descubrible para agentes AI -->
{markdownAlternate && <link rel="alternate" type="text/markdown" href={markdownAlternate} />}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content="valdemird" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
{lang === 'es' && <meta property="og:locale:alternate" content="en_US" />}
{lang !== 'es' && <meta property="og:locale:alternate" content="es_ES" />}

<!-- Article meta (blog posts only) -->
{type === 'article' && <meta property="article:author" content={AUTHOR_NAME} />}
{type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{type === 'article' && tags && tags.map((tag) => (
	<meta property="article:tag" content={tag} />
))}

<!-- Author -->
<meta name="author" content={AUTHOR_NAME} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />
<meta property="twitter:image:alt" content={ogImageAlt} />

<!-- Structured Data (JSON-LD) -->
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
{extraJsonLd.map((doc) => (
	<script type="application/ld+json" set:html={JSON.stringify(doc)} />
))}
