---
import { getEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { UI_STRINGS, type Locale } from '../consts';
import { readingMinutes } from '../lib/learn';

interface Props {
	id: string;
	title: string;
	description: string;
	pubDate: Date;
	tags?: string[];
	basePath?: string;
	locale?: Locale;
	enableTransition?: boolean;
	/** Reading time in minutes. Callers should pass `readingMinutes(post.body)`. */
	readingTime?: number;
}

const { id, title, description, pubDate, tags, basePath = '/blog', locale = 'en', enableTransition = false } = Astro.props;

// Reading time comes from the post body, never the description. When a caller
// doesn't pass it, look the entry up so every list (home, blog index, Read
// next) shows the same number as the post header.
const readingTime =
	Astro.props.readingTime ?? readingMinutes((await getEntry('blog', id))?.body);
const minReadLabel = UI_STRINGS[locale].blog.minRead;
---

<a href={`${basePath}/${id}/`} class="post-preview">
	<div class="post-preview-content">
		<div class="post-preview-meta">
			<FormattedDate date={pubDate} locale={locale} />
			<span class="separator" aria-hidden="true">&middot;</span>
			<span>{readingTime} {minReadLabel}</span>
		</div>
		{enableTransition ? (
			<h3 transition:name={`post-title-${id.replace(/\//g, '-')}`}>{title}</h3>
		) : (
			<h3 data-vt-name={`post-title-${id.replace(/\//g, '-')}`}>{title}</h3>
		)}
		<p>{description}</p>
		{tags && tags.length > 0 && (
			<div class="post-preview-tags">
				{tags.map((tag) => <span class="tag">{tag}</span>)}
			</div>
		)}
	</div>
	<svg class="post-arrow" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<line x1="5" y1="12" x2="19" y2="12"></line>
		<polyline points="12 5 19 12 12 19"></polyline>
	</svg>
</a>

<style>
	.post-preview {
		--post-wash: 0.045;
		position: relative;
		display: flex;
		align-items: center;
		gap: var(--space-lg);
		padding: 1.25rem var(--space-lg);
		text-decoration: none;
		color: inherit;
		border-radius: var(--radius-lg);
		border: 1px solid transparent;
		transition: border-color var(--duration-normal) var(--ease-smooth),
			background var(--duration-normal) var(--ease-smooth),
			box-shadow var(--duration-normal) var(--ease-smooth),
			transform var(--duration-normal) var(--ease-spring);
	}

	:global([data-theme='dark']) .post-preview {
		--post-wash: 0.085;
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .post-preview {
			--post-wash: 0.085;
		}
	}

	/* Hover and keyboard focus share one state: tinted wash, shadow, border,
	   and a small horizontal nudge. No accent bar on the left edge. */
	.post-preview:hover,
	.post-preview:focus-visible {
		border-color: var(--color-border-strong);
		background: oklch(from var(--color-accent) l c h / var(--post-wash));
		box-shadow: var(--shadow-md);
		transform: translateX(4px);
	}

	.post-preview:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
	}

	.post-preview-content {
		flex: 1;
		min-width: 0;
	}

	.post-preview-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.78rem;
		color: var(--color-text-muted);
		margin-bottom: 0.35rem;
		font-family: var(--font-mono);
	}

	.separator { opacity: 0.4; }

	h3 {
		font-family: var(--font-serif);
		font-size: 1.15rem;
		margin: 0 0 0.3rem;
		color: var(--color-text);
		line-height: 1.35;
		transition: color var(--duration-fast) var(--ease-smooth);
	}

	.post-preview:hover h3,
	.post-preview:focus-visible h3 {
		color: var(--color-accent-hover);
	}

	p {
		font-size: 0.88rem;
		color: var(--color-text-secondary);
		margin: 0;
		line-height: 1.55;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.post-preview-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
		min-width: 0;
		margin-top: 0.5rem;
	}

	.tag {
		font-family: var(--font-mono);
		font-size: 0.65rem;
		font-weight: 500;
		white-space: nowrap;
		padding: 0.15em 0.5em;
		background: var(--color-accent-subtle);
		border-radius: var(--radius-sm);
		color: var(--color-accent-hover);
	}

	.post-arrow {
		flex-shrink: 0;
		color: var(--color-text-muted);
		opacity: 0;
		transform: translateX(-6px);
		transition: opacity var(--duration-normal) var(--ease-smooth),
			transform var(--duration-normal) var(--ease-spring);
	}

	.post-preview:hover .post-arrow,
	.post-preview:focus-visible .post-arrow {
		opacity: 1;
		transform: translateX(0);
	}

	@media (max-width: 640px) {
		.post-preview { padding: var(--space-md); }
		.post-arrow { display: none; }
		.post-preview:hover,
		.post-preview:focus-visible { transform: none; }
	}

	@media (prefers-reduced-motion: reduce) {
		.post-preview:hover,
		.post-preview:focus-visible { transform: none; }
	}
</style>
