---
// Aliased import: Astro names this module's component after the filename,
// so the demo can't import the real component under its own name.
import Chart from '../../blog/InteractiveChart.astro';
import DemoSection from '../DemoSection.astro';

export const meta = {
	title: 'InteractiveChart',
	category: 'data',
	status: 'stable',
	summary: 'Multi-type chart (bar, horizontal, line, area, donut, scatter) with multi-series, thresholds, hover scrub and keyboard navigation.',
	summaryEs: 'Gráfica multitipo (barras, horizontal, línea, área, dona, dispersión) con multiserie, umbrales, scrub con hover y navegación por teclado.',
	why: 'The posts kept making numeric claims in prose — "ten rounds of feedback", "three PRs by dinner" — and a markdown table flattens that into furniture. This chart exists so the number can argue: the story prop forces me to write the finding, not the topic, and annotations point at the exact data point that carries it. No chart library because every fill is a CSS variable; dark mode and the OKLch palette come free.',
	whyEs: 'Los posts hacían afirmaciones numéricas en prosa ("diez rondas de feedback", "tres PRs antes de cenar") y una tabla markdown convierte eso en mueble. Esta gráfica existe para que el número argumente: la prop story me obliga a escribir el hallazgo y no el tema, y las anotaciones señalan el punto exacto que lo sostiene. Sin librería de charts porque cada relleno es una variable CSS; el dark mode y la paleta OKLch salen gratis.',
	props: [
		{ name: 'type', type: '"bar" | "horizontal" | "line" | "area" | "donut" | "scatter"', default: '"bar"', description: 'Chart shape. Bars animate via CSS, SVG types via GSAP + ScrollTrigger.' },
		{ name: 'data', type: '{ label, value, color? }[]', description: 'Data points. color accepts any CSS color, defaults to the accent token.' },
		{ name: 'series', type: '{ name, color?, tone?, data }[]', description: 'Multi-series lines with legend toggling (at least one series stays on). Line type only; x labels from the first series. tone ("accent" | "success" | "warning" | "destructive" | "muted") gives a series semantic meaning.' },
		{ name: 'palette', type: '"categorical" | "sequential"', default: '"categorical"', description: 'Series colors: distinct brand hues, or one hue light to dark for ordered levels.' },
		{ name: 'points', type: '{ x, y, label?, color?, highlight? }[]', description: 'Scatter points (type="scatter"). highlight draws the point in accent with its label beside it.' },
		{ name: 'thresholds', type: '{ value, label? }[]', default: '[]', description: 'Dashed reference lines on line/area/scatter.' },
		{ name: 'curve', type: '"linear" | "monotone"', default: '"linear"', description: 'Path interpolation for line/area.' },
		{ name: 'interactive', type: 'boolean', default: 'true', description: 'Hover crosshair + readout and arrow-key navigation on SVG types.' },
		{ name: 'story', type: 'string', description: 'Finding-first lede (Fraunces, figure scale). State the point, not the topic.' },
		{ name: 'title', type: 'string', description: 'Mono uppercase eyebrow above the story: what is being measured.' },
		{ name: 'annotations', type: '{ targetIndex, text, emphasize? }[]', default: '[]', description: 'Per-point callouts in a slot that never overlaps marks: a note line under a horizontal bar, a numbered marker + notes list for vertical bars, an edge-aware haloed label on lines. emphasize keeps that point at full ink and steps the rest back.' },
		{ name: 'unit', type: 'string', default: '""', description: 'Suffix for printed values, readouts and (if 2 chars or less) y ticks, e.g. "%" or " min".' },
		{ name: 'xUnit', type: 'string', description: 'Suffix for the readout header on line/area charts, e.g. " steps" gives "10 steps".' },
		{ name: 'totalLabel', type: 'string', description: 'Donut: mono caption under the center total, e.g. "hours".' },
		{ name: 'source', type: 'string | slot', description: 'Muted attribution below a hairline. Use <span slot="source"> for links or superscripts.' },
		{ name: 'yLabel / xLabel', type: 'string', description: 'Axis titles (HTML, so they never scale with the SVG). SVG types only.' },
	],
};

const { lang = 'en' } = Astro.props;
const es = lang === 'es';

const barData = es
	? [
		{ label: 'llegó a prod', value: 31 },
		{ label: 'atrapado en review', value: 14 },
		{ label: 'atrapado por tests', value: 9 },
	]
	: [
		{ label: 'shipped', value: 31 },
		{ label: 'caught in review', value: 14 },
		{ label: 'caught by tests', value: 9 },
	];

const horizontalData = es
	? [
		{ label: 'armar el módulo', value: 12 },
		{ label: 'primera pasada con el agente', value: 34 },
		{ label: 'loop de review, tres rondas', value: 58 },
		{ label: 'pulido', value: 21 },
	]
	: [
		{ label: 'scaffold the module', value: 12 },
		{ label: 'first pass with the agent', value: 34 },
		{ label: 'review loop, three rounds', value: 58 },
		{ label: 'polish', value: 21 },
	];

const lineData = es
	? [
		{ label: 'Ene', value: 41 },
		{ label: 'Feb', value: 47 },
		{ label: 'Mar', value: 60 },
		{ label: 'Abr', value: 38 },
		{ label: 'May', value: 33 },
	]
	: [
		{ label: 'Jan', value: 41 },
		{ label: 'Feb', value: 47 },
		{ label: 'Mar', value: 60 },
		{ label: 'Apr', value: 38 },
		{ label: 'May', value: 33 },
	];

const multiSeries = es
	? [
		{ name: 'con tests', data: [
			{ label: 'sem1', value: 2 }, { label: 'sem2', value: 3 },
			{ label: 'sem3', value: 2 }, { label: 'sem4', value: 4 },
		] },
		{ name: 'sin tests', tone: 'destructive' as const, data: [
			{ label: 'sem1', value: 3 }, { label: 'sem2', value: 6 },
			{ label: 'sem3', value: 9 }, { label: 'sem4', value: 14 },
		] },
	]
	: [
		{ name: 'with tests', data: [
			{ label: 'wk1', value: 2 }, { label: 'wk2', value: 3 },
			{ label: 'wk3', value: 2 }, { label: 'wk4', value: 4 },
		] },
		{ name: 'no tests', tone: 'destructive' as const, data: [
			{ label: 'wk1', value: 3 }, { label: 'wk2', value: 6 },
			{ label: 'wk3', value: 9 }, { label: 'wk4', value: 14 },
		] },
	];

const scatterPoints = es
	? [
		{ x: 12, y: 4, label: 'corregir typo' },
		{ x: 38, y: 11, label: 'rename' },
		{ x: 80, y: 18, label: 'feat pequeño' },
		{ x: 150, y: 42, label: 'feat mediano' },
		{ x: 240, y: 95, label: 'refactor' },
		{ x: 320, y: 150, label: 'migración' },
		{ x: 520, y: 260, label: 'el grandote', highlight: true },
	]
	: [
		{ x: 12, y: 4, label: 'fix typo' },
		{ x: 38, y: 11, label: 'rename' },
		{ x: 80, y: 18, label: 'small feat' },
		{ x: 150, y: 42, label: 'mid feat' },
		{ x: 240, y: 95, label: 'refactor' },
		{ x: 320, y: 150, label: 'migration' },
		{ x: 520, y: 260, label: 'the big one', highlight: true },
	];

const donutData = es
	? [
		{ label: 'loop de review', value: 19 },
		{ label: 'escribir código', value: 11 },
		{ label: 'escribir tests', value: 8 },
		{ label: 'pensar', value: 4 },
	]
	: [
		{ label: 'review loop', value: 19 },
		{ label: 'writing code', value: 11 },
		{ label: 'writing tests', value: 8 },
		{ label: 'thinking', value: 4 },
	];
---

<DemoSection
	label={es ? 'barras / con anotaciones' : 'bar / annotated'}
	description={es ? 'Cada columna lleva su valor encima. La anotación es un marcador numerado con su nota debajo, y la columna destacada queda a tinta plena mientras las demás retroceden. Pasa el puntero o entra con Tab para levantar cualquier columna.' : "Every column carries its value. The annotation is a numbered marker with its note below, and the highlighted column stays at full ink while the rest step back. Hover or Tab onto any column to lift it."}
	usage={`<InteractiveChart
  type="bar"
  story="Review picks up half of what slips past the agent."
  data={[
    { label: "shipped", value: 31 },
    { label: "caught in review", value: 14 },
    { label: "caught by tests", value: 9 },
  ]}
  annotations={[{ targetIndex: 1, text: "the review gap", emphasize: true }]}
  source="Sample data"
/>`}
>
	<Chart
		type="bar"
		story={es ? 'El review atrapa la mitad de lo que se le escapa al agente.' : 'Review picks up half of what slips past the agent.'}
		data={barData}
		annotations={[{ targetIndex: 1, text: es ? 'la brecha del review' : 'the review gap', emphasize: true }]}
		source={es ? 'Datos de ejemplo' : 'Sample data'}
	/>
</DemoSection>

<DemoSection
	label="horizontal"
	description={es ? 'La mejor opción cuando las etiquetas son largas. Todas las barras arrancan en la misma línea, los valores van en su propia columna y la nota, con el mismo marcador numerado que las columnas, queda debajo de su barra. En pantallas angostas la etiqueta sube encima de la barra.' : 'The pick for long labels. Every bar starts on the same line, values sit in their own column, and the note, with the same numbered marker the columns use, goes under its bar. On narrow screens the label moves above the bar.'}
	usage={`<InteractiveChart
  type="horizontal"
  title="time per task"
  unit=" min"
  data={[
    { label: "scaffold the module", value: 12 },
    { label: "first pass with the agent", value: 34 },
    { label: "review loop, three rounds", value: 58 },
    { label: "polish", value: 21 },
  ]}
  annotations={[{ targetIndex: 2, text: "where the day goes", emphasize: true }]}
/>`}
>
	<Chart
		type="horizontal"
		title={es ? 'tiempo por tarea' : 'time per task'}
		unit=" min"
		data={horizontalData}
		annotations={[{ targetIndex: 2, text: es ? 'donde se va el día' : 'where the day goes', emphasize: true }]}
	/>
</DemoSection>

<DemoSection
	label={es ? 'línea / con anotaciones' : 'line / annotated'}
	description={es ? 'La línea se dibuja sola al entrar en pantalla, y la nota busca un hueco junto a su punto sin tapar la línea ni salirse del gráfico. Si no hay hueco, el punto lleva un número y la nota baja debajo del gráfico. Dale replay para verla de nuevo.' : "The line draws itself in as it enters the view, and the note looks for a clear spot beside its point without covering the line or running off the plot. When there isn't one, the point gets a number and the note moves under the chart. Replay to watch it again."}
	usage={`<InteractiveChart
  type="line"
  story="The suite got slower until the fixture rewrite landed."
  data={[
    { label: "Jan", value: 41 },
    { label: "Feb", value: 47 },
    { label: "Mar", value: 60 },
    { label: "Apr", value: 38 },
    { label: "May", value: 33 },
  ]}
  annotations={[{ targetIndex: 3, text: "fixture rewrite", emphasize: true }]}
  yLabel="suite time (s)"
/>`}
>
	<Chart
		type="line"
		story={es ? 'La suite se fue poniendo lenta hasta que aterrizó la reescritura de fixtures.' : 'The suite got slower until the fixture rewrite landed.'}
		data={lineData}
		annotations={[{ targetIndex: 3, text: es ? 'reescritura de fixtures' : 'fixture rewrite', emphasize: true }]}
		yLabel={es ? 'tiempo de suite (s)' : 'suite time (s)'}
	/>
</DemoSection>

<DemoSection
	label={es ? 'área' : 'area'}
	description={es ? 'Línea más un relleno translúcido — para historias acumulativas o con forma de volumen.' : 'Line plus a translucent fill — for cumulative or volume-shaped stories.'}
	usage={`<InteractiveChart
  type="area"
  title="posts published, cumulative"
  data={[
    { label: "2025 Q4", value: 1 },
    { label: "2026 Q1", value: 3 },
    { label: "2026 Q2", value: 5 },
  ]}
/>`}
>
	<Chart
		type="area"
		title={es ? 'posts publicados, acumulado' : 'posts published, cumulative'}
		data={[
			{ label: '2025 Q4', value: 1 },
			{ label: '2026 Q1', value: 3 },
			{ label: '2026 Q2', value: 5 },
		]}
	/>
</DemoSection>

<DemoSection
	label={es ? 'multiserie / toggle de leyenda / umbrales' : 'multi-series / legend toggle / thresholds'}
	description={es ? 'Pasa el puntero (o toca, en el celular) para leer los valores de cada semana; la lectura se acomoda donde no tape ninguna línea. Los chips de la leyenda ocultan una serie, y siempre queda al menos una. Entra al gráfico con Tab y usa las flechas. La serie sin tests va en rojo porque es la mala noticia, y el tope de errores es una línea de referencia punteada.' : "Hover (or tap, on a phone) to read each week's values; the readout parks where it covers no line. Legend chips hide a series, and at least one always stays on. Tab into the chart and use the arrow keys. The untested series is red because it's the bad news, and the error budget is a dashed reference line."}
	usage={`<InteractiveChart
  type="line"
  curve="monotone"
  story="The agent ships faster, but only the tested branch stays under the error budget."
  series={[
    { name: "with tests", data: [
      { label: "wk1", value: 2 }, { label: "wk2", value: 3 },
      { label: "wk3", value: 2 }, { label: "wk4", value: 4 },
    ]},
    { name: "no tests", tone: "destructive", data: [
      { label: "wk1", value: 3 }, { label: "wk2", value: 6 },
      { label: "wk3", value: 9 }, { label: "wk4", value: 14 },
    ]},
  ]}
  thresholds={[{ value: 8, label: "error budget" }]}
  yLabel="regressions"
/>`}
>
	<Chart
		type="line"
		curve="monotone"
		story={es ? 'El agente entrega más rápido, pero solo la rama con tests se mantiene bajo el tope de errores.' : 'The agent ships faster, but only the tested branch stays under the error budget.'}
		series={multiSeries}
		thresholds={[{ value: 8, label: es ? 'tope de errores' : 'error budget' }]}
		yLabel={es ? 'regresiones' : 'regressions'}
	/>
</DemoSection>

<DemoSection
	label={es ? 'dispersión' : 'scatter'}
	description={es ? 'Puntos numéricos x/y con ticks limpios en ambos ejes. El puntero se engancha al punto más cercano y la lectura da las dos coordenadas. El punto destacado lleva su nombre al lado.' : 'Numeric x/y points with clean ticks on both axes. The pointer snaps to the nearest point and the readout gives both coordinates. The highlighted point carries its name beside it.'}
	usage={`<InteractiveChart
  type="scatter"
  title="PR size vs review time"
  points={[
    { x: 12, y: 4, label: "fix typo" },
    { x: 80, y: 18, label: "small feat" },
    { x: 240, y: 95, label: "refactor" },
    { x: 520, y: 260, label: "the big one", highlight: true },
  ]}
  thresholds={[{ value: 120, label: "review SLA" }]}
  xLabel="lines changed" yLabel="review minutes"
/>`}
>
	<Chart
		type="scatter"
		title={es ? 'tamaño de PR vs tiempo de review' : 'PR size vs review time'}
		points={scatterPoints}
		thresholds={[{ value: 120, label: es ? 'SLA de review' : 'review SLA' }]}
		xLabel={es ? 'líneas cambiadas' : 'lines changed'}
		yLabel={es ? 'minutos de review' : 'review minutes'}
	/>
</DemoSection>

<DemoSection
	label={es ? 'dona' : 'donut'}
	description={es ? 'Partes de un todo con leyenda. La porción de la historia va en el acento y las demás en grises; el total va en serif al centro con su unidad. Pasa el puntero por una fila o una porción y se iluminan juntas.' : "Part-of-whole with a legend. The story's slice takes the accent and the rest go grey; the total sits in serif at the center with its unit. Hover a row or a slice and they light up together."}
	usage={`<InteractiveChart
  type="donut"
  story="Most of the month went to the review loop."
  data={[
    { label: "review loop", value: 19 },
    { label: "writing code", value: 11 },
    { label: "writing tests", value: 8 },
    { label: "thinking", value: 4 },
  ]}
  totalLabel="hours"
  annotations={[{ targetIndex: 0, text: "the review loop", emphasize: true }]}
/>`}
>
	<Chart
		type="donut"
		story={es ? 'La mayor parte del mes se fue en el loop de review.' : 'Most of the month went to the review loop.'}
		data={donutData}
		totalLabel={es ? 'horas' : 'hours'}
		annotations={[{ targetIndex: 0, text: es ? 'el loop de review' : 'the review loop', emphasize: true }]}
	/>
</DemoSection>
