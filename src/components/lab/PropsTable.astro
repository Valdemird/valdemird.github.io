---
/**
 * PropsTable — hand-authored prop documentation for a /lab component page.
 * Source of truth is the demo file's `meta.props`; kept manual on purpose
 * (the props ARE the public API — writing them down is the review).
 */
export interface PropDoc {
	name: string;
	type: string;
	default?: string;
	description?: string;
}

interface Props {
	props: PropDoc[];
}

const { props } = Astro.props;
---

{props.length > 0 && (
	<div class="props-table-wrap">
		<span class="props-eyebrow">props</span>
		<table class="props-table">
			<thead>
				<tr>
					<th>name</th>
					<th>type</th>
					<th>default</th>
					<th>description</th>
				</tr>
			</thead>
			<tbody>
				{props.map((p) => (
					<tr>
						<td class="prop-name">{p.name}</td>
						<td class="prop-type">{p.type}</td>
						<td class="prop-default">{p.default ?? '—'}</td>
						<td class="prop-desc">{p.description ?? ''}</td>
					</tr>
				))}
			</tbody>
		</table>
	</div>
)}

<style>
	.props-table-wrap {
		margin: var(--space-xl) 0;
		overflow-x: auto;
	}

	.props-eyebrow {
		display: block;
		margin-bottom: 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--color-accent);
	}

	.props-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.82rem;
	}

	.props-table th {
		padding: 0.5rem 0.85rem 0.5rem 0;
		text-align: left;
		font-family: var(--font-mono);
		font-size: 0.65rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-text-muted);
		border-bottom: 1px solid var(--color-border-strong);
	}

	.props-table td {
		padding: 0.6rem 0.85rem 0.6rem 0;
		border-bottom: 1px solid var(--color-border);
		vertical-align: top;
	}

	.prop-name {
		font-family: var(--font-mono);
		font-weight: 600;
		color: var(--color-text);
		white-space: nowrap;
	}

	.prop-type {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		color: var(--color-accent);
		max-width: 26ch;
	}

	.prop-default {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		color: var(--color-text-muted);
		white-space: nowrap;
	}

	.prop-desc {
		color: var(--color-text-secondary);
		min-width: 18ch;
	}
</style>
