---
import { getLearnModules, groupByPhase, moduleHref, courseHomeHref, baseSlug, type Lang } from '../../lib/learn';
import { glossaryHref } from '../../lib/learn-glossary';

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	lang: Lang;
	currentSlug?: string;
	currentHeadings?: Heading[];
}

const { lang, currentSlug, currentHeadings } = Astro.props;
const modules = await getLearnModules(lang);
const phases = groupByPhase(modules);
const es = lang === 'es';
// Sections of the current module (h2 only) for the in-rail page index.
const sections = (currentHeadings ?? []).filter((h) => h.depth === 2);
---

<nav class="learn-sidebar" aria-label={es ? 'Índice del curso' : 'Course index'}>
	<a class="sidebar-home" href={courseHomeHref(lang)}>
		{es ? '← Mapa del curso' : '← Course map'}
	</a>
	<ol class="phase-list">
		{phases.map((p) => (
			<li class="phase">
				<p class="phase-label">
					<span class="phase-num">{String(p.phase).padStart(2, '0')}</span>
					{p.title[lang]}
				</p>
				<ul class="module-list">
					{p.modules.map((m) => {
						const slug = baseSlug(m.id);
						const active = slug === currentSlug;
						return (
							<li>
								<a href={moduleHref(slug, lang)} class:list={[{ active }]} aria-current={active ? 'page' : undefined}>
									{m.data.title}
								</a>
								{active && sections.length > 1 && (
									<ul class="section-list" data-toc>
										{sections.map((s) => (
											<li>
												<a href={`#${s.slug}`} data-toc-link={s.slug}>{s.text}</a>
											</li>
										))}
									</ul>
								)}
							</li>
						);
					})}
				</ul>
			</li>
		))}
	</ol>
	<a class="sidebar-glossary" href={glossaryHref(lang)}>{es ? 'Glosario →' : 'Glossary →'}</a>
</nav>

<script>
	// Scroll-spy: highlight the current module section in the rail.
	function initLearnToc() {
		const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
		if (!links.length) return () => {};
		const byId = new Map(links.map((l) => [l.dataset.tocLink!, l]));
		const heads = Array.from(document.querySelectorAll<HTMLElement>('.article-body h2[id]')).filter((h) => byId.has(h.id));
		if (!heads.length) return () => {};
		let current: HTMLAnchorElement | null = null;
		const setActive = (id: string) => {
			const link = byId.get(id);
			if (!link || link === current) return;
			current?.classList.remove('toc-active');
			current?.removeAttribute('aria-current');
			link.classList.add('toc-active');
			link.setAttribute('aria-current', 'true');
			current = link;
		};
		const obs = new IntersectionObserver(
			(entries) => {
				const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
				if (visible[0]) setActive((visible[0].target as HTMLElement).id);
			},
			{ rootMargin: '-15% 0px -70% 0px', threshold: 0 },
		);
		heads.forEach((h) => obs.observe(h));
		return () => obs.disconnect();
	}
	let cleanupToc = initLearnToc();
	document.addEventListener('astro:before-swap', () => cleanupToc?.());
	document.addEventListener('astro:after-swap', () => {
		cleanupToc = initLearnToc();
	});
</script>

<style>
	.learn-sidebar {
		font-size: 0.9rem;
	}
	.sidebar-home {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-text-secondary);
		text-decoration: none;
		margin-bottom: var(--space-lg);
		transition: color 0.2s var(--ease-spring);
	}
	.sidebar-home:hover { color: var(--color-accent); }

	/* On mobile the course map lives behind a <details> toggle in the layout,
	   so this in-rail "back to map" link would duplicate it. Hide it there;
	   the breadcrumb's "Learn" link still returns to the hub. */
	@media (max-width: 900px) {
		.sidebar-home { display: none; }
	}

	.sidebar-glossary {
		display: inline-block;
		margin-top: var(--space-md);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-accent);
		text-decoration: none;
		transition: opacity 0.2s var(--ease-spring);
	}
	.sidebar-glossary:hover { opacity: 0.75; }

	.phase-list { list-style: none; margin: 0; padding: 0; }
	.phase { margin-bottom: var(--space-lg); }

	.phase-label {
		display: flex;
		align-items: baseline;
		gap: 0.5em;
		margin: 0 0 0.5em;
		font-family: var(--font-mono);
		font-size: 0.66rem;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--color-text-secondary);
		line-height: 1.4;
	}
	.phase-num { color: var(--color-accent); font-weight: 600; }

	.module-list { list-style: none; margin: 0; padding: 0; }
	.module-list li { margin: 0; }
	.module-list a {
		display: block;
		padding: 0.32em 0.6em;
		border-radius: var(--radius-sm);
		color: var(--color-text-secondary);
		text-decoration: none;
		line-height: 1.35;
		transition: color 0.18s var(--ease-spring), background 0.18s var(--ease-spring);
	}
	.module-list a:hover { color: var(--color-text); background: var(--color-accent-subtle); }
	.module-list a.active {
		color: var(--color-accent);
		background: var(--color-accent-subtle);
		font-weight: 500;
	}

	/* In-rail page index: the active module's sections (h2). Active state uses
	   the same tinted-wash + accent-text mechanism as the module links — no
	   left accent bar (design-system hard rule). */
	.section-list {
		list-style: none;
		margin: 0.15em 0 0.5em;
		padding: 0 0 0 1.5em;
		font-size: 0.82rem;
	}
	.section-list a {
		display: block;
		padding: 0.24em 0.6em;
		border-radius: var(--radius-sm);
		color: var(--color-text-secondary);
		text-decoration: none;
		line-height: 1.3;
		transition: color 0.18s var(--ease-spring), background 0.18s var(--ease-spring);
	}
	.section-list a:hover { color: var(--color-text); background: var(--color-accent-subtle); }
	.section-list a.toc-active {
		color: var(--color-accent);
		background: var(--color-accent-subtle);
		font-weight: 500;
	}

	/* Mobile: the rail becomes a tapped-open card, so grow the touch targets to
	   the 44px WCAG minimum and bump the body size for thumb reading. */
	@media (max-width: 900px) {
		.learn-sidebar { font-size: 0.95rem; }
		.module-list a {
			display: flex;
			align-items: center;
			min-height: 44px;
			padding: 0.5em 0.7em;
		}
		.section-list a { min-height: 40px; display: flex; align-items: center; }
	}
</style>
