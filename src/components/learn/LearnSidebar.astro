---
import { getLearnModules, groupByPhase, moduleHref, courseHomeHref, baseSlug, type Lang } from '../../lib/learn';
import { glossaryHref } from '../../lib/learn-glossary';

interface Props {
	lang: Lang;
	currentSlug?: string;
}

const { lang, currentSlug } = Astro.props;
const modules = await getLearnModules(lang);
const phases = groupByPhase(modules);
const es = lang === 'es';

// Flatten the phase grouping into a single 01–16 reading order. The phase stays
// only as a lightweight divider label; modules carry a global number that lines
// up with the header's "Module N of NN". This removes the Phase→Module nesting
// level (and the "folder with one file" feel of single-module phases).
let counter = 0;
const numberedPhases = phases.map((p) => ({
	title: p.title,
	phase: p.phase,
	modules: p.modules.map((m) => ({ entry: m, num: ++counter })),
}));
const total = counter;
---

<nav class="learn-sidebar" aria-label={es ? 'Índice del curso' : 'Course index'}>
	<a class="sidebar-home" href={courseHomeHref(lang)}>
		{es ? '← Mapa del curso' : '← Course map'}
	</a>
	<ol class="phase-list">
		{numberedPhases.map((p, i) => (
			<li class="phase" class:list={[{ first: i === 0 }]}>
				<p class="phase-label">{p.title[lang]}</p>
				<ul class="module-list">
					{p.modules.map(({ entry, num }) => {
						const slug = baseSlug(entry.id);
						const active = slug === currentSlug;
						return (
							<li>
								<a href={moduleHref(slug, lang)} class:list={[{ active }]} aria-current={active ? 'page' : undefined}>
									<span class="mod-num">{String(num).padStart(2, '0')}</span>
									<span class="mod-title">{entry.data.title}</span>
								</a>
							</li>
						);
					})}
				</ul>
			</li>
		))}
	</ol>
	<a class="sidebar-glossary" href={glossaryHref(lang)}>{es ? 'Glosario →' : 'Glossary →'}</a>
</nav>

<style>
	.learn-sidebar {
		font-size: 0.9rem;
	}
	.sidebar-home {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-text-secondary);
		text-decoration: none;
		margin-bottom: var(--space-lg);
		transition: color 0.2s var(--ease-spring);
	}
	.sidebar-home:hover { color: var(--color-accent); }

	/* On mobile the course map lives behind a <details> toggle in the layout,
	   so this in-rail "back to map" link would duplicate it. Hide it there;
	   the breadcrumb's "Learn" link still returns to the hub. */
	@media (max-width: 900px) {
		.sidebar-home { display: none; }
	}

	.sidebar-glossary {
		display: inline-block;
		margin-top: var(--space-lg);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-accent);
		text-decoration: none;
		transition: opacity 0.2s var(--ease-spring);
	}
	.sidebar-glossary:hover { opacity: 0.75; }

	.phase-list { list-style: none; margin: 0; padding: 0; }

	/* Phase = a lightweight divider, not a nesting container. A hairline top rule
	   separates groups (design-system mechanism #3) — no boxes, no left bars. */
	.phase { margin: 0; padding-top: var(--space-md); }
	.phase:not(.first) {
		margin-top: var(--space-md);
		border-top: 1px solid var(--color-border);
	}
	.phase.first { padding-top: 0; }

	.phase-label {
		margin: 0 0 0.55em;
		font-family: var(--font-mono);
		font-size: 0.64rem;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--color-text-secondary);
		line-height: 1.45;
	}

	.module-list { list-style: none; margin: 0; padding: 0; }
	.module-list li { margin: 0; }
	.module-list a {
		display: grid;
		grid-template-columns: 1.7em 1fr;
		align-items: baseline;
		gap: 0.1em;
		padding: 0.42em 0.6em;
		border-radius: var(--radius-sm);
		color: var(--color-text-secondary);
		text-decoration: none;
		line-height: 1.35;
		transition: color 0.18s var(--ease-spring), background 0.18s var(--ease-spring);
	}
	.mod-num {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--color-text-tertiary, var(--color-text-secondary));
		opacity: 0.7;
		transition: color 0.18s var(--ease-spring), opacity 0.18s var(--ease-spring);
	}
	.module-list a:hover { color: var(--color-text); background: var(--color-accent-subtle); }
	.module-list a:hover .mod-num { opacity: 1; }
	.module-list a.active {
		color: var(--color-accent);
		background: var(--color-accent-subtle);
		font-weight: 500;
	}
	.module-list a.active .mod-num { color: var(--color-accent); opacity: 1; }

	/* Mobile: the rail becomes a tapped-open card, so grow the touch targets to
	   the 44px WCAG minimum and bump the body size for thumb reading. */
	@media (max-width: 900px) {
		.learn-sidebar { font-size: 0.95rem; }
		.module-list a {
			min-height: 44px;
			align-items: center;
			padding: 0.5em 0.7em;
		}
	}
</style>
