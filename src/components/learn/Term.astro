---
import { findTerm, glossaryHref, type Lang } from '../../lib/learn-glossary';

interface Props {
	/** Canonical glossary term to look up (case-insensitive). */
	name: string;
	/** Page language — pass lang="es" inside Spanish modules. Defaults to en. */
	lang?: Lang;
}

const { name, lang = 'en' } = Astro.props;
const es = lang === 'es';
const entry = findTerm(name);
// If the term isn't in the glossary, render the text plainly (fail open).
const def = entry?.def[lang] ?? '';
const href = entry ? `${glossaryHref(lang)}#${entry.slug}` : glossaryHref(lang);

// WHITESPACE: this component renders inline, mid-sentence. Any whitespace text
// node it emits (between tags, or between the markup and the <style>/<script>
// blocks below) shows up as a space before the punctuation that follows the
// term ("reducer :"). So the markup is one line and the blocks are glued on.
---
{entry ? (<span class="gloss"><button type="button" class="gloss-term" aria-expanded="false"><slot>{name}</slot></button><span class="gloss-pop"><span class="gloss-def">{def}</span><a class="gloss-more" href={href}>{es ? 'glosario →' : 'glossary →'}</a></span></span>) : (<slot>{name}</slot>)}<style>
	.gloss { position: relative; display: inline; }
	.gloss-term {
		font: inherit;
		color: inherit;
		background: none;
		border: 0;
		padding: 0;
		cursor: help;
		text-decoration: underline dotted;
		text-decoration-color: var(--color-accent);
		text-underline-offset: 3px;
	}
	.gloss-pop {
		/* Positioned with JS (position: fixed) so it can be clamped to the
		   viewport and never overflows off-screen near the edges. */
		position: fixed;
		top: 0;
		left: 0;
		z-index: 40;
		width: max-content;
		max-width: min(22rem, calc(100vw - 1.5rem));
		padding: 0.7em 0.85em;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-lg);
		font-size: 0.86rem;
		line-height: 1.5;
		color: var(--color-text-secondary);
		opacity: 0;
		visibility: hidden;
		transform: translateY(4px);
		transition: opacity 0.16s var(--ease-smooth), transform 0.16s var(--ease-spring), visibility 0.16s;
	}
	.gloss-pop.is-open {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}
	.gloss-def { display: block; }
	.gloss-more {
		display: inline-block;
		margin-top: 0.45em;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-accent);
		text-decoration: none;
	}
</style><script>
	// Disclosure pattern: the term is a button (aria-expanded + aria-controls)
	// that shows a definition panel with a link to the glossary. Mouse hover
	// previews it; click/Enter pins it; Tab moves into the link without closing
	// it; Escape closes it and returns focus to the term. The panel is
	// fixed-positioned and clamped to the viewport by JS.
	const MARGIN = 12; // min gap to the viewport edge
	const GAP = 8; // gap between the term and the panel
	const CLOSE_DELAY = 150; // ms grace period to cross the gap with the mouse

	let glossController: AbortController | null = null;
	let glossSeq = 0;
	const closeTimers = new WeakMap<HTMLElement, number>();

	const termOf = (g: HTMLElement) => g.querySelector<HTMLButtonElement>('.gloss-term');
	const popOf = (g: HTMLElement) => g.querySelector<HTMLElement>('.gloss-pop');

	function placePop(gloss: HTMLElement) {
		const btn = termOf(gloss);
		const pop = popOf(gloss);
		if (!btn || !pop) return;
		const r = btn.getBoundingClientRect();
		const pr = pop.getBoundingClientRect();
		// Horizontal: align with the term, then clamp inside the viewport.
		let left = r.left;
		const maxLeft = window.innerWidth - pr.width - MARGIN;
		if (left > maxLeft) left = maxLeft;
		if (left < MARGIN) left = MARGIN;
		// Vertical: prefer above the term; drop below if there's no room.
		let top = r.top - pr.height - GAP;
		if (top < MARGIN) top = r.bottom + GAP;
		pop.style.left = `${Math.round(left)}px`;
		pop.style.top = `${Math.round(top)}px`;
	}

	function cancelClose(gloss: HTMLElement) {
		const t = closeTimers.get(gloss);
		if (t !== undefined) {
			window.clearTimeout(t);
			closeTimers.delete(gloss);
		}
	}

	function closeGloss(gloss: HTMLElement) {
		cancelClose(gloss);
		delete gloss.dataset.pinned;
		gloss.classList.remove('is-open');
		popOf(gloss)?.classList.remove('is-open');
		termOf(gloss)?.setAttribute('aria-expanded', 'false');
	}

	function closeAll(except?: Element | null) {
		document.querySelectorAll<HTMLElement>('.gloss.is-open').forEach((g) => {
			if (g !== except) closeGloss(g);
		});
	}

	function openGloss(gloss: HTMLElement, pin = false) {
		cancelClose(gloss);
		closeAll(gloss);
		if (pin) gloss.dataset.pinned = '1';
		if (gloss.classList.contains('is-open')) return;
		placePop(gloss);
		gloss.classList.add('is-open');
		popOf(gloss)?.classList.add('is-open');
		termOf(gloss)?.setAttribute('aria-expanded', 'true');
	}

	function scheduleClose(gloss: HTMLElement) {
		if (gloss.dataset.pinned) return;
		cancelClose(gloss);
		closeTimers.set(gloss, window.setTimeout(() => closeGloss(gloss), CLOSE_DELAY));
	}

	function initGlossTerms() {
		glossController?.abort();
		const controller = new AbortController();
		glossController = controller;
		const { signal } = controller;

		const glosses = document.querySelectorAll<HTMLElement>('.gloss');
		if (!glosses.length) return;

		glosses.forEach((gloss) => {
			const btn = termOf(gloss);
			const pop = popOf(gloss);
			if (!btn || !pop) return;
			if (!pop.id) pop.id = `gloss-pop-${++glossSeq}`;
			btn.setAttribute('aria-controls', pop.id);

			// Click / Enter / Space toggles a pinned panel. If a hover preview is
			// already showing, the click pins it instead of closing it.
			btn.addEventListener(
				'click',
				(e) => {
					e.preventDefault();
					if (gloss.classList.contains('is-open') && gloss.dataset.pinned) closeGloss(gloss);
					else openGloss(gloss, true);
				},
				{ signal },
			);
			// Mouse hover previews; touch and pen go through click only.
			gloss.addEventListener(
				'pointerenter',
				(e) => {
					if (e.pointerType === 'mouse') openGloss(gloss);
				},
				{ signal },
			);
			gloss.addEventListener(
				'pointerleave',
				(e) => {
					if (e.pointerType === 'mouse') scheduleClose(gloss);
				},
				{ signal },
			);
			// Close only when focus leaves the term *and* its panel.
			gloss.addEventListener(
				'focusout',
				(e) => {
					const next = e.relatedTarget as Node | null;
					if (next && gloss.contains(next)) return;
					closeGloss(gloss);
				},
				{ signal },
			);
		});

		// Outside click, Escape, and scroll/resize (the panel is fixed, so it
		// would drift away from its term).
		document.addEventListener(
			'click',
			(e) => {
				if (!(e.target as HTMLElement).closest?.('.gloss')) closeAll();
			},
			{ signal },
		);
		document.addEventListener(
			'keydown',
			(e) => {
				if (e.key !== 'Escape') return;
				const active = document.activeElement as HTMLElement | null;
				const owner = active?.closest<HTMLElement>('.gloss.is-open') ?? null;
				closeAll();
				if (owner) termOf(owner)?.focus();
			},
			{ signal },
		);
		const dismiss = () => closeAll();
		window.addEventListener('scroll', dismiss, { passive: true, signal });
		window.addEventListener('resize', dismiss, { passive: true, signal });
	}

	function teardownGlossTerms() {
		glossController?.abort();
		glossController = null;
	}

	initGlossTerms();
	document.addEventListener('astro:page-load', initGlossTerms);
	document.addEventListener('astro:before-swap', teardownGlossTerms);
</script>
