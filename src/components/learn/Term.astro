---
import { findTerm, glossaryHref, type Lang } from '../../lib/learn-glossary';

interface Props {
	/** Canonical glossary term to look up (case-insensitive). */
	name: string;
	/** Page language — pass lang="es" inside Spanish modules. Defaults to en. */
	lang?: Lang;
}

const { name, lang = 'en' } = Astro.props;
const es = lang === 'es';
const entry = findTerm(name);
// If the term isn't in the glossary, render the text plainly (fail open).
const def = entry?.def[lang] ?? '';
const href = entry ? `${glossaryHref(lang)}#${entry.slug}` : glossaryHref(lang);
---

{entry ? (
	<span class="gloss">
		<button type="button" class="gloss-term" aria-expanded="false">
			<slot>{name}</slot>
		</button>
		<span class="gloss-pop" role="tooltip">
			<span class="gloss-def">{def}</span>
			<a class="gloss-more" href={href}>{es ? 'glosario →' : 'glossary →'}</a>
		</span>
	</span>
) : (
	<slot>{name}</slot>
)}

<style>
	.gloss { position: relative; display: inline; }
	.gloss-term {
		font: inherit;
		color: inherit;
		background: none;
		border: 0;
		padding: 0;
		cursor: help;
		text-decoration: underline dotted;
		text-decoration-color: var(--color-accent);
		text-underline-offset: 3px;
	}
	.gloss-pop {
		/* Positioned with JS (position: fixed) so it can be clamped to the
		   viewport and never overflows off-screen near the edges. */
		position: fixed;
		top: 0;
		left: 0;
		z-index: 40;
		width: max-content;
		max-width: min(22rem, calc(100vw - 1.5rem));
		padding: 0.7em 0.85em;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-lg);
		font-size: 0.86rem;
		line-height: 1.5;
		color: var(--color-text-secondary);
		opacity: 0;
		visibility: hidden;
		transform: translateY(4px);
		transition: opacity 0.16s var(--ease-smooth), transform 0.16s var(--ease-spring), visibility 0.16s;
	}
	.gloss-pop.is-open {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}
	.gloss-def { display: block; }
	.gloss-more {
		display: inline-block;
		margin-top: 0.45em;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-accent);
		text-decoration: none;
	}
</style>

<script>
	// The popover is fixed-positioned and placed/clamped by JS so it never
	// overflows the viewport — on hover (desktop), focus (keyboard), or tap (touch).
	const MARGIN = 12; // min gap to the viewport edge
	const GAP = 8; // gap between the term and the popover

	function placePop(gloss: HTMLElement) {
		const btn = gloss.querySelector<HTMLElement>('.gloss-term');
		const pop = gloss.querySelector<HTMLElement>('.gloss-pop');
		if (!btn || !pop) return;
		const r = btn.getBoundingClientRect();
		const pr = pop.getBoundingClientRect();
		// Horizontal: align with the term, then clamp inside the viewport.
		let left = r.left;
		const maxLeft = window.innerWidth - pr.width - MARGIN;
		if (left > maxLeft) left = maxLeft;
		if (left < MARGIN) left = MARGIN;
		// Vertical: prefer above the term; drop below if there's no room.
		let top = r.top - pr.height - GAP;
		if (top < MARGIN) top = r.bottom + GAP;
		pop.style.left = `${Math.round(left)}px`;
		pop.style.top = `${Math.round(top)}px`;
	}

	function closeAll(except?: Element | null) {
		document.querySelectorAll<HTMLElement>('.gloss.is-open').forEach((g) => {
			if (g === except) return;
			g.classList.remove('is-open');
			g.querySelector('.gloss-pop')?.classList.remove('is-open');
			g.querySelector('.gloss-term')?.setAttribute('aria-expanded', 'false');
		});
	}

	function openGloss(gloss: HTMLElement) {
		closeAll(gloss);
		placePop(gloss);
		gloss.classList.add('is-open');
		gloss.querySelector('.gloss-pop')?.classList.add('is-open');
		gloss.querySelector('.gloss-term')?.setAttribute('aria-expanded', 'true');
	}

	function closeGloss(gloss: HTMLElement) {
		gloss.classList.remove('is-open');
		gloss.querySelector('.gloss-pop')?.classList.remove('is-open');
		gloss.querySelector('.gloss-term')?.setAttribute('aria-expanded', 'false');
	}

	function initGlossTerms() {
		document.querySelectorAll<HTMLElement>('.gloss').forEach((gloss) => {
			if (gloss.dataset.bound) return;
			gloss.dataset.bound = '1';
			const btn = gloss.querySelector<HTMLButtonElement>('.gloss-term');
			if (!btn) return;
			// Tap / click toggles (primary path on touch, where there's no hover).
			btn.addEventListener('click', (e) => {
				e.preventDefault();
				if (gloss.classList.contains('is-open')) closeGloss(gloss);
				else openGloss(gloss);
			});
			// Hover (desktop) and keyboard focus.
			gloss.addEventListener('mouseenter', () => openGloss(gloss));
			gloss.addEventListener('mouseleave', () => closeGloss(gloss));
			btn.addEventListener('focus', () => openGloss(gloss));
			btn.addEventListener('blur', () => closeGloss(gloss));
		});
		if (!(document as any)._glossDismiss) {
			(document as any)._glossDismiss = true;
			// Dismiss on outside click, on Escape, and reposition on scroll/resize.
			document.addEventListener('click', (e) => {
				if (!(e.target as HTMLElement).closest?.('.gloss')) closeAll();
			});
			document.addEventListener('keydown', (e) => {
				if ((e as KeyboardEvent).key === 'Escape') closeAll();
			});
			const reposition = () => closeAll();
			window.addEventListener('scroll', reposition, { passive: true });
			window.addEventListener('resize', reposition, { passive: true });
		}
	}
	initGlossTerms();
	document.addEventListener('astro:after-swap', initGlossTerms);
</script>
