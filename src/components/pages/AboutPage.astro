---
import BaseHead from '../BaseHead.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import { SITE_TITLE, SOCIAL_LINKS, PERSON_ID, personWithProperties, webPropertyNodes, UI_STRINGS } from '../../consts';
import { ABOUT_CONTENT, ABOUT_PHOTO, FEATURED_CERT_SHARED, type AboutLocale } from '../../data/about';

interface Props {
	lang: AboutLocale;
}

const { lang } = Astro.props;
const strings = UI_STRINGS[lang];
const content = ABOUT_CONTENT[lang];

const pageUrl = lang === 'es' ? 'https://valdemird.com/es/about/' : 'https://valdemird.com/about/';
const postHref = (slug: string) => (lang === 'es' ? `/blog/es/${slug}/` : `/blog/${slug}/`);
const labHref = lang === 'es' ? '/es/lab/' : '/lab/';

// ProfilePage + enriched canonical Person — the E-E-A-T trust anchor.
const aboutPerson = {
	...personWithProperties(),
	address: { '@type': 'PostalAddress', addressLocality: 'Cali', addressCountry: 'CO' },
	knowsLanguage: ['en', 'es'],
	alumniOf: [{ '@type': 'CollegeOrUniversity', name: 'Universidad del Valle' }],
	image: `https://valdemird.com${ABOUT_PHOTO.src}`,
	hasCredential: [
		{
			'@type': 'EducationalOccupationalCredential',
			credentialCategory: 'certification',
			name: FEATURED_CERT_SHARED.name,
			recognizedBy: { '@type': 'Organization', name: 'Anthropic' },
			url: FEATURED_CERT_SHARED.verifyUrl,
			dateCreated: FEATURED_CERT_SHARED.issuedISO,
		},
		{ '@type': 'EducationalOccupationalCredential', credentialCategory: 'certification', name: 'AWS Certified Cloud Practitioner' },
	],
};
const aboutJsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'ProfilePage',
			'@id': `${pageUrl}#profilepage`,
			url: pageUrl,
			name: `${strings.about.title} | ${SITE_TITLE}`,
			inLanguage: lang,
			isPartOf: { '@id': 'https://valdemird.com/#website' },
			mainEntity: { '@id': PERSON_ID },
		},
		aboutPerson,
		...webPropertyNodes(),
	],
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={`${strings.about.title} | ${SITE_TITLE}`} description={strings.about.description} image={lang === 'es' ? '/og/default-es.png' : undefined} lang={lang} jsonLd={aboutJsonLd} alternates={[
			{ hreflang: 'en', href: 'https://valdemird.com/about/' },
			{ hreflang: 'es', href: 'https://valdemird.com/es/about/' },
		]} />
	</head>
	<body>
		<a class="skip-link" href="#main-content">{strings.nav.skipToContent}</a>
		<Header />
		<main id="main-content">
			<div class="about-hero">
				<div class="about-hero-bg" aria-hidden="true">
					<div class="hero-grid"></div>
					<div class="hero-orb orb-1"></div>
					<div class="hero-orb orb-2"></div>
				</div>
				<div class="about-hero-content animate-fade-in">
					<div class="about-hero-text">
						<span class="about-label">{content.heroLabel}</span>
						<h1>{content.identityLine}</h1>
						<p class="about-subtitle">{content.heroMeta}</p>
					</div>
					<img
						class="about-photo"
						src={ABOUT_PHOTO.src}
						width={ABOUT_PHOTO.width}
						height={ABOUT_PHOTO.height}
						alt={content.photoAlt}
						loading="eager"
						decoding="async"
					/>
				</div>
			</div>

			<article class="about-body">
				<!-- Quick-scan band -->
				<section class="section animate-fade-in delay-1">
					<dl class="facts-band">
						{content.quickFacts.map((f) => (
							<div class="fact">
								<dt>{f.label}</dt>
								<dd>{f.value}</dd>
							</div>
						))}
					</dl>
				</section>

				<!-- Narrative -->
				<section class="section narrative animate-fade-in delay-2">
					{content.narrative.map((paragraph, i) => (
						<>
							<p set:html={paragraph} />
							{i === content.pivotAfter && <p class="pivot-line">{content.pivotLine}</p>}
						</>
					))}
				</section>

				<!-- Now -->
				<section class="section">
					<div class="section-header">
						<span class="section-label">01</span>
						<h2>{content.sections.now}</h2>
						<div class="section-line"></div>
					</div>
					<span class="now-updated">{content.now.updatedDisplay}</span>
					<ul class="now-list">
						{content.now.items.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</section>

				<!-- Tech domains as card grid -->
				<section class="section">
					<div class="section-header">
						<span class="section-label">02</span>
						<h2>{content.sections.tech}</h2>
						<div class="section-line"></div>
					</div>
					<div class="domains-grid">
						{content.techDomains.map((d) => (
							<div class="domain-card" style={`--domain-accent: ${d.accent};`}>
								<h3>{d.domain}</h3>
								<div class="domain-tools">
									{d.tools.map((tool) => (
										<span class="domain-tool">{tool}</span>
									))}
								</div>
							</div>
						))}
					</div>
				</section>

				<!-- Journey -->
				<section class="section">
					<div class="section-header">
						<span class="section-label">03</span>
						<h2>{content.sections.journey}</h2>
						<div class="section-line"></div>
					</div>
					<div class="journey">
						{content.timeline.map((item) => (
							<div class:list={['journey-row', { active: item.active }]}>
								<span class="journey-year">{item.year}</span>
								<div class="journey-main">
									<h3 class="journey-title">
										{item.title} <span class="journey-place">· {item.place}</span>
									</h3>
									<p class="journey-desc">{item.desc}</p>
								</div>
							</div>
						))}
					</div>
				</section>

				<!-- Beliefs + living proof -->
				<section class="section">
					<div class="section-header">
						<span class="section-label">04</span>
						<h2>{content.sections.beliefs}</h2>
						<div class="section-line"></div>
					</div>
					<div class="beliefs">
						{content.beliefs.map((b) => (
							<div class="belief">
								<h3>{b.title}</h3>
								<p>{b.desc}</p>
								<a class="belief-link" href={postHref(b.postSlug)}>{b.linkLabel}</a>
							</div>
						))}
					</div>
				</section>

				<!-- Background & credentials -->
				<section class="section">
					<div class="section-header">
						<span class="section-label">05</span>
						<h2>{content.sections.proof}</h2>
						<div class="section-line"></div>
					</div>
					<div class="credential-band">
						<span class="credential-eyebrow">{content.credentialEyebrow}</span>
						<h3 class="credential-name">{FEATURED_CERT_SHARED.name}</h3>
						<p class="credential-meta">{content.featuredCert.issuedDisplay}</p>
						<p class="credential-blurb">{content.featuredCert.blurb}</p>
						<a class="credential-verify" href={FEATURED_CERT_SHARED.verifyUrl} target="_blank" rel="noopener noreferrer">
							{content.featuredCert.verifyLabel}
						</a>
					</div>
					<div class="certs proof-list">
						{[...content.certs, ...content.education].map((item) => (
							<div class="cert-item">
								<span class="cert-year">{item.year}</span>
								<span class="cert-name">{item.name}</span>
							</div>
						))}
					</div>
				</section>

				<!-- Closing -->
				<section class="section">
					<div class="section-header">
						<span class="section-label">06</span>
						<h2>{content.sections.contact}</h2>
						<div class="section-line"></div>
					</div>
					<p class="closing" set:html={content.closing} />
					<div class="start-here">
						<span class="start-here-label">{content.sections.startHere}</span>
						<ul class="start-here-list">
							{content.startHere.map((p) => (
								<li><a href={postHref(p.slug)}>{p.title}</a></li>
							))}
						</ul>
						<a class="start-here-lab" href={labHref}>{content.labCta}</a>
					</div>
					<div class="contact-links">
						{SOCIAL_LINKS.github && (
							<a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer" class="contact-link">
								<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
								<span>GitHub</span>
							</a>
						)}
						{SOCIAL_LINKS.linkedin && (
							<a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer" class="contact-link">
								<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
								<span>LinkedIn</span>
							</a>
						)}
						{SOCIAL_LINKS.devto && (
							<a href={SOCIAL_LINKS.devto} target="_blank" rel="noopener noreferrer" class="contact-link">
								<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M7.42 10.05c-.18-.16-.46-.23-.84-.23H6l.02 2.44.04 2.45.56-.02c.41 0 .63-.07.83-.26.24-.24.26-.36.26-2.2 0-1.91-.02-1.96-.29-2.18zM0 4.94v14.12h24V4.94H0zM8.56 15.3c-.44.58-1.06.77-2.53.77H4.71V8.53h1.4c1.67 0 2.16.18 2.6.9.27.43.29.6.32 2.57.05 2.23-.02 2.73-.47 3.3zm5.09-5.47h-2.47v1.77h1.52v1.28l-.72.04-.75.03v1.77l1.22.03 1.2.04v1.28h-1.6c-1.53 0-1.6-.01-1.87-.3l-.3-.28v-3.16c0-3.02.01-3.18.25-3.48.23-.31.25-.31 1.88-.31h1.64v1.3zm4.68 5.45c-.17.43-.64.79-1 .79-.18 0-.45-.15-.67-.39-.32-.32-.45-.63-.82-2.08l-.9-3.39-.45-1.67h.76c.4 0 .75.02.75.05 0 .06 1.16 4.54 1.26 4.83.04.15.32-.7.73-2.3l.66-2.52.74-.04c.4-.02.73 0 .73.04 0 .14-1.67 6.38-1.8 6.68z"/></svg>
								<span>DEV</span>
							</a>
						)}
					</div>
				</section>
			</article>
		</main>

		<script>
			import {
				initPageEntrance,
				initScrollReveals,
				initStaggeredReveal,
				cleanupAll,
				isReducedMotion,
			} from '../../lib/animations';

			function initAbout() {
				if (isReducedMotion()) return;
				const isVT = document.documentElement.hasAttribute('data-vt-nav');
				if (!isVT) {
					initPageEntrance('.about-hero-content.animate-fade-in');
				}
				initScrollReveals('.section:not(.animate-fade-in)');
				initStaggeredReveal('.domains-grid', '.domain-card');
				initStaggeredReveal('.journey', '.journey-row');
				initStaggeredReveal('.beliefs', '.belief');
				initStaggeredReveal('.proof-list', '.cert-item');
			}
			function initAndCleanup() {
				initAbout();
				document.addEventListener('astro:before-swap', cleanupAll, { once: true });
			}
			initAndCleanup();
			document.addEventListener('astro:after-swap', initAndCleanup);
		</script>
		<Footer />
	</body>
</html>

<style>
	main { max-width: var(--full-width); margin: 0 auto; padding: 0; }

	.about-hero { position: relative; padding: 3.25rem var(--space-lg) 2rem; overflow: hidden; }
	.about-hero-bg { position: absolute; inset: 0; z-index: 0; }
	.hero-grid { position: absolute; inset: 0; background-image: linear-gradient(var(--color-border) 1px, transparent 1px), linear-gradient(90deg, var(--color-border) 1px, transparent 1px); background-size: 48px 48px; opacity: 0.25; mask-image: radial-gradient(ellipse 70% 80% at 50% 60%, black 10%, transparent 70%); -webkit-mask-image: radial-gradient(ellipse 70% 80% at 50% 60%, black 10%, transparent 70%); }
	.hero-orb { position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.1; animation: orbFloat 20s ease-in-out infinite; }
	.orb-1 { width: 300px; height: 300px; top: -20%; right: 10%; background: var(--color-accent); }
	.orb-2 { width: 200px; height: 200px; bottom: -10%; left: 20%; background: var(--color-success); animation-delay: -7s; }
	@keyframes orbFloat { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(20px, -15px) scale(1.05); } }

	.about-hero-content { position: relative; z-index: 1; max-width: var(--content-width); margin: 0 auto; display: flex; align-items: center; gap: 2rem; }
	.about-hero-text { flex: 1; min-width: 0; }
	.about-label { font-family: var(--font-mono); font-size: 0.72rem; font-weight: 500; color: var(--color-accent); letter-spacing: 0.08em; text-transform: uppercase; display: block; margin-bottom: 0.6rem; }
	.about-hero-content h1 { font-size: clamp(1.8rem, 4.5vw, 2.4rem); margin-bottom: 0.35em; }
	.about-subtitle { font-family: var(--font-mono); font-size: 0.78rem; color: var(--color-text-secondary); margin: 0; letter-spacing: 0.02em; }

	.about-photo { width: 148px; height: 148px; object-fit: cover; border-radius: var(--radius-lg); border: 1px solid var(--color-border); box-shadow: var(--shadow-md); flex-shrink: 0; }

	.about-body { max-width: var(--content-width); margin: 0 auto; padding: 0 var(--space-lg) 3rem; }

	.section { margin-bottom: 2.5rem; opacity: 0; transform: translateY(24px); transition: opacity 0.7s var(--ease-smooth), transform 0.7s var(--ease-smooth); }
	.section.visible, .section.animate-fade-in { opacity: 1; transform: translateY(0); }
	@media (prefers-reduced-motion: reduce) {
		.section { opacity: 1; transform: none; }
	}
	.section-header { display: flex; align-items: center; gap: var(--space-md); margin-bottom: 1.15rem; }
	.section-label { font-family: var(--font-mono); font-size: 0.75rem; font-weight: 500; color: var(--color-accent); opacity: 0.6; letter-spacing: 0.05em; }
	.section-header h2 { margin: 0; white-space: nowrap; }
	.section-line { flex: 1; height: 1px; background: linear-gradient(90deg, var(--color-border), transparent); }

	/* ---- Quick-scan band ---- */
	.facts-band { display: flex; flex-wrap: wrap; gap: 0.8rem 1.75rem; margin: 0; padding: 0.8rem 0; border-block: 1px solid var(--color-border); }
	.fact { display: flex; flex-direction: column; gap: 0.2rem; }
	.fact dt { font-family: var(--font-mono); font-size: 0.62rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.14em; color: var(--color-text-muted); }
	.fact dd { margin: 0; font-family: var(--font-mono); font-size: 0.8rem; color: var(--color-text); }

	/* ---- Narrative ---- */
	.narrative p { font-size: 0.98rem; line-height: 1.7; margin-bottom: 1em; }
	.pivot-line { font-family: var(--font-serif); font-style: italic; font-size: 1.2rem; line-height: 1.5; color: var(--color-text); padding-left: 1.75em; margin: 1.2em 0; }

	/* ---- Now ---- */
	.now-updated { display: inline-block; font-family: var(--font-mono); font-size: 0.66rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.14em; color: var(--color-accent); margin-bottom: 0.6rem; }
	.now-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
	.now-list li { font-size: 0.9rem; line-height: 1.55; color: var(--color-text-secondary); padding: 0.5rem 0; border-top: 1px solid var(--color-border); }
	.now-list li:last-child { border-bottom: 1px solid var(--color-border); }

	/* ---- Tech domain cards ---- */
	.domains-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.8rem; }

	.domain-card {
		padding: 1rem 1.1rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: oklch(from var(--domain-accent) l c h / 0.045);
		transition: transform var(--duration-normal) var(--ease-spring), box-shadow var(--duration-normal) var(--ease-smooth);
	}
	:global([data-theme='dark']) .domain-card { background: oklch(from var(--domain-accent) l c h / 0.085); }

	.domain-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }

	.domain-card h3 {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		color: var(--domain-accent);
		margin: 0 0 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.14em;
	}

	.domain-tools { display: flex; flex-wrap: wrap; gap: 0.35rem; }

	.domain-tool {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		padding: 0.2em 0.55em;
		background: var(--color-bg-secondary);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		color: var(--color-text-secondary);
		transition: border-color var(--duration-fast) var(--ease-smooth), color var(--duration-fast) var(--ease-smooth);
	}

	.domain-card:hover .domain-tool { border-color: var(--color-border-strong); color: var(--color-text); }

	/* ---- Journey rows ---- */
	.journey { display: flex; flex-direction: column; }
	.journey-row { display: grid; grid-template-columns: 104px 1fr; gap: 1.1rem; padding: 0.7rem 0.5rem; border-top: 1px solid var(--color-border); }
	.journey-row:last-child { border-bottom: 1px solid var(--color-border); }
	.journey-row.active { background: oklch(from var(--color-accent) l c h / 0.045); }
	:global([data-theme='dark']) .journey-row.active { background: oklch(from var(--color-accent) l c h / 0.085); }
	.journey-year { font-family: var(--font-mono); font-size: 0.72rem; font-weight: 600; color: var(--color-text-muted); padding-top: 0.2rem; }
	.journey-row.active .journey-year { color: var(--color-accent); }
	.journey-title { font-family: var(--font-sans); font-size: 0.98rem; font-weight: 600; color: var(--color-text); margin: 0 0 0.2em; }
	.journey-place { font-family: var(--font-mono); font-size: 0.72rem; font-weight: 400; color: var(--color-text-muted); }
	.journey-desc { font-size: 0.88rem; color: var(--color-text-secondary); margin: 0; line-height: 1.55; }

	/* ---- Beliefs ---- */
	.beliefs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.8rem; }
	.belief { display: flex; flex-direction: column; gap: 0.35rem; padding: 1rem 1.1rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); transition: border-color var(--duration-normal) var(--ease-smooth), transform var(--duration-normal) var(--ease-spring), box-shadow var(--duration-normal) var(--ease-smooth); }
	.belief:hover { border-color: var(--color-accent); transform: translateY(-2px); box-shadow: var(--shadow-md); }
	.belief h3 { font-size: 1rem; margin: 0; }
	.belief p { font-size: 0.85rem; margin: 0; color: var(--color-text-secondary); line-height: 1.5; flex: 1; }
	.belief-link { font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-accent); text-decoration: none; margin-top: 0.35rem; }
	.belief-link:hover { color: var(--color-accent-hover); text-decoration: underline; }

	/* ---- Credential band ---- */
	.credential-band { padding: 1.1rem 1rem; margin-bottom: 1rem; border-block: 1px solid var(--color-border); background: oklch(from var(--color-accent) l c h / 0.045); }
	:global([data-theme='dark']) .credential-band { background: oklch(from var(--color-accent) l c h / 0.085); }
	.credential-eyebrow { display: block; font-family: var(--font-mono); font-size: 0.68rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.14em; color: var(--color-accent); margin-bottom: 0.6rem; }
	.credential-name { font-size: 1.25rem; margin: 0 0 0.35em; }
	.credential-meta { font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-text-muted); margin: 0 0 0.6em; }
	.credential-blurb { font-size: 0.92rem; color: var(--color-text-secondary); line-height: 1.6; margin: 0 0 0.8em; max-width: 56ch; }
	.credential-verify { font-family: var(--font-mono); font-size: 0.78rem; color: var(--color-accent); text-decoration: none; }
