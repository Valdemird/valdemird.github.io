---
import { getCollection, render } from 'astro:content';
import LearnModule from '../../../layouts/LearnModule.astro';
import { baseSlug, readingMinutes } from '../../../lib/learn';

export async function getStaticPaths() {
	const all = await getCollection('learn');
	return all
		.filter((m) => (m.data.lang ?? 'en') === 'en')
		.map((entry) => ({ params: { slug: baseSlug(entry.id) }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const slug = baseSlug(entry.id);
---

<LearnModule
	title={entry.data.title}
	description={entry.data.description}
	slug={slug}
	lang="en"
	phase={entry.data.phase}
	tier={entry.data.tier}
	durability={entry.data.durability}
	updatedDate={entry.data.updatedDate}
	readingTime={readingMinutes(entry.body)}
	sources={entry.data.sources}
	headings={headings}
	summary={entry.data.summary}
	tldr={entry.data.tldr}
>
	<Content />
</LearnModule>
